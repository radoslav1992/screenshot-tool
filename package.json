{
  "name": "easy-screen-capture",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Easy Screen Capture — screenshots as a service. Astro PWA on Cloudflare Workers.",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run commerce:check && astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "test": "npm run -s diff:check && npm run -s facts:check && npm run -s redact:check && npm run -s projects:check && npm run -s library:check && npm run -s workflows:check && npm run -s seo:check && npm run -s monitor:check && npm run -s files:check && npm run -s consent:check && npm run -s fullpage:check && npm run -s commerce:check && npm run -s push:check && npm run -s apple:check && npm run -s retention:check && npm run -s capture:check && npm run -s auth:check",
    "db:migrate:local": "wrangler d1 migrations apply screenify-data --local",
    "db:migrate": "wrangler d1 migrations apply screenify-data --remote",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "icons": "node scripts/build-icons.mjs",
    "api:smoke": "node scripts/api-smoke.mjs",
    "mobile:check": "node scripts/mobile-contract-check.mjs",
    "diff:check": "node scripts/diff-check.mjs",
    "facts:check": "node scripts/facts-check.mjs",
    "redact:check": "node scripts/redact-check.mjs",
    "projects:check": "node scripts/projects-check.mjs",
    "library:check": "node --experimental-strip-types scripts/library-check.mjs",
    "workflows:check": "node --experimental-strip-types scripts/monitor-workflows-check.mjs",
    "seo:check": "node scripts/seo-rules-check.mjs",
    "monitor:check": "node --experimental-strip-types scripts/monitor-check.mjs && node --experimental-strip-types scripts/monitor-integration-check.mjs",
    "files:check": "node --experimental-strip-types scripts/file-access-check.mjs",
    "consent:check": "node scripts/consent-check.mjs",
    "fullpage:check": "node scripts/fullpage-check.mjs",
    "stripe:check": "node --experimental-strip-types scripts/stripe-check.mjs",
    "commerce:check": "node --experimental-strip-types scripts/commerce-check.mjs",
    "push:check": "node --experimental-strip-types scripts/push-check.mjs",
    "apple:check": "node scripts/apple-billing-check.mjs",
    "retention:check": "node scripts/retention-check.mjs",
    "capture:check": "node scripts/capture-check.mjs",
    "auth:check": "node scripts/auth-billing-check.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@cloudflare/puppeteer": "^1.4.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261002.1",
    "playwright-core": "^1.56.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.147.0"
  }
}
