---
import type { Project, Report } from '../lib/projects';
import { safeParseFiles, type CaptureRow } from '../lib/captures';
import { changedAreas, reportRegions } from '../lib/change-highlights';
import ChangeFrame from './ChangeFrame.astro';
import { accentStyle, type ReportBranding } from '../lib/branding-rules';
import type { SignoffView } from '../lib/signoff';
import '../styles/adon/ai-report.css';
interface Props {
  project: Project;
  report: Report;
  captures: (CaptureRow & { position: number })[];
  token?: string;
  /** Per-project branding. Absent or null renders the report exactly as before branding existed. */
  branding?: ReportBranding | null;
  /** The current client sign-off. Absent while sign-off is unavailable, and then no cell is shown. */
  signoff?: SignoffView;
}
const { project, report, captures, token, branding, signoff } = Astro.props;
const brand = project.brand || project.name;
const signoffText = { approved: 'Approved', changes: 'Changes requested', awaiting: 'Awaiting sign-off' };
const prepared = new Date(report.created_at).toISOString().slice(0, 10);
const titles = ['Before · baseline', 'After · current', 'Comparison 2 · before', 'Comparison 2 · after'];
// A pair taken from a monitor run shows that run's changed areas over its "after" image.
const beforeOf = (position: number) => captures.find((c) => c.position === position - 1)?.id ?? null;
const regions = await reportRegions(
  project.user_id,
  captures.filter((c) => c.position % 2 === 1).map((c) => ({ before: beforeOf(c.position), after: c.id })),
);
---

<article class="ai-report" style={accentStyle(branding) || undefined}>
  <div class="ai-report-label">
    <span>[ WEBSITE REVIEW ]</span>
    <span>PREPARED {prepared}</span>
  </div>
  <header class="ai-report-head">
    {
      branding?.logoUrl && (
        <img
          class="ai-report-logo"
          src={branding.logoUrl}
          alt={`${brand} logo`}
          width={branding.logoWidth || undefined}
          height={branding.logoHeight || undefined}
          decoding="async"
        />
      )
    }
    <span class="ai-report-eyebrow">{brand} · WEBSITE REVIEW</span>
    <h1 class="ai-report-title">{report.title}</h1>
  </header>
  <dl class="ai-report-facts">
    <div>
      <dt>PROJECT</dt>
      <dd>{project.name}</dd>
    </div>
    <div>
      <dt>PREPARED</dt>
      <dd>{prepared}</dd>
    </div>
    <div>
      <dt>CAPTURES</dt>
      <dd>{captures.length}</dd>
    </div>
    {
      signoff && (
        <div>
          <dt>SIGN-OFF</dt>
          <dd>
            <span class:list={['ai-dot', `ai-dot--${signoff.state}`]} aria-hidden="true" />
            {signoffText[signoff.state]}
          </dd>
        </div>
      )
    }
  </dl>
  {
    report.notes && (
      <section class="ai-report-notes" aria-labelledby={`report-notes-${report.id}`}>
        <span>[ REVIEW NOTES ]</span>
        <div>
          <h2 id={`report-notes-${report.id}`}>Review notes</h2>
          <p class="report-notes">{report.notes}</p>
        </div>
      </section>
    )
  }
  <div class="ai-report-compare">
    {
      captures.map((c) => {
        const file = c.id ? safeParseFiles(c.files)[0] : null;
        const src = token ? `/r/${token}/${c.position}` : `/api/reports/${report.id}/image?position=${c.position}`;
        const after = c.position % 2 === 1;
        const changed = after && c.id ? (regions.get(`${beforeOf(c.position)}:${c.id}`) ?? []) : [];
        return (
          <figure class:list={['ai-report-shot', { 'ai-report-shot--after': after, changes: changed.length > 0 }]}>
            <figcaption>
              <div class="ai-report-shot-label">
                <span>[ {after ? 'AFTER' : 'BEFORE'} ]</span>
                <span>
                  {after ? 'CURRENT' : 'BASELINE'} / 0{c.position + 1}
                </span>
              </div>
              <h2>{titles[c.position]}</h2>
              {file && (
                <p class="ai-report-meta">
                  {c.url}
                  <br />
                  {c.width} × {c.height} CSS px · {c.scale}× scale · {c.mode}
                  <br />
                  {c.created_at}
                </p>
              )}
              {file && changed.length > 0 && (
                <p class="ai-report-meta">
                  {changedAreas(changed)} outlined
                  <br />
                  <label class="change-toggle">
                    <input type="checkbox" checked /> Show changes
                  </label>
                </p>
              )}
            </figcaption>
            <div class="ai-report-stage">
              {file && changed.length > 0 ? (
                <ChangeFrame src={src} alt={`After capture of ${c.url}`} regions={changed} loading="eager" />
              ) : file ? (
                <img src={src} alt={`${after ? 'After' : 'Before'} capture of ${c.url}`} loading="eager" />
              ) : (
                <p class="ai-report-missing">
                  Original image expired or was deleted. Ask the report owner for a current capture.
                </p>
              )}
            </div>
          </figure>
        );
      })
    }
  </div>
  <slot />
  <footer class="ai-report-foot">
    {branding?.footer && <p class="ai-report-foot-line">{branding.footer}</p>}
    Images are retained under the account’s capture retention policy. This report does not extend retention.
    {
      branding?.attribution && (
        <p class="ai-report-attribution">
          Shared with{' '}
          <a href="/" rel="noreferrer">
            Easy Screen Capture
          </a>
        </p>
      )
    }
  </footer>
</article>
