---
/**
 * The icon set.
 *
 * Emoji rendered differently on every platform and read as clip-art next to the
 * rest of the design, so these are drawn on one 24px grid with a single stroke
 * weight and inherit `currentColor`. Stroke-based throughout, except the two
 * brand marks, which are solid by nature.
 */

export type IconName =
  | 'camera'
  | 'library'
  | 'key'
  | 'user'
  | 'mode-visible'
  | 'mode-fullpage'
  | 'mode-series'
  | 'desktop'
  | 'tablet'
  | 'mobile'
  | 'download'
  | 'link'
  | 'eye'
  | 'eye-off'
  | 'menu'
  | 'alert'
  | 'search'
  | 'file'
  | 'offline'
  | 'check'
  | 'install'
  | 'github'
  | 'google';

interface Props {
  name: IconName;
  size?: number;
  /** Visible icons that carry meaning need a label; decorative ones stay hidden. */
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, label, class: className, strokeWidth = 1.75 } = Astro.props;

/** Stroke icons: an array of path/shape markup drawn on a 24×24 grid. */
const STROKE: Record<string, string> = {
  camera: `<path d="M3 8.6A2 2 0 0 1 5 6.6h2.3l1.2-2h7l1.2 2H19a2 2 0 0 1 2 2v8.8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="12.8" r="3.4"/>`,

  library: `<rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/>`,

  key: `<circle cx="8" cy="15.4" r="3.6"/><path d="M10.6 12.8 20.2 3.2M16.8 6.6l2.6 2.6M14.2 9.2l2.2 2.2"/>`,

  user: `<circle cx="12" cy="8.2" r="3.6"/><path d="M5.2 20.2c0-3.7 3.1-5.6 6.8-5.6s6.8 1.9 6.8 5.6"/>`,

  // The three capture modes share a page outline so they read as one family.
  'mode-visible': `<rect x="4.5" y="2.5" width="15" height="19" rx="2"/><rect x="7.5" y="8.5" width="9" height="7" rx="1.2" fill="currentColor" fill-opacity="0.16"/><path d="M7.5 8.5h9v7h-9z"/>`,
  'mode-fullpage': `<rect x="4.5" y="2.5" width="15" height="19" rx="2"/><path d="M12 6.5v11M9.4 8.9 12 6.3l2.6 2.6M9.4 15.1l2.6 2.6 2.6-2.6"/>`,
  'mode-series': `<rect x="2.5" y="4.5" width="11" height="9" rx="1.8"/><path d="M6.5 17.2h11a1.8 1.8 0 0 0 1.8-1.8v-7"/><path d="M10 20.5h9a2.5 2.5 0 0 0 2.5-2.5v-6"/>`,

  desktop: `<rect x="2.5" y="4" width="19" height="12.6" rx="2"/><path d="M9 20.4h6M12 16.6v3.8"/>`,
  tablet: `<rect x="5" y="2.5" width="14" height="19" rx="2.2"/><path d="M10.8 18.4h2.4"/>`,
  mobile: `<rect x="6.8" y="2.5" width="10.4" height="19" rx="2.6"/><path d="M10.6 18.6h2.8"/>`,

  download: `<path d="M12 3.5v11.2M7.6 10.4 12 14.8l4.4-4.4M4 20.5h16"/>`,
  link: `<path d="M10.2 13.4a4.6 4.6 0 0 0 6.7.4l2.5-2.5a4.6 4.6 0 0 0-6.5-6.5l-1.4 1.4"/><path d="M13.8 10.6a4.6 4.6 0 0 0-6.7-.4l-2.5 2.5a4.6 4.6 0 0 0 6.5 6.5l1.4-1.4"/>`,

  eye: `<path d="M2.6 12S6.2 5.6 12 5.6 21.4 12 21.4 12 17.8 18.4 12 18.4 2.6 12 2.6 12Z"/><circle cx="12" cy="12" r="3.1"/>`,
  'eye-off': `<path d="M9.6 6.1A8.9 8.9 0 0 1 12 5.8c5.8 0 9.4 6.2 9.4 6.2a17 17 0 0 1-3.2 3.9M6.2 8.1A17 17 0 0 0 2.6 12S6.2 18.2 12 18.2a9 9 0 0 0 3.4-.65"/><path d="M4 4l16 16"/>`,

  menu: `<path d="M4 7.2h16M4 12h16M4 16.8h16"/>`,
  alert: `<path d="M12 3.6 2.4 20.4h19.2z"/><path d="M12 9.6v4.4"/><circle cx="12" cy="17.2" r="0.9" fill="currentColor" stroke="none"/>`,
  search: `<circle cx="10.8" cy="10.8" r="6.8"/><path d="M15.8 15.8 21 21"/>`,
  file: `<path d="M6.5 2.5h7l4.5 4.5v14.5h-11.5z"/><path d="M13.5 2.5V7H18"/>`,
  offline: `<path d="M4.6 9.4a12 12 0 0 1 4-2.4M19.4 9.4a12 12 0 0 0-4.2-2.5M7.8 12.7a7.6 7.6 0 0 1 2.4-1.4M16.2 12.7a7.6 7.6 0 0 0-2-1.3"/><circle cx="12" cy="17.6" r="1.1" fill="currentColor" stroke="none"/><path d="M3.5 3.5l17 17"/>`,
  check: `<circle cx="12" cy="12" r="8.8"/><path d="M8.2 12.2 11 15l5-5.6"/>`,
  install: `<rect x="6.8" y="2.5" width="10.4" height="19" rx="2.6"/><path d="M12 7.4v6M9.6 11l2.4 2.4 2.4-2.4"/>`,
};

/** Brand marks are solid single paths (from simple-icons, CC0). */
const SOLID: Record<string, string> = {
  github: `M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12`,
  google: `M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z`,
};

const isBrand = name in SOLID;
const markup = isBrand ? `<path d="${SOLID[name]}"/>` : (STROKE[name] ?? '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? undefined : 'currentColor'}
  stroke-width={isBrand ? undefined : strokeWidth}
  stroke-linecap={isBrand ? undefined : 'round'}
  stroke-linejoin={isBrand ? undefined : 'round'}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={markup}
/>
