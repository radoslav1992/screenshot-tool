---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import AiDoc from '../components/AiDoc.astro';
import DocSection from '../components/DocSection.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import { DEVICE_LIST, FRAME_LIST, LIMITS } from '../lib/capture-options';
import { API_RATE_LIMIT, PLANS } from '../lib/plans';
import { docSections } from '../lib/doc-sections';

const user = Astro.locals.user;
const origin = Astro.url.origin;

const quickstart = `curl ${origin}/v1/capture \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d url="https://stripe.com/pricing" \\
  -d device="mobile" \\
  -d mode="fullpage" \\
  -d format="png"`;

const asyncExample = `# Return immediately with status "pending", then poll:
curl ${origin}/v1/capture \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d url="https://example.com" -d async=1

curl ${origin}/v1/captures/cap_8Yx2 \\
  -H "Authorization: Bearer $ESC_API_KEY"`;

const htmlExample = `curl ${origin}/v1/capture \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d device="og-image" \\
  -d html='<div style="font:700 64px system-ui;padding:80px">Ship it.</div>'`;

const compareExample = `curl ${origin}/v1/compare \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d a_url="https://staging.example.com/pricing" \\
  -d b_url="https://example.com/pricing" \\
  -d device="desktop" -d mode="fullpage"

# → { "before": {…}, "after": {…}, "change_pct": 4.71,
#     "resized": false, "identical": false }`;

const redactExample = `curl ${origin}/v1/capture \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d url="https://example.com/dashboard" \\
  -d hide=".cookie-banner,.intercom-launcher" \\
  -d blur=".customer-name" \\
  -d redact_pii=1`;

const actionsExample = `curl ${origin}/v1/capture \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d url="https://example.com/app" \\
  -d dismiss_consent=1 \\
  -d actions="click:.tab-billing; wait_for:.invoice-table; scroll_to:#totals"`;

const authExample = `curl ${origin}/v1/capture \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d url="https://staging.example.com/dashboard" \\
  -d basic_auth="staging:letmein" \\
  -d cookies='{"session":"abc123"}'`;

const batchExample = `curl ${origin}/v1/batch \\
  -H "Authorization: Bearer $ESC_API_KEY" \\
  -d sitemap="https://example.com/sitemap.xml" \\
  -d mode="fullpage" -d device="desktop"

# → { "requested": 18, "captures": [ … ], "failed": [] }`;

const watchChangedExample = `{
  "event": "watch.changed",
  "watch": { "id": "wat_8Yx2m1q0", "label": "Pricing", "url": "https://example.com/pricing" },
  "change_pct": 4.71,
  "before": "${origin}/f/cap_3kQ9…/capture.png?t=…",
  "after": "${origin}/f/cap_7Lm2…/capture.png?t=…",
  "highlight_url": "${origin}/f/cap_7Lm2…/changes.jpg?t=…",
  "regions": [{ "x": 0.08, "y": 0.12, "w": 0.4, "h": 0.06 }],
  "detail_url": "${origin}/app/watches/wat_8Yx2m1q0"
}`;

const pinExample = `# Session API, as the app and the iOS app use it
POST /api/watches/wat_8Yx2m1q0
{ "action": "pin", "capture_id": "cap_3kQ9…" }   # omit capture_id to pin the current baseline

# → the monitor, with
#   "baseline_pinned": true,
#   "baseline_pinned_at": "2026-10-02T16:00:03.412Z",
#   "baseline_capture_id": "cap_3kQ9…"

POST /api/watches/wat_8Yx2m1q0
{ "action": "unpin" }`;

const factsExample = `{
  "page": {
    "final_url": "https://stripe.com/pricing",
    "status": 200,
    "redirects": [],
    "title": "Pricing & Fees | Stripe Official Site",
    "description": "Find Stripe fees and pricing information…",
    "canonical": "https://stripe.com/pricing",
    "lang": "en-US",
    "og": { "title": "Pricing & Fees", "image": "https://…" },
    "headings": ["Pricing built for businesses of all sizes"],
    "word_count": 1841,
    "images": 24,
    "links": { "internal": 96, "external": 12 },
    "schema_types": ["Organization", "WebPage"],
    "cms": "none",
    "framework": "React",
    "is_spa": false,
    "img_alt_coverage": 0.92,
    "page_weight_kb": 412,
    "request_count": 38,
    "timings": { "ttfb_ms": 118, "load_ms": 1840 }
  }
}`;

const jsExample = `const response = await fetch("${origin}/v1/capture", {
  method: "POST",
  headers: {
    authorization: \`Bearer \${process.env.ESC_API_KEY}\`,
    "content-type": "application/json",
  },
  body: JSON.stringify({
    url: "https://example.com",
    device: "desktop",
    mode: "series",
    max_frames: 8,
  }),
});

const capture = await response.json();
console.log(capture.images); // → array of file URLs`;

const responseSample = `{
  "id": "cap_8Yx2m1q0",
  "status": "done",
  "url": "https://stripe.com/pricing",
  "display_url": "stripe.com/pricing",
  "device": "mobile",
  "viewport": { "width": 390, "height": 844, "scale": 3 },
  "mode": "fullpage",
  "format": "png",
  "images": ["${origin}/f/cap_8Yx2m1q0/capture.png?t=…"],
  "files": [
    { "url": "…", "name": "capture.png", "bytes": 481233, "width": 390, "height": 5210 }
  ],
  "bytes": 481233,
  "duration_ms": 4310,
  "created_at": "2026-03-11T09:12:04.101Z",
  "completed_at": "2026-03-11T09:12:08.411Z"
}`;

const errorSample = `{
  "error": {
    "type": "quota_exceeded",
    "message": "You have used all 2,000 screenshots on the Pro plan this month."
  }
}`;

const params = [
  { name: 'url', type: 'string', required: true, desc: 'Page to capture. http/https only; private and loopback addresses are rejected. Omit when sending `html`.' },
  { name: 'html', type: 'string', required: false, desc: 'Markup to render instead of a URL, up to 512 KB. Cannot be combined with `url`.' },
  { name: 'facts', type: 'boolean', required: false, desc: 'Also return what the page says about itself, as `page`. Default false.' },
  { name: 'sizes', type: 'string', required: false, desc: 'Comma-separated devices (desktop,tablet,mobile) shot in one page load. One file each, named for the device.' },
  { name: 'hide', type: 'string', required: false, desc: 'Comma-separated CSS selectors removed before the shot. Up to 20.' },
  { name: 'blur', type: 'string', required: false, desc: 'Comma-separated CSS selectors blurred before the shot. Up to 20.' },
  { name: 'redact_pii', type: 'boolean', required: false, desc: 'Cover email addresses, phone numbers, card numbers and IBANs found in the page text.' },
  { name: 'actions', type: 'string', required: false, desc: 'Steps before the shot: `click:.accept; wait_for:#main; scroll_to:footer`. Verbs: click, wait_for, wait, scroll_to, type. Max 10.' },
  { name: 'dismiss_consent', type: 'boolean', required: false, desc: 'Click through a cookie or consent dialog before capturing.' },
  { name: 'headers', type: 'string', required: false, desc: 'JSON object of request headers. Host and hop-by-hop headers are refused.' },
  { name: 'cookies', type: 'string', required: false, desc: 'JSON object of cookies, scoped to the captured host.' },
  { name: 'basic_auth', type: 'string', required: false, desc: '`username:password` for a page behind HTTP basic auth.' },
  { name: 'device', type: 'string', required: false, desc: 'A device (desktop · tablet · mobile), an output frame (see below), or custom. Default desktop.' },
  { name: 'mode', type: 'string', required: false, desc: 'visible · fullpage · series. Default visible.' },
  { name: 'format', type: 'string', required: false, desc: 'png · jpg · pdf. Default png. pdf is not valid with mode=series.' },
  { name: 'width', type: 'integer', required: false, desc: `Viewport width, ${LIMITS.minWidth}–${LIMITS.maxWidth}. Setting it switches device to custom.` },
  { name: 'height', type: 'integer', required: false, desc: `Viewport height, ${LIMITS.minHeight}–${LIMITS.maxHeight}.` },
  { name: 'scale', type: 'number', required: false, desc: `Device pixel ratio, ${LIMITS.minScale}–${LIMITS.maxScale}.` },
  { name: 'delay', type: 'integer', required: false, desc: `Extra wait after load, in ms (max ${LIMITS.maxDelayMs}).` },
  { name: 'quality', type: 'integer', required: false, desc: 'JPG quality 30–100. Default 85.' },
  { name: 'block_ads', type: 'boolean', required: false, desc: 'Block known ad and analytics hosts. Default true.' },
  { name: 'dark_mode', type: 'boolean', required: false, desc: 'Emulate prefers-color-scheme: dark. Default false.' },
  { name: 'max_frames', type: 'integer', required: false, desc: `Cap on scroll-series frames (max ${LIMITS.maxSeriesFrames}).` },
  { name: 'async', type: 'boolean', required: false, desc: 'Return 202 immediately and render in the background.' },
];

const errors = [
  { code: '400 invalid_request', desc: 'A parameter is missing or out of range. `param` names the field.' },
  { code: '401 invalid_api_key', desc: 'Missing, unknown or revoked key.' },
  { code: '402 quota_exceeded', desc: 'Monthly screenshot quota is used up.' },
  { code: '403 plan_required', desc: 'The feature needs a higher plan (API access, PDF, custom viewports).' },
  { code: '404 not_found', desc: 'No capture with that id belongs to this key.' },
  { code: '429 rate_limited', desc: 'Too many requests this minute. See the x-ratelimit-* headers.' },
  { code: '502 render_failed', desc: 'The page could not be rendered.' },
  { code: '504 render_timeout', desc: 'The page did not finish loading in time.' },
];

const endpoints = [
  { method: 'POST', path: '/v1/capture', desc: 'Create a capture.' },
  { method: 'POST', path: '/v1/compare', desc: 'Capture two pages and measure the difference.' },
  { method: 'POST', path: '/v1/batch', desc: 'Capture a list of URLs, or a whole sitemap.' },
  { method: 'GET', path: '/v1/captures', desc: 'List captures, newest first.' },
  { method: 'GET', path: '/v1/captures/:id', desc: 'Fetch one capture.' },
  { method: 'DELETE', path: '/v1/captures/:id', desc: 'Delete a capture and its files.' },
  { method: 'GET', path: '/v1/account', desc: 'Plan and quota for the key owner.' },
];

const toc = [
  { id: 'authentication', title: 'Authentication' },
  { id: 'quick-start', title: 'Quick start' },
  { id: 'your-own-html', title: 'Your own HTML' },
  { id: 'what-the-page-says-about-itself', title: 'What the page says about itself' },
  { id: 'every-size-in-one-visit', title: 'Every size in one visit' },
  { id: 'hiding-and-redacting', title: 'Hiding and redacting' },
  { id: 'getting-past-what-is-in-the-way', title: 'Getting past what is in the way' },
  { id: 'pages-behind-a-login', title: 'Pages behind a login' },
  { id: 'a-list-or-a-whole-sitemap', title: 'A list, or a whole sitemap' },
  { id: 'comparing-two-pages', title: 'Comparing two pages' },
  { id: 'watching-a-page', title: 'Watching a page' },
  { id: 'endpoints', title: 'Endpoints' },
  { id: 'parameters', title: 'Parameters' },
  { id: 'devices', title: 'Devices' },
  { id: 'output-frames', title: 'Output frames' },
  { id: 'capture-modes', title: 'Capture modes' },
  { id: 'long-pages-async-mode', title: 'Long pages: async mode' },
  { id: 'javascript', title: 'JavaScript' },
  { id: 'errors', title: 'Errors' },
  { id: 'the-free-plan-mark', title: 'The free-plan mark' },
  { id: 'file-urls', title: 'File URLs' },
] as const;
const { list: sections, byId: s } = docSections(toc);
---

<Base title="API reference">
  <AiPage user={user}>
    <AiPageHead label="API REFERENCE" meta="POST /v1/capture" aside="REST · JSON or form-encoded">
      <Fragment slot="title">API <span>reference</span></Fragment>
      <p>
        One endpoint does the work: <span class="mono">POST /v1/capture</span>. Send a URL, get back file URLs.
        Bodies may be JSON or form-encoded.
      </p>
    </AiPageHead>

    <AiDoc sections={sections} label="ENDPOINTS & GUIDES">
      <DocSection {...s['authentication']}>
        <p>
          Every request needs a key from the <a href="/app/api">API screen</a>, sent as a bearer token. Keys are shown
          once at creation — store them as a secret.
        </p>
        <CodeBlock tag="HEADER" code={'Authorization: Bearer sk_live_…'} />
        <p class="ai-note">
          API access is included on {PLANS.pro.name} and {PLANS.business.name}. Rate limits:
          {PLANS.pro.name} {API_RATE_LIMIT.pro} req/min, {PLANS.business.name} {API_RATE_LIMIT.business} req/min.
        </p>
      </DocSection>

      <DocSection {...s['quick-start']}>
        <CodeBlock tag="POST /v1/capture" code={quickstart} />
        <CodeBlock tag="RESPONSE · 201" code={responseSample} light copyable={false} />
      </DocSection>

      <DocSection {...s['your-own-html']}>
        <p>
          Send <span class="mono">html</span> instead of <span class="mono">url</span> and the markup is rendered
          directly — no publishing it somewhere first. This is the short path to an
          <span class="mono">og:image</span>, a social card or a receipt. Up to 512 KB, and every subrequest the
          markup makes is checked, so it cannot be used to reach a private address.
        </p>
        <CodeBlock tag="POST /v1/capture" code={htmlExample} />
      </DocSection>

      <DocSection {...s['what-the-page-says-about-itself']}>
        <p>
          Add <span class="mono">facts=1</span> and the response carries a <span class="mono">page</span> object
          alongside the files: title, meta description, canonical, OG and Twitter tags, headings, word count, link
          counts, JSON-LD types, the CMS and framework it was built with, image alt coverage, page weight and load
          timings — read from the rendered DOM, so it is what a visitor got rather than what the server shipped.
        </p>
        <CodeBlock tag="RESPONSE · page" code={factsExample} light copyable={false} />
      </DocSection>

      <DocSection {...s['every-size-in-one-visit']}>
        <p>
          <span class="mono">sizes=desktop,tablet,mobile</span> shoots the same page at each viewport during a single
          page load, returning one file per device named after it. One load matters: three separate captures pay for
          three, and a page that shows a cookie wall on first visit behaves differently the second time.
        </p>
      </DocSection>

      <DocSection {...s['hiding-and-redacting']}>
        <p>
          <span class="mono">hide</span> removes elements, <span class="mono">blur</span> blurs them, and
          {' '}<span class="mono">redact_pii=1</span> finds email addresses, phone numbers, card numbers and IBANs in
          the page text and covers them. All three happen in the page before the shutter, so the information is never
          in the file — a blur applied to finished pixels can be undone by anyone patient.
        </p>
        <CodeBlock tag="POST /v1/capture" code={redactExample} />
      </DocSection>

      <DocSection {...s['getting-past-what-is-in-the-way']}>
        <p>
          The most common reason a capture is unusable is a consent dialog or a chat bubble sitting on top of the
          thing you wanted. <span class="mono">dismiss_consent=1</span> clicks through the usual ones;
          {' '}<span class="mono">actions</span> handles the rest with four verbs and no expressions —
          {' '}<span class="mono">click</span>, <span class="mono">wait_for</span>, <span class="mono">wait</span>,
          {' '}<span class="mono">scroll_to</span> and <span class="mono">type</span>.
        </p>
        <CodeBlock tag="POST /v1/capture" code={actionsExample} />
      </DocSection>

      <DocSection {...s['pages-behind-a-login']}>
        <p>
          <span class="mono">headers</span>, <span class="mono">cookies</span> and
          {' '}<span class="mono">basic_auth</span> carry credentials for the length of one capture. Nothing is
          stored: they arrive with the request, live in the browser session and go when it closes — which is also
          why a watch cannot use them yet. Cookies are scoped to the host being captured, and
          {' '}<span class="mono">Host</span> cannot be overridden.
        </p>
        <CodeBlock tag="POST /v1/capture" code={authExample} />
      </DocSection>

      <DocSection {...s['a-list-or-a-whole-sitemap']}>
        <p>
          <span class="mono">POST /v1/batch</span> takes <span class="mono">urls</span> or a
          {' '}<span class="mono">sitemap</span> URL and captures up to 25 pages, with every other parameter applying
          to each. A page that fails is reported in <span class="mono">failed</span> rather than losing the batch.
        </p>
        <CodeBlock tag="POST /v1/batch" code={batchExample} />
      </DocSection>

      <DocSection {...s['comparing-two-pages']}>
        <p>
          <span class="mono">POST /v1/compare</span> captures two pages and measures how much of the picture differs.
          Each side takes the same parameters as a capture, prefixed <span class="mono">a_</span> and
          {' '}<span class="mono">b_</span>; anything unprefixed applies to both — except credentials:
          {' '}<span class="mono">headers</span>, <span class="mono">cookies</span> and
          {' '}<span class="mono">basic_auth</span> must be sent per side (<span class="mono">a_basic_auth</span>,
          {' '}<span class="mono">b_cookies</span>…), so staging credentials never reach the other page.
          {' '}<span class="mono">sizes</span> is not accepted here. A comparison costs two screenshots, both checked
          before anything is captured. Staging against production, a page before and after a deploy, your pricing page
          against a competitor's.
        </p>
        <CodeBlock tag="POST /v1/compare" code={compareExample} />
      </DocSection>

      <DocSection {...s['watching-a-page']}>
        <p>
          A watch re-takes a capture on a schedule and alerts you when the page looks different, with
          a webhook if you want one — a <span class="mono">watch.changed</span> POST carrying the
          before and after file URLs and the percentage that moved. Watches are set up in the
          <a href="/app/watches">app</a>; they are not on the public API yet.
        </p>
        <p>
          A visual check also says <em>where</em> the page changed: up to eight boxes in
          {' '}<span class="mono">regions</span>, as fractions (0–1) of the after image so they fit any size it is
          shown at, and — for a check that alerts — <span class="mono">highlight_url</span>, a copy of the after image
          with those areas outlined. Areas you ignore or hide never produce a box, and a page that grew or shrank
          gets one for the area that came or went. Both arrive with the webhook and on every run in the monitor's
          history; Slack, Teams, Google Chat and Discord messages link the highlighted image.
        </p>
        <CodeBlock tag="watch.changed" code={watchChangedExample} />
        <p>
          Each check is normally compared with the one before it. Pin a baseline instead and every check is compared
          with that approved version until you unpin it; no check replaces it. A check alerts when the page first
          differs from the pinned version, and again only when it changes from the version you were last alerted
          about, so one change is one alert rather than one per check. Checks that still show the same difference
          are recorded without a new alert.
        </p>
        <CodeBlock tag="POST /api/watches/:id" code={pinExample} />
      </DocSection>

      <DocSection {...s['endpoints']}>
        <div class="rows">
          {
            endpoints.map((endpoint) => (
              <div class="row">
                <span class="mono" style="font-size: 12px; font-weight: 500">
                  <span style="color: var(--green)">{endpoint.method}</span> {endpoint.path}
                </span>
                <span class="row__value" style="text-align: right">{endpoint.desc}</span>
              </div>
            ))
          }
        </div>
      </DocSection>

      <DocSection {...s['parameters']}>
        <div class="param-list">
          {
            params.map((param) => (
              <div class="param-row">
                <span class="param-row__name">
                  {param.name}
                  {param.required && <span style="color: var(--danger)"> *</span>}
                </span>
                <span class="param-row__desc">{param.desc}</span>
              </div>
            ))
          }
        </div>
      </DocSection>

      <DocSection {...s['devices']}>
        <div class="rows">
          {
            DEVICE_LIST.map((device) => (
              <div class="row">
                <span class="row__label" style="display: flex; align-items: center; gap: 8px">
                  <Icon name={device.icon} size={16} /> {device.label}
                </span>
                <span class="row__value mono">
                  {device.width}×{device.height} @{device.scale}x
                </span>
              </div>
            ))
          }
        </div>
        <p class="ai-note">
          Pass <span class="mono">width</span> and <span class="mono">height</span> for anything else — that switches
          the capture to <span class="mono">device=custom</span> (Pro and above).
        </p>
      </DocSection>

      <DocSection {...s['output-frames']}>
        <p>
          Named sizes that land on an exact pixel output, so a capture is publishable without cropping. Pass one as
          <span class="mono"> device</span>. They are named presets rather than custom viewports, so they are available
          on every plan.
        </p>
        <div class="rows">
          {
            FRAME_LIST.map((frame) => (
              <div class="row">
                <span class="mono" style="font-size: 12px">{frame.id}</span>
                <span class="row__value mono">{frame.output}</span>
              </div>
            ))
          }
        </div>
        <p class="ai-note">
          Frames are meant for <span class="mono">mode=visible</span>. A full-page or series capture ignores the frame's
          height, so the result will not keep the aspect ratio.
        </p>
      </DocSection>

      <DocSection {...s['capture-modes']}>
        <div class="rows">
          <div class="row">
            <span class="row__label">visible</span>
            <span class="row__value" style="text-align: right">One frame of the viewport.</span>
          </div>
          <div class="row">
            <span class="row__label">fullpage</span>
            <span class="row__value" style="text-align: right">
              The whole document in one tall image (capped at {LIMITS.maxFullPageHeight.toLocaleString()}px).
            </span>
          </div>
          <div class="row">
            <span class="row__label">series</span>
            <span class="row__value" style="text-align: right">
              Viewport-sized frames top to bottom. Each frame counts against your quota.
            </span>
          </div>
        </div>
      </DocSection>

      <DocSection {...s['long-pages-async-mode']}>
        <p>
          Captures normally run inline and return when the files are stored. For slow pages, pass
          <span class="mono"> async=1</span> to get a <span class="mono">202</span> with
          <span class="mono"> status: "pending"</span> and poll the capture until it is done.
        </p>
        <CodeBlock tag="ASYNC" code={asyncExample} />
      </DocSection>

      <DocSection {...s['javascript']}>
        <CodeBlock tag="NODE / WORKERS" code={jsExample} />
      </DocSection>

      <DocSection {...s['errors']}>
        <CodeBlock tag="RESPONSE · 402" code={errorSample} light copyable={false} />
        <div class="rows" style="margin-top: 4px">
          {
            errors.map((entry) => (
              <div class="row">
                <span class="mono" style="font-size: 12px">{entry.code}</span>
                <span class="row__value" style="text-align: right">{entry.desc}</span>
              </div>
            ))
          }
        </div>
      </DocSection>

      <DocSection {...s['the-free-plan-mark']}>
        <p>
          Captures made on the {PLANS.free.name} plan carry a small <span class="mono">easyscreencapture.com</span> badge in the corner. Every paid plan —
          from {PLANS.plus.name} at ${PLANS.plus.priceMonthly}/month — returns the file clean. There is no parameter for
          it: it follows the account's plan, so an unmarked file is always a file someone paid for.
        </p>
      </DocSection>

      <DocSection {...s['file-urls']}>
        <p>
          Rendered files live at <span class="mono">/f/:captureId/:name</span> and carry a per-capture share token in
          the <span class="mono">t</span> query parameter. Append <span class="mono">&amp;download=1</span> for a
          download disposition. Delete the capture to revoke the links.
        </p>
      </DocSection>

