---
import cameraMark from "../../brand/mark.svg?raw";
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<span
  class:list={["capture-mark", className]}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
  set:html={cameraMark}
/>
<style>
  .capture-mark {
    display: inline-flex;
    flex: none;
  }
  .capture-mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
