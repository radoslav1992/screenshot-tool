---
import AppShell from '../../../layouts/AppShell.astro';
import { RULE_ONLY_FREQUENCY, allowedFrequencies, frequencyLabel, watchLimit } from '../../../lib/plans';
import { getUsage } from '../../../lib/captures';
import { budgetSchedules, listWatches } from '../../../lib/watches';
import { forecast } from '../../../lib/monitor-health';
import { canSendEmail } from '../../../lib/mailer';
import { fastChecksReady } from '../../../lib/fast-checks';
import '../../../styles/projects.css';
const user = Astro.locals.user!;
const [usage, existing, smart] = await Promise.all([getUsage(user), listWatches(user.id), fastChecksReady()]);
const current = forecast(await budgetSchedules(existing), usage);
// Every 15 minutes needs smart checks, and SEO monitors rather than visual ones: the form enables it with the rule.
const frequencies = allowedFrequencies(user.plan).filter((f) => f !== RULE_ONLY_FREQUENCY || smart);
---

<AppShell title="Import monitors" tab="watches">
  <header class="appbar" slot="appbar">
    <a href="/app/watches">← Monitors</a>
    <span class="pill pill--quota">
      {existing.length.toLocaleString()} / {watchLimit(user.plan).toLocaleString()} monitors
    </span>
  </header>
  <div class="app-wrap stack gap-20">
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">BULK IMPORT</span>
        <h1>Monitor a client website in one go.</h1>
        <p>Paste up to 20 page URLs or load a page sitemap. Existing monitors for the same URL and device are skipped.</p>
      </div>
    </div>
    <p class="small muted">
      {existing.length.toLocaleString()} of {watchLimit(user.plan).toLocaleString()} monitor slots used ·{' '}
      {usage.remaining.toLocaleString()} screenshots remaining.
    </p>
    {
      !canSendEmail() && (
        <p class="notice notice--info">
          Email sending is unavailable. Imported monitors will record changes, but email alerts require the email
          service to be configured.
        </p>
      )
    }

    <section class="project-panel" aria-labelledby="sitemap-heading">
      <h2 class="section-heading" id="sitemap-heading"><span>[ 01 ] Optional</span> Load from a sitemap</h2>
      <form id="sitemap-form">
        <label>
          Page sitemap URL
          <input class="input" name="sitemap" type="url" placeholder="https://example.com/page-sitemap.xml" required />
        </label>
        <div class="btn-row">
          <button class="btn btn--outline-ink">Load first 20 URLs</button>
        </div>
      </form>
    </section>

    <section class="project-panel" aria-labelledby="import-heading">
      <h2 class="section-heading" id="import-heading"><span>[ 02 ]</span> Pages &amp; schedule</h2>
      <form id="import-form" data-current={current.monthly} data-quota={usage.quota} data-smart={String(smart)}>
        <label>
          One page URL per line
          <textarea class="input" name="urls" rows="10" maxlength="30000" required></textarea>
        </label>
        <div class="project-grid">
          <label>
            Device
            <select class="input" name="device">
              <option value="desktop">Desktop</option>
              <option value="mobile">Mobile</option>
              <option value="tablet">Tablet</option>
            </select>
          </label>
          <label>
            Schedule
            <select class="input" name="frequency">
              {frequencies.map((f) => (
                <option value={f} selected={f === 'daily'} disabled={f === RULE_ONLY_FREQUENCY} data-rule-only={f === RULE_ONLY_FREQUENCY ? '' : undefined}>
                  {f === RULE_ONLY_FREQUENCY ? `${frequencyLabel(f)} · SEO monitors` : frequencyLabel(f)}
                </option>
              ))}
            </select>
          </label>
          <label>
            Alert when
            <select class="input" name="rule_kind">
              <option value="visual" selected>Visual changes reach 1%</option>
              <option value="seo">SEO signals change</option>
            </select>
          </label>
        </div>
        <p class="small" id="import-budget" aria-live="polite"></p>
        <p class="small muted">
          Each monitor saves its first baseline on the next hourly scheduler run, and following runs compare with it.
          SEO signals cover the title, meta description, canonical, robots, h1, hreflang, Open Graph tags and HTTP
          status; choose fewer on each monitor. {smart && 'SEO monitors read each page first and take a screenshot only when a signal changed, plus a weekly full check. '}You
          can edit rules and test alerts from each monitor.
        </p>
        <div class="btn-row">
          <button class="btn btn--lime" disabled={!frequencies.length}>Create monitors</button>
        </div>
      </form>
      <p id="import-status" role="status"></p>
      <p class="notice notice--error" id="import-error" role="alert" hidden></p>
    </section>
  </div>
</AppShell>
<script>
  const form = document.querySelector<HTMLFormElement>('#import-form')!;
  const status = document.querySelector('#import-status')! as unknown as HTMLElement;
  const errorBox = document.querySelector<HTMLElement>('#import-error')!;
  const plural = (count: number, word: string) => `${count.toLocaleString()} ${word}${count === 1 ? '' : 's'}`;
  // Workers types redefine Element, so select elements are cast via unknown.
  const frequency = form.querySelector('[name="frequency"]') as unknown as HTMLSelectElement;
  const update = () => {
    const data = new FormData(form);
    const count = new Set(
      String(data.get('urls'))
        .split(/\r?\n/)
        .map((s) => s.trim())
        .filter(Boolean),
    ).size;
    const visual = data.get('rule_kind') !== 'seo';
    // Every 15 minutes only for SEO monitors, which read the page first.
    for (const option of Array.from(frequency.options).filter((entry) => entry.dataset.ruleOnly !== undefined)) {
      option.disabled = visual;
      if (visual && option.selected) frequency.value = 'hourly';
    }
    const runs = { 'quarter-hourly': 2880, hourly: 720, daily: 30, weekly: 5 }[frequency.value] || 0;
    // Reading first, an SEO monitor is certain to spend only its weekly full check; each change it finds adds one.
    const smart = !visual && form.dataset.smart === 'true';
    const per = smart ? Math.min(runs, 5) : runs;
    document.querySelector('#import-budget')!.textContent =
      `${smart ? 'At least' : 'Up to'} ${(count * per).toLocaleString()} additional screenshots per 30 days${smart ? ', plus one for each change found' : ''} · ${(Number(form.dataset.current) + count * per).toLocaleString()} total scheduled / ${Number(form.dataset.quota).toLocaleString()} included. Manual captures share this allowance.`;
  };
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  update();
  let busy = false;
  for (const current of [form, document.querySelector<HTMLFormElement>('#sitemap-form')!])
    current.onsubmit = async (e) => {
      e.preventDefault();
      if (busy) return;
      busy = true;
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('form button'));
      const wasDisabled = buttons.map((b) => b.disabled);
      buttons.forEach((b) => (b.disabled = true));
      const body = new FormData(current);
      if (current !== form) body.set('action', 'sitemap');
      errorBox.hidden = true;
      status.textContent = 'Working…';
      try {
        const response = await fetch('/api/watches/import', { method: 'POST', body });
        const result = (await response.json().catch(() => ({}))) as {
          error?: { message: string };
          urls?: string[];
          created: string[];
          skipped: number;
          failed: string[];
        };
        if (!response.ok) throw Error(result.error?.message || 'Request failed.');
        if (result.urls) {
          form.querySelector<HTMLTextAreaElement>('textarea')!.value = result.urls.join('\n');
          update();
          status.textContent = 'Review these URLs, then create monitors.';
        } else {
          status.textContent = `Created ${plural(result.created.length, 'monitor')}. Skipped ${plural(result.skipped, 'existing monitor')}. ${result.failed.length.toLocaleString()} failed.`;
          form.querySelector<HTMLTextAreaElement>('textarea')!.value = result.failed.join('\n');
          if (result.failed.length) status.textContent += ' Only failed URLs remain in the list.';
          else {
            const link = document.createElement('a');
            link.href = '/app/watches';
            link.textContent = ' Open monitors →';
            status.appendChild(link);
          }
        }
      } catch (error) {
        status.textContent = '';
        errorBox.textContent = error instanceof Error ? error.message : 'Import failed.';
        errorBox.hidden = false;
      } finally {
        busy = false;
        buttons.forEach((b, i) => (b.disabled = wasDisabled[i]));
      }
    };
</script>
