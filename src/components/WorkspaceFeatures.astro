---
import { LINKS_PER_PAGE, PLANS, PLAN_ORDER, RULE_ONLY_FREQUENCY, UPTIME_MINUTES, WATCH_FREQUENCIES, batchLimit, watchLimit } from '../lib/plans';
import { captureJobsAvailable } from '../lib/capture-jobs';
import { fastChecksReady } from '../lib/fast-checks';
import { siteHealthAvailable } from '../lib/site-health-summary';

// Background batches arrive with migration 0013, smart checks with 0016 and
// site health with 0020; until then a batch is the synchronous 25-screenshot
// queue, every monitor check is a screenshot and sites are not checked, and
// the copy says so.
const [background, smart, health] = await Promise.all([captureJobsAvailable(), fastChecksReady(), siteHealthAvailable()]);

/** A plan's monitor schedules, shortest first, as the table shows them. */
const SCHEDULE_WORDS: Record<string, string> = { [RULE_ONLY_FREQUENCY]: '15 min (rules)', hourly: 'hourly', daily: 'daily', weekly: 'weekly' };
const schedules = (id: (typeof PLAN_ORDER)[number]) => {
  const words = WATCH_FREQUENCIES[id].map((frequency) => SCHEDULE_WORDS[frequency]!);
  const text = words.join(', ');
  return text.charAt(0).toUpperCase() + text.slice(1);
};

const notes = [
  {
    title: 'What uses a screenshot?',
    text: 'One generated image counts as one screenshot. Desktop + mobile counts as two. Scroll series counts per frame. Manual captures, batches, API calls and monitor checks share the same monthly allowance, resetting on the first day of each UTC calendar month—even on annual billing.',
  },
  {
    title: 'Monitor slots are not extra quota',
    text: smart
      ? 'A visual monitor uses a screenshot on every check: about 30 per 30 days daily, about 720 hourly, so 25 hourly visual monitors would need about 18,000, exceeding Pro’s 2,000. A text, price, element or SEO monitor reads the page and uses a screenshot only when something changes, plus a weekly full check. The app forecasts usage before you save a schedule.'
      : 'One daily monitor needs about 30 screenshots per 30 days; one hourly monitor needs about 720. For example, 25 hourly monitors would need about 18,000 screenshots, exceeding Pro’s 2,000 allowance. The app forecasts usage before you save a schedule.',
  },
  {
    title: 'Reports and sharing',
    text: 'Web reports reuse existing captures without using screenshot quota. Paid PDF report exports allow six exports/hour and up to 16 MB of source images. Review links expire after 1, 7 or 30 days and can be revoked. Downloaded copies cannot be recalled.',
  },
  {
    title: 'Retention and teams',
    text: 'Reports do not extend source image retention. Missing images become unavailable. Business includes three collaborators per project, including pending invitations: viewers read reports and editors can comment. Only the owner manages captures, monitors and billing.',
  },
];
---

<section class="workspace-features" aria-labelledby="workspace-features-title">
  <div class="ai-section-head">
    <span class="section-subtitle-5">[ WHAT EACH PLAN INCLUDES ]</span>
    <div>
      <h2 id="workspace-features-title" data-adon-title>From a capture to a client deliverable</h2>
      <p class="ai-section-lede">
        Every plan includes private projects, saved batch settings, URL-list and sitemap capture, manual launch review
        status, and before-and-after web reports with expiring links.
      </p>
    </div>
  </div>
  <div class="feature-table" tabindex="0" role="region" aria-label="Scroll to compare plan features">
    <table>
      <caption class="sr-only">What each plan includes</caption>
      <thead>
        <tr>
          <th scope="col">Feature</th>
          {PLAN_ORDER.map((id) => (
            <th scope="col">{PLANS[id].name}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Screenshots / calendar month</th>
          {PLAN_ORDER.map((id) => (
            <td>{PLANS[id].quota.toLocaleString()}</td>
          ))}
        </tr>
        <tr>
          <th scope="row">Source image retention</th>
          {PLAN_ORDER.map((id) => (
            <td>{PLANS[id].historyDays} days</td>
          ))}
        </tr>
        <tr>
          <th scope="row">Projects, batches &amp; web reports</th>
          {PLAN_ORDER.map(() => (
            <td>Included</td>
          ))}
        </tr>
        {background && (
          <tr>
            <th scope="row">Screenshots per background batch</th>
            {PLAN_ORDER.map((id) => (
              <td>{batchLimit(id).toLocaleString()}</td>
            ))}
          </tr>
        )}
        <tr>
          <th scope="row">Branded PDF reports</th>
          {PLAN_ORDER.map((id) => (
            <td>{PLANS[id].formats.includes('pdf') ? 'Included' : '—'}</td>
          ))}
        </tr>
        <tr>
          <th scope="row">Monitor slots</th>
          {PLAN_ORDER.map((id) => (
            <td>{watchLimit(id) || '—'}</td>
          ))}
        </tr>
        <tr>
          <th scope="row">Monitor schedules</th>
          {PLAN_ORDER.map((id) => (
            <td>{schedules(id)}</td>
          ))}
        </tr>
        {health && (
          <tr>
            <th scope="row">Site uptime, SSL, domain &amp; link checks</th>
            {PLAN_ORDER.map((id) => (
              <td>Uptime {UPTIME_MINUTES[id] === 15 ? 'every 15 min' : 'hourly'}</td>
            ))}
          </tr>
        )}
        <tr>
          <th scope="row">API access</th>
          {PLAN_ORDER.map((id) => (
            <td>{PLANS[id].api ? 'Included' : '—'}</td>
          ))}
        </tr>
        <tr>
          <th scope="row">Project collaborators</th>
          {PLAN_ORDER.map((id) => (
            <td>{id === 'business' ? '3 per project' : 'Owner only'}</td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
  <div class="feature-grid">
    {
      notes.map((note, index) => (
        <article>
          <span class="feature-grid__num">[ 0{index + 1} ]</span>
          <h3>{note.title}</h3>
          <p>{note.text}</p>
        </article>
      ))
    }
  </div>
  <div class="feature-foot">
    <p>
      Workspace limits: 100 projects/account, 30 saved settings and 100 reports/project.
      {
        background
          ? 'Background batches run on our servers and take up to the plan’s hourly capture limit in one go; desktop/mobile launch checks count two screenshots per URL.'
          : 'Batch queues support 25 screenshots; desktop/mobile launch checks support 12 URLs.'
      }
      Weekly digests are opt-in and sent to each recipient’s verified account email.
      {
        health &&
          `Every monitored site also gets its certificate checked daily, and its domain registration and the links on each monitored page (up to ${LINKS_PER_PAGE} a page) weekly, with no screenshots used; downtime and expiring certificates and domains are emailed.`
      }
    </p>
    <a class="rr-btn-classic ai-btn-outline" href="/sample-report">
      See an illustrative client report <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
<style>
  .feature-table {
    overflow: auto;
    background: white;
    border-bottom: 1px solid var(--line);
  }
  .feature-table table {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
    text-align: left;
  }
  .feature-table th,
  .feature-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--line-2);
    border-right: 1px solid var(--line-2);
    font-size: 14px;
  }
  .feature-table tr > :last-child {
    border-right: 0;
  }
  .feature-table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .feature-table thead th {
    font: 10px/1.5 var(--mono);
    text-transform: uppercase;
    background: var(--paper);
    border-bottom-color: var(--line);
  }
  .feature-table tbody th {
    font-weight: 500;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: var(--paper);
  }
  .feature-grid article {
    padding: 32px 25px;
    border-right: 1px solid var(--line);
  }
  .feature-grid article:last-child {
    border-right: 0;
  }
  .feature-grid__num {
    display: block;
    margin-bottom: 30px;
    font: 10px var(--mono);
  }
  .feature-grid h3 {
    font: 300 clamp(24px, 2.2vw, 30px) / 1 var(--font_astronebula);
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .feature-grid p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .feature-foot {
    display: grid;
    grid-template-columns: 3fr 1fr;
    align-items: center;
    gap: 25px;
    padding: 26px 25px;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .feature-foot p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 90ch;
  }
  @media (max-width: 1100px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .feature-grid article:nth-child(2) {
      border-right: 0;
    }
    .feature-grid article:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
    .feature-foot {
      grid-template-columns: 1fr;
    }
    .feature-foot .rr-btn-classic {
      max-width: 360px;
    }
  }
  @media (max-width: 767px) {
    .feature-table th,
    .feature-table td {
      padding: 14px 15px;
    }
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .feature-grid article {
      padding: 26px 15px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .feature-grid article:last-child {
      border-bottom: 0;
    }
    .feature-grid__num {
      margin-bottom: 18px;
    }
    .feature-foot {
      padding: 22px 15px;
    }
    .feature-foot .rr-btn-classic {
      max-width: none;
    }
  }
</style>
