---
import { env } from 'cloudflare:workers';
import AppShell from '../../layouts/AppShell.astro';
import { projectsReady, ownProject } from '../../lib/projects';
import { getUsage } from '../../lib/captures';
import { captureJobsAvailable } from '../../lib/capture-jobs';
import { listBatches, type BatchDTO } from '../../lib/capture-batches';
import { MAX_BATCH } from '../../lib/batch';
import { batchLimit } from '../../lib/plans';
import { canSendEmail } from '../../lib/mailer';
import { formatDateTime } from '../../lib/dates';
import '../../styles/projects.css';
const user = Astro.locals.user!;
const usage = await getUsage(user);
let project;
let settings: Record<string, string> = {};
const projectId = Astro.url.searchParams.get('project');
if (projectId && (await projectsReady())) {
  try {
    project = await ownProject(user.id, projectId);
  } catch {
    return new Response('Project not found', { status: 404 });
  }
  const preset = await env.DB.prepare('SELECT settings FROM capture_presets WHERE id=? AND project_id=?')
    .bind(Astro.url.searchParams.get('preset') ?? '', project.id)
    .first<{ settings: string }>();
  if (preset) settings = JSON.parse(preset.settings);
}

// Background batches need migration 0013. Until it is applied this page is the
// synchronous queue it always was, capped at MAX_BATCH.
const background = await captureJobsAvailable();
const limit = background ? batchLimit(user.plan) : MAX_BATCH;
const recent: BatchDTO[] = background ? await listBatches(user.id, 10).catch(() => []) : [];
const mailer = background && canSendEmail();
const statusLabel: Record<BatchDTO['status'], string> = {
  queued: 'Queued',
  running: 'Running',
  done: 'Finished',
  cancelled: 'Cancelled',
};
---

<AppShell title="Batch capture" tab="projects">
  <header class="appbar" slot="appbar">
    <a href={project ? `/app/projects/${project.id}` : '/app/projects'}>← {project?.name ?? 'Projects'}</a>
    <span class="pill pill--quota">{usage.remaining.toLocaleString()} shots left</span>
  </header>
  <div
    class="app-wrap stack gap-20"
    id="batch-workspace"
    data-project={project?.id ?? ''}
    data-remaining={usage.remaining}
    data-background={background ? '1' : ''}
    data-limit={limit}
  >
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">A WHOLE SITE. ONE WORKFLOW.</span>
        <h1>Ready for a closer look?</h1>
        <p>
          {
            background
              ? 'Preview your pages, start the batch, and come back to the results — it keeps running when you close this tab.'
              : 'Preview your pages, capture each one, then review the results.'
          }
        </p>
      </div>
    </div>
    <form id="batch-form" class="project-grid">
      <fieldset class="project-panel" id="batch-inputs">
        <h2 class="section-heading"><span>[ 01 ]</span> Choose pages</h2>
        <label>
          Page URLs · one per line
          <textarea
            class="input"
            name="urls"
            rows="6"
            placeholder="https://example.com/&#10;https://example.com/about"
            maxlength={background ? 200000 : 20000}
          ></textarea>
        </label>
        <p class="small muted">Or load a sitemap. A sitemap takes priority over the list above.</p>
        <label>
          Sitemap URL
          <input class="input" name="sitemap" type="url" placeholder="https://example.com/sitemap.xml" />
        </label>
        <p class="small muted">
          {
            background
              ? `Up to ${limit} screenshots in one batch on your plan; sitemap indexes preview at most 5 child sitemaps.`
              : 'Up to 25 URLs; sitemap indexes preview at most 5 child sitemaps.'
          }
        </p>
      </fieldset>
      <fieldset class="project-panel" id="batch-settings">
        <h2 class="section-heading"><span>[ 02 ]</span> Capture settings</h2>
        <label>
          Device
          <select class="input" name="device">
            {['desktop', 'tablet', 'mobile'].map((d) => (
              <option value={d} selected={settings.device === d}>
                {d}
              </option>
            ))}
          </select>
        </label>
        <label>
          Capture area
          <select class="input" name="mode">
            <option value="visible" selected={settings.mode === 'visible'}>
              Visible area
            </option>
            <option value="fullpage" selected={!settings.mode || settings.mode === 'fullpage'}>
              Full page
            </option>
          </select>
        </label>
        <label>
          Format
          <select class="input" name="format">
            <option value="png" selected={settings.format !== 'jpg'}>
              PNG
            </option>
            <option value="jpg" selected={settings.format === 'jpg'}>
              JPG
            </option>
          </select>
        </label>
        <label>
          <span>
            <input type="checkbox" name="launch" value="1" checked={Astro.url.searchParams.get('launch') === '1'} />{' '}
            Launch check: desktop + mobile
          </span>
        </label>
        <p class="small muted">
          {
            background
              ? `Two screenshots per URL, so up to ${Math.floor(limit / 2)} URLs in launch mode.`
              : 'Two screenshots per URL. Up to 12 URLs in launch mode.'
          }{' '}
          Choose before/after baselines later in the project report builder.
        </p>
        <label>
          Hide distracting elements
          <input
            class="input"
            name="hide"
            value={settings.hide ?? ''}
            maxlength="2000"
            placeholder=".cookie-banner, .chat-widget"
          />
        </label>
        <label>
          <span>
            <input type="checkbox" name="redact_pii" value="1" checked={settings.redact_pii === '1'} /> Best-effort
            personal text masking
          </span>
        </label>
        <label>
          <span>
            <input type="checkbox" name="dark_mode" value="1" checked={settings.dark_mode === '1'} /> Request dark theme
          </span>
        </label>
        <label>
          <span>
            <input type="checkbox" name="block_ads" value="1" checked={settings.block_ads === '1'} /> Block ads
          </span>
        </label>
        <p class="small muted">Review images before sharing. Masking cannot guarantee anonymity.</p>
      </fieldset>
      <div class="project-panel">
        <h2 class="section-heading"><span>[ 03 ]</span> Preview &amp; run</h2>
        <button class="btn btn--lime" type="submit" id="batch-preview">
          Preview pages &amp; cost
        </button>
        <p role="status" id="batch-status" aria-live="polite"></p>
        <p class="notice notice--error" id="batch-error" role="alert" hidden></p>
        <p class="small muted">
          {
            background
              ? 'No captures are made during preview. A started batch runs on our servers, a few pages at a time: close this tab whenever you like and follow it under Recent batches.'
              : 'No captures are made during preview. Keep this tab open while running. Results are held in this tab; check your library if the page is closed or a request is interrupted.'
          }
        </p>
        {project && (
          <>
            <label>
              Save these settings as
              <input class="input" id="preset-name" maxlength="80" placeholder="Client mobile privacy check" />
            </label>
            <button class="btn btn--outline" type="button" id="save-preset">
              Save settings to project
            </button>
          </>
        )}
      </div>
    </form>
    <section class="project-panel" id="batch-results" hidden>
      <h2 class="section-heading"><span>[ 04 ]</span> <strong class="batch-cost" id="batch-cost">Capture queue</strong></h2>
      <p class="notice notice--error" id="batch-start-error" role="alert" hidden></p>
      {mailer && (
        <label class="batch-notify">
          <span>
            <input type="checkbox" id="batch-notify" value="1" /> Email me when it is done
          </span>
        </label>
      )}
      <div class="project-links">
        <button type="button" class="btn btn--lime" id="batch-start">
          {background ? 'Start background batch' : 'Start capture'}
        </button>
        <button type="button" class="btn btn--outline" id="batch-stop" disabled hidden={background}>
          Stop after current page
        </button>
        <button type="button" class="btn btn--outline" id="batch-retry" hidden>
          Retry failed pages only
        </button>
      </div>
      <ol class="project-items" id="batch-queue"></ol>
    </section>
    {
      background && (
        <section class="project-panel stack gap-12" id="batch-progress" aria-labelledby="batch-progress-title" hidden>
          <h2 class="section-heading" id="batch-progress-title">
            <span>[ 05 ]</span> <strong class="batch-cost" id="batch-progress-label">Batch progress</strong>
          </h2>
          <p class="small" id="batch-progress-status" role="status" aria-live="polite"></p>
          <div
            class="batch-bar"
            id="batch-progress-bar"
            role="progressbar"
            aria-label="Pages finished"
            aria-valuemin="0"
            aria-valuemax="0"
            aria-valuenow="0"
          >
            <span class="batch-bar__fill"></span>
          </div>
          <dl class="batch-counts" id="batch-progress-counts"></dl>
          <p class="notice notice--error" id="batch-progress-error" role="alert" hidden></p>
          <div class="project-links">
            <button type="button" class="btn btn--outline" id="batch-cancel" hidden>
              Cancel pages not yet started
            </button>
            <a class="btn btn--outline" href="/app/library">Open library</a>
          </div>
          <ol class="project-items" id="batch-progress-items"></ol>
        </section>
      )
    }
    {
      background && (
        <section class="project-panel stack gap-12" aria-labelledby="batch-recent-title">
          <h2 class="section-heading" id="batch-recent-title">
            <span>[ 06 ]</span> Recent batches
          </h2>
          {recent.length === 0 ? (
            <p class="small muted" id="batch-recent-empty">
              No batches yet. Started batches are listed here for 30 days.
            </p>
          ) : null}
          <ol class="project-items" id="batch-recent">
            {recent.map((batch) => (
              <li class="project-item project-item--row">
                <div class="batch-item__text">
                  <p class="batch-recent__label">{batch.label || 'Batch'}</p>
                  <p class="small muted">
                    {statusLabel[batch.status]} · {batch.done} of {batch.total} captured
                    {batch.failed ? ` · ${batch.failed} failed` : ''}
                    {batch.cancelled ? ` · ${batch.cancelled} cancelled` : ''} · {formatDateTime(batch.created_at)}
                  </p>
                </div>
                <a class="btn btn--outline btn--sm" href={`/app/batch?batch=${encodeURIComponent(batch.id)}`}>
                  View progress
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</AppShell>
<style>
  .batch-cost {
    font-weight: inherit;
  }
  .batch-notify {
    margin-bottom: 14px;
  }
  .batch-bar {
    height: 12px;
    border: 1px solid var(--line);
    background: white;
    overflow: hidden;
  }
  .batch-bar__fill {
    display: block;
    width: 0;
    height: 100%;
    background: var(--theme, #fa814d);
    transition: width 0.4s;
  }
  @media (prefers-reduced-motion: reduce) {
    .batch-bar__fill {
      transition: none;
    }
  }
</style>
<style is:global>
  /* Rendered by batch-progress.ts, so outside this page's scoped styles. */
  .batch-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
  }
  .batch-counts div {
    display: flex;
    gap: 6px;
  }
  .batch-counts dt {
    color: var(--muted);
  }
  .batch-counts dd {
    margin: 0;
    font-weight: 600;
  }
  .batch-recent__label {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .batch-item__text {
    flex: 1 1 240px;
    min-width: 0;
  }
  .batch-item__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .batch-state--running {
    color: var(--theme-text-sm);
  }
  .batch-state--error {
    color: var(--danger);
  }
</style>
<script>
  import '../../scripts/batch-ui';
</script>
