---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AdonPreview from "../components/AdonPreview.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { FRAME_LIST, MODES } from "../lib/capture-options";
import { PLANS, WATCH_LIMIT } from "../lib/plans";
import "../styles/adon/startup-source.css";
import "../styles/adon/landing.css";
const user = Astro.locals.user;
const captureHref = user ? "/app" : "/signup";
const monitorHref = user ? "/app/watches" : "/signup?next=%2Fapp%2Fwatches";
const justDeleted = Astro.url.searchParams.get("deleted") === "1";
const curl = `curl https://easyscreencapture.com/v1/capture \\\n  -H "Authorization: Bearer $KEY" \\\n  -d url="yoursite.com" \\\n  -d device="desktop" \\\n  -d mode="fullpage"`;
const projects = [
  {
    number: "01",
    title: "The whole page. In one take.",
    text: "Capture the viewport, the full page, or a scroll series. Keep the details that matter.",
    tag: "WEBSITE CAPTURE",
    variant: "capture",
    href: captureHref,
  },
  {
    number: "02",
    title: "A change you won’t miss.",
    text: "Schedule a check. Compare it with the last capture. Get an alert when your threshold is met.",
    tag: "VISUAL MONITORING",
    variant: "monitor",
    href: monitorHref,
  },
  {
    number: "03",
    title: "Made for the next handoff.",
    text: "Bring captures together in a project and share a before-and-after report with an expiring link.",
    tag: "CLIENT REPORTS",
    variant: "report",
    href: "/sample-report",
  },
  {
    number: "04",
    title: "Every screen, considered.",
    text: "Check desktop and mobile, or choose a ready-made size for your next social post.",
    tag: "RESPONSIVE CAPTURE",
    variant: "devices",
    href: "#sizes",
  },
] as const;
const faqs = [
  {
    q: "Can I start without a subscription?",
    a: `Yes. Create a free account with ${PLANS.free.quota} screenshots per calendar month. No credit card is needed. You can upgrade when your workflow grows.`,
  },
  {
    q: "How does website monitoring work?",
    a: `Save a page, choose a device and a schedule, then set your change threshold. We compare new captures with the previous capture and send alerts when it is met. Plus includes ${WATCH_LIMIT.plus} monitor slots; scheduled checks use your screenshot allowance.`,
  },
  {
    q: "Can I capture through an API?",
    a: "Yes. API access starts on Pro. Generate an API key in your workspace and use the same capture engine in your own tools. See the API documentation for supported options.",
  },
  {
    q: "How do I share my work?",
    a: "Download a capture, organise images into projects, or create a web report with an expiring review link. PDF report exports are available on plans that include PDF.",
  },
];
---

<Base
  title="Easy Screen Capture"
  themeColor="#FA814D"
  bodyClass="body-startup-agency"
  description="Capture websites, monitor visual changes, and share the evidence. A visual workspace for agencies, creators, and product teams."
>
  <a class="adon-skip-link" href="#main-content">
    Skip to content
  </a>
  <div class="page adon-landing">
    <SiteHeader user={user} />
    <main id="main-content">
      {justDeleted && (
        <div class="wrap">
          <div class="notice notice--info">
            Your account and everything in it have been deleted. Thanks for
            trying Easy Screen Capture.
          </div>
        </div>
      )}
      <section class="hero-2-area" aria-labelledby="hero-title">
        <div class="wrap">
          <div class="hero-2-inner">
            <div class="hero-2__video" data-adon-reveal>
              <div class="adon-hero-art">
                <AdonPreview />
                <span class="adon-orbit" aria-hidden="true">
                  ↗
                </span>
              </div>
              <div class="hero-2__wrapper">
                <div class="text">
                  <span>One workspace</span>
                </div>
                <ul>
                  <li>
                    <a href="#workflows">Capture</a>
                  </li>
                  <li>
                    <a href="#monitoring">Monitor</a>
                  </li>
                  <li>
                    <a href="/sample-report">Compare &amp; share</a>
                  </li>
                  <li class="explore">
                    <a href="#workflows">Explore the possibilities ↓</a>
                  </li>
                </ul>
              </div>
            </div>
            <div class="hero-2__content">
              <div class="adon-hero-meta">
                <span>
                  THE WEB MOVES FAST.
                  <br />
                  KEEP A CLEAR PICTURE.
                </span>
                <a href="#workflows" aria-label="Explore capture workflows">
                  ↘
                </a>
              </div>
              <h1 class="section-title" id="hero-title" data-adon-title>
                <span class="adon-line">Capture</span>
                <span class="adon-line">the web.</span>
                <span class="adon-line">
                  <em>Catch</em> every
                </span>
                <span class="adon-line">change.</span>
              </h1>
              <p class="adon-hero-description">
                From a perfect screenshot to the next website update. Capture,
                monitor, and share it all from one place.
              </p>
              <form class="hero-capture" method="get" action={captureHref}>
                <label class="sr-only" for="hero-url">
                  Website to capture
                </label>
                <Icon name="link" size={18} />
                <input
                  id="hero-url"
                  name="url"
                  inputmode="url"
                  autocomplete="url"
                  spellcheck="false"
                  placeholder="Paste a website URL"
                  required
                />
                <button class="btn btn--ink" type="submit">
                  Capture page <span aria-hidden="true">↗</span>
                </button>
              </form>
              <div class="hero-trust">
                <span>
                  <Icon name="check" size={14} /> {PLANS.free.quota} free
                  screenshots / month
                </span>
                <span>No credit card needed</span>
              </div>
            </div>
          </div>
          <div class="adon-hero-base">
            <span>BUILT FOR THE WAY YOU WORK</span>
            <span>DESKTOP / MOBILE / API</span>
            <a href="#workflows">SCROLL TO EXPLORE ↓</a>
          </div>
        </div>
      </section>
      <section class="about-area">
        <div class="wrap about-area-inner">
          <div class="section-title-wrapper">
            <div class="subtitle-wrapper">
              <span class="section-subtitle">A clearer workflow</span>
            </div>
            <div class="title-wrapper">
              <h2 class="section-title" data-adon-title>
                Less checking.
                <br />
                More <span>creating.</span>
                <br />A visual record of
                <br />
                the web that matters.
              </h2>
              <div class="adon-about-bottom">
                <p>
                  For client launches, competitor updates, design reviews, and
                  everything you want to keep. Turn a live page into something
                  you can act on.
                </p>
                <a class="rr-btn" href="/features">
                  <span class="btn-wrap">
                    <span class="text-one">Meet your workspace ↗</span>
                    <span class="text-two" aria-hidden="true">
                      Meet your workspace ↗
                    </span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      <div class="adon-marquee" aria-label="Capture, monitor, compare, share">
        <div class="adon-marquee-track" aria-hidden="true">
          {[0, 1, 2, 3].map(() => (
            <span>
              Capture{" "}
              <i aria-hidden="true">
                <svg width="38" height="38" viewBox="0 0 40 40">
                  <path
                    d="M20 2v36M2 20h36M7 7l26 26M7 33L33 7"
                    stroke="currentColor"
                    stroke-width="5"
                  />
                </svg>
              </i>{" "}
              Monitor{" "}
              <i aria-hidden="true">
                <svg width="38" height="38" viewBox="0 0 40 40">
                  <path
                    d="M20 2v36M2 20h36M7 7l26 26M7 33L33 7"
                    stroke="currentColor"
                    stroke-width="5"
                  />
                </svg>
              </i>{" "}
              Compare{" "}
              <i aria-hidden="true">
                <svg width="38" height="38" viewBox="0 0 40 40">
                  <path
                    d="M20 2v36M2 20h36M7 7l26 26M7 33L33 7"
                    stroke="currentColor"
                    stroke-width="5"
                  />
                </svg>
              </i>{" "}
              Share{" "}
              <i aria-hidden="true">
                <svg width="38" height="38" viewBox="0 0 40 40">
                  <path
                    d="M20 2v36M2 20h36M7 7l26 26M7 33L33 7"
                    stroke="currentColor"
                    stroke-width="5"
                  />
                </svg>
              </i>
            </span>
          ))}
        </div>
        <button type="button" class="adon-motion-toggle" aria-pressed="false">
          Pause motion
        </button>
      </div>
      <section class="work-area-2" id="workflows" aria-labelledby="work-title">
        <div class="wrap work-area-2-inner">
          <div class="adon-work-heading">
            <span class="section-subtitle">From URL to useful</span>
            <h2 id="work-title" data-adon-title>
              Good <em>work.</em>
              <sup>(04)</sup>
            </h2>
            <p>
              Less manual work.
              <br />
              More room for what’s next.
            </p>
          </div>
          <div class="adon-work-grid">
            {projects.map((project) => (
              <article
                class={`adon-work-card adon-work-card--${project.variant}`}
                data-adon-reveal
              >
                <a
                  href={project.href}
                  class="adon-work-image"
                  aria-label={project.title}
                >
                  <div data-adon-parallax>
                    <AdonPreview variant={project.variant} />
                  </div>
                  <span class="adon-view-circle" aria-hidden="true">
                    ↗
                  </span>
                </a>
                <div class="adon-work-meta">
                  <span>{project.tag}</span>
                  <span>/{project.number}</span>
                </div>
                <h3>
                  <a href={project.href}>{project.title}</a>
                </h3>
                <p>{project.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="choose-us theme-bg-black" id="monitoring">
        <div class="wrap">
          <div class="section-title-wrapper">
            <div class="subtitle-wrapper">
              <span class="section-subtitle">Always in the picture</span>
            </div>
            <div class="title-wrapper">
              <h2 class="section-title" data-adon-title>
                The page changed.
                <br />
                You’re already <span>on it.</span>
              </h2>
            </div>
          </div>
          <div class="adon-monitor-grid">
            <div class="adon-monitor-preview" data-adon-reveal>
              <AdonPreview variant="monitor" />
            </div>
            <div>
              <ol class="adon-monitor-steps">
                <li>
                  <span>01</span>
                  <div>
                    <h3>Pick a page that matters.</h3>
                    <p>
                      A client homepage, a competitor’s pricing, or your latest
                      landing page.
                    </p>
                  </div>
                </li>
                <li>
                  <span>02</span>
                  <div>
                    <h3>Decide when to check.</h3>
                    <p>
                      Choose the device, schedule, and change threshold. Use
                      “any change” when every detected pixel matters.
                    </p>
                  </div>
                </li>
                <li>
                  <span>03</span>
                  <div>
                    <h3>See it. Share it. Act on it.</h3>
                    <p>
                      Review the before and after. Send alerts to email, Slack,
                      Discord, or your webhook.
                    </p>
                  </div>
                </li>
              </ol>
              <a class="rr-btn rr-btn--orange" href={monitorHref}>
                <span class="btn-wrap">
                  <span class="text-one">Set up a monitor ↗</span>
                  <span class="text-two" aria-hidden="true">
                    Set up a monitor ↗
                  </span>
                </span>
              </a>
            </div>
          </div>
          <div class="choose-us__warpper">
            <div class="choose-us__item">
              <p>free captures / month</p>
              <strong data-adon-count={PLANS.free.quota}>
                {PLANS.free.quota}
              </strong>
            </div>
            <div class="choose-us__item">
              <p>capture modes</p>
              <strong data-adon-count={MODES.length}>{MODES.length}</strong>
            </div>
            <div class="choose-us__item">
              <p>Plus starts at / month</p>
              <strong>${PLANS.plus.priceMonthly}</strong>
            </div>
          </div>
          <p class="adon-allowance">
            Manual captures and scheduled checks share your plan’s screenshot
            allowance. <a href="/pricing">Compare plans ↗</a>
          </p>
        </div>
      </section>
      <section class="adon-modes" id="modes">
        <div class="wrap">
          <div class="adon-section-heading">
            <span class="section-subtitle">Made to fit</span>
            <h2 data-adon-title>
              Every page.
              <br />
              <em>Every perspective.</em>
            </h2>
          </div>
          <div class="adon-mode-list">
            {MODES.map((mode, index) => (
              <article data-adon-reveal>
                <span class="adon-mode-number">0{index + 1}</span>
                <h3>{mode.label}</h3>
                <p>{mode.longHint}</p>
                <Icon name={mode.icon} size={36} />
              </article>
            ))}
          </div>
          <div class="output-sizes" id="sizes">
            <span class="small muted">READY-MADE SIZES</span>
            {FRAME_LIST.map((frame) => (
              <span>
                <Icon name={frame.icon} size={16} />
                {frame.label}
                <small>{frame.output}</small>
              </span>
            ))}
          </div>
        </div>
      </section>
      <section class="adon-api theme-bg-black">
        <div class="wrap">
          <div class="adon-section-heading">
            <span class="section-subtitle">For the builders</span>
            <h2 data-adon-title>
              Your app.
              <br />
              <em>Our capture engine.</em>
            </h2>
          </div>
          <div class="adon-api-grid">
            <div>
              <p>
                Make screenshots part of your workflow. Process URL lists and
                sitemaps, automate captures, and connect the tools you already
                use.
              </p>
              <a class="rr-btn rr-btn--orange" href="/docs">
                <span class="btn-wrap">
                  <span class="text-one">Explore the API ↗</span>
                  <span class="text-two" aria-hidden="true">
                    Explore the API ↗
                  </span>
                </span>
              </a>
              <span class="adon-api-note">API access starts on Pro.</span>
            </div>
            <div data-adon-reveal>
              <CodeBlock tag="POST /v1/capture" code={curl} />
            </div>
          </div>
        </div>
      </section>
      <section class="adon-faq">
        <div class="wrap">
          <div class="adon-section-heading">
            <span class="section-subtitle">Good questions</span>
            <h2 data-adon-title>
              A little more <em>clarity.</em>
            </h2>
          </div>
          <div class="adon-faq-list">
            {faqs.map((faq, index) => (
              <details>
                <summary>
                  <span>0{index + 1}</span>
                  {faq.q}
                  <i aria-hidden="true">+</i>
                </summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
      <section class="thinking">
        <div class="wrap">
          <div class="adon-closing">
            <span class="section-subtitle">Your next great capture</span>
            <h2 data-adon-title>
              Think. Capture.
              <br />
              <em>Move forward.</em>
            </h2>
            <p>
              Start with one page.
              <br />
              See where it takes you.
            </p>
            <a class="adon-round-cta" href={captureHref}>
              <span>
                {user ? "Open your workspace" : "Start capturing free"}
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>(".hero-capture");
  form?.addEventListener("submit", (event) => {
    const input = form.querySelector<HTMLInputElement>('input[name="url"]')!;
    const value = input.value.trim();
    if (!value) {
      event.preventDefault();
      input.focus();
      return;
    }
    input.value = /^https?:\/\//i.test(value) ? value : `https://${value}`;
  });
</script>
