---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

export const prerender = true;
---

<Base title="Not found">
  <div class="shell">
    <div class="empty" style="margin: auto">
      <div class="empty__icon"><Icon name="search" size={34} /></div>
      <h1 class="h3" style="margin-top: 12px">Nothing here</h1>
      <p class="small muted" style="margin-top: 8px">That page does not exist — or the link has expired.</p>
      <a class="btn btn--ink" href="/" style="max-width: 220px; margin: 20px auto 0">Back to Easy Screen Capture</a>
    </div>
  </div>
</Base>
