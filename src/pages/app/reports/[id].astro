---
import { env } from 'cloudflare:workers';
import AppShell from '../../../layouts/AppShell.astro';
import ProjectForms from '../../../components/ProjectForms.astro';
import ReviewReport from '../../../components/ReviewReport.astro';
import { projectsReady, ownReport, reportCaptures } from '../../../lib/projects';
import { projectBranding } from '../../../lib/branding';
import { SIGNOFF_LABELS, currentSignoff, signoffHistory, signoffsReady } from '../../../lib/signoff';
import { getPlan } from '../../../lib/plans';
import { canSendEmail } from '../../../lib/mailer';
import { formatDateTime } from '../../../lib/dates';
import '../../../styles/projects.css';
if (!(await projectsReady())) return Astro.redirect('/app/projects');
let data;
try {
  data = await ownReport(Astro.locals.user!.id, Astro.params.id!);
} catch {
  return new Response('Report not found', { status: 404 });
}
const { project, report } = data;
const signoffs = await signoffsReady();
const [captures, link, comments, branding, signoff, history] = await Promise.all([
  reportCaptures(report, project.user_id),
  env.DB.prepare('SELECT expires_at,access_count,last_access_at FROM report_links WHERE report_id=?')
    .bind(report.id)
    .first<{ expires_at: string; access_count: number; last_access_at: string | null }>(),
  env.DB.prepare('SELECT body,created_at FROM report_comments WHERE report_id=? ORDER BY created_at')
    .bind(report.id)
    .all<{ body: string; created_at: string }>(),
  projectBranding(project),
  signoffs ? currentSignoff(report.id) : undefined,
  signoffs ? signoffHistory(report.id) : [],
]);
Astro.response.headers.set('cache-control', 'private, no-store');
const fields = { project_id: project.id, report_id: report.id };
const pdf = getPlan(Astro.locals.user!.plan).formats.includes('pdf');
const expired = !!link && Date.parse(link.expires_at) < Date.now();
const replaceWarning =
  'Replace the review link? The link you already sent will stop working, and its view count restarts.';
const views = link ?`${link.access_count.toLocaleString()} page view${link.access_count === 1 ? '' : 's'}` : '';
---

<AppShell title={report.title} tab="projects">
  <header class="appbar" slot="appbar">
    <a href={`/app/projects/${project.id}`}>← {project.name}</a>
    <div class="appbar__title">Review report</div>
  </header>
  <div class="app-wrap stack gap-20">
    <div class="btn-row no-print">
      {pdf ? (
        <form method="post" action={`/api/reports/${report.id}/pdf`}>
          <button class="btn btn--lime" type="submit">
            Download branded PDF
          </button>
        </form>
      ) : (
        <a class="btn btn--outline" href="/app/upgrade">
          PDF export · paid plans
        </a>
      )}
      <span class="small muted">
        PDF export: no screenshot quota used; up to 6 exports/hour. Images are scaled to fit the page.
      </span>
    </div>
    <ReviewReport project={project} report={report} captures={captures} branding={branding} signoff={signoff} />
    <div class="project-grid no-print">
      <section class="project-panel" aria-labelledby="link-heading">
        <h2 class="section-heading" id="link-heading"><span>[ 01 ]</span> Client review link</h2>
        <p class="small muted">
          Anyone with the link can view this report and its images{signoff && ', and record a sign-off,'} until expiration
          or revocation. Downloaded copies cannot be recalled. Internal notes below stay private.
        </p>
        <p class="link-state">
          {link ? (
            <>
              {expired ? 'Link expired' : 'Link expires'} {formatDateTime(link.expires_at)} · {views}
              {link.last_access_at && <> · Last view {formatDateTime(link.last_access_at)}</>}
            </>
          ) : (
            'No review link created.'
          )}
        </p>
        <form
          data-project-form
          data-pending={link ? 'Replacing link…' : 'Creating link…'}
          data-confirm={link ? replaceWarning : undefined}
          data-confirm-replace={replaceWarning}
        >
          <input type="hidden" name="action" value="share" />
          {Object.entries(fields).map(([name, value]) => (
            <input type="hidden" name={name} value={value} />
          ))}
          <label>
            Expires after
            <select class="input" name="days">
              <option value="1">1 day</option>
              <option value="7" selected>
                7 days
              </option>
              <option value="30">30 days</option>
            </select>
          </label>
          <div class="btn-row">
            <button class="btn btn--outline-ink" type="submit">
              {link ? 'Replace link' : 'Create review link'}
            </button>
          </div>
          <p role="status"></p>
        </form>
        {link && (
          <form
            data-project-form
            class="danger-zone"
            data-pending="Revoking…"
            data-confirm="Revoke the review link? Anyone you sent it to loses access immediately."
          >
            <input type="hidden" name="action" value="revoke" />
            {Object.entries(fields).map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}
            <div class="btn-row">
              <button class="btn btn--danger-outline" type="submit">
                Revoke review link
              </button>
            </div>
            <p role="status"></p>
          </form>
        )}
      </section>
      <section class="project-panel" aria-labelledby="notes-heading">
        <h2 class="section-heading" id="notes-heading"><span>[ 02 ]</span> Internal review notes</h2>
        <p class="small muted">Private to your account. Not included in PDF exports or shared reports.</p>
        <div class="project-items">
          {comments.results.map((c) => (
            <div class="project-item">
              <p class="report-notes">{c.body}</p>
              <small class="muted">
                <time datetime={c.created_at}>{formatDateTime(c.created_at)}</time>
              </small>
            </div>
          ))}
        </div>
        <form data-project-form>
          <input type="hidden" name="action" value="comment" />
          {Object.entries(fields).map(([name, value]) => (
            <input type="hidden" name={name} value={value} />
          ))}
          <label>
            New internal note<textarea class="input" name="body" required maxlength="2000" rows="3"></textarea>
          </label>
          <div class="btn-row">
            <button type="submit" class="btn btn--outline">
              Add note
            </button>
          </div>
          <p role="status"></p>
        </form>
      </section>
      {signoff && (
        <section class="project-panel" aria-labelledby="signoff-heading">
          <h2 class="section-heading" id="signoff-heading"><span>[ 03 ]</span> Client sign-off</h2>
          <p class="small muted">
            Whoever has the review link can approve the report or request changes, with their name and a note. The
            latest decision is the current one, and it stays with the report if you replace the link.
            {canSendEmail() && ' You get an email for each decision, up to six an hour per report.'}
          </p>
          <p class="link-state">
            <strong>[ {SIGNOFF_LABELS[signoff.state]} ]</strong>
            {signoff.state !== 'awaiting' && (
              <>
                {' '}by {signoff.name} · <time datetime={signoff.at}>{formatDateTime(signoff.at)}</time>
              </>
            )}
          </p>
          {signoff.note && <p class="report-notes">{signoff.note}</p>}
          {history.length > 0 && (
            <details>
              <summary>History · {history.length === 50 ? 'latest 50' : history.length}</summary>
              <ol class="signoff-history">
                {history.map((h) => (
                  <li>
                    <span>
                      {h.decision === 'reset' ? '[ RESET ] Back to awaiting sign-off' : `[ ${SIGNOFF_LABELS[h.decision]} ] ${h.name}`}
                    </span>
                    {h.note && <p class="report-notes small">{h.note}</p>}
                    <small class="muted">
                      <time datetime={h.created_at}>{formatDateTime(h.created_at)}</time>
                    </small>
                  </li>
                ))}
              </ol>
            </details>
          )}
          {signoff.state !== 'awaiting' && (
            <form
              data-project-form
              data-endpoint={`/api/reports/${report.id}/signoff`}
              data-pending="Resetting…"
              data-confirm="Reset the sign-off to awaiting? The client sees the report as awaiting sign-off again; the history keeps this decision."
            >
              <input type="hidden" name="action" value="reset" />
              <div class="btn-row">
                <button class="btn btn--outline-ink" type="submit">
                  Reset sign-off
                </button>
              </div>
              <p role="status"></p>
            </form>
          )}
          {!link && <p class="small muted">Create a review link to collect sign-off.</p>}
        </section>
      )}
      <section class="project-panel">
        <details>
          <summary>Edit report</summary>
          <p class="small muted">Changes also appear at active review links.</p>
          <form data-project-form>
            <input type="hidden" name="action" value="edit_report" />
            {Object.entries(fields).map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}
            <label>
              Title
              <input class="input" name="title" required maxlength="160" value={report.title} />
            </label>
            <label>
              Client-facing notes
              <textarea class="input" name="notes" maxlength="4000" rows="5">{report.notes}</textarea>
            </label>
            <div class="btn-row">
              <button type="submit" class="btn btn--outline-ink">
                Save report
              </button>
            </div>
            <p role="status"></p>
          </form>
          <form
            data-project-form
            class="danger-zone"
            data-pending="Deleting…"
            data-confirm="Delete this report and revoke its review link? Source captures will be kept."
          >
            <span class="danger-zone__label">Danger zone</span>
            <input type="hidden" name="action" value="delete_report" />
            {Object.entries(fields).map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}
            <div class="btn-row">
              <button type="submit" class="btn btn--danger-outline">
                Delete report
              </button>
            </div>
            <p role="status"></p>
          </form>
        </details>
      </section>
    </div>
  </div>
  <ProjectForms />
</AppShell>
