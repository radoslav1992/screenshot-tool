---
/**
 * Concept illustrations for capture modes and workspace capabilities.
 *
 * Drawn in the AI Agency vocabulary instead of stock template shapes: square
 * paper sheets with a hard offset shadow, ink outlines, flat orange blocks and
 * viewfinder corners. Each one pictures what the feature does. Decorative —
 * the label beside it carries the meaning.
 */
export type ConceptArtVariant = 'visible' | 'fullpage' | 'series' | 'capture' | 'monitor' | 'report' | 'devices';

interface Props {
  variant: ConceptArtVariant;
  size?: number;
  class?: string;
}

const { variant, size = 100, class: className } = Astro.props;
---

<svg
  class:list={['concept-art', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 120 120"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  {
    variant === 'visible' && (
      <>
        {/* The whole page, mostly out of frame; only the screen is captured. */}
        <rect class="ca-dash" x="30" y="14" width="60" height="96" />
        <rect class="ca-shadow" x="36" y="20" width="60" height="44" />
        <rect class="ca-paper" x="30" y="14" width="60" height="44" />
        <rect class="ca-orange" x="37" y="22" width="26" height="8" />
        <rect class="ca-grey" x="37" y="35" width="46" height="4" />
        <rect class="ca-grey" x="37" y="43" width="32" height="4" />
        <path class="ca-line ca-line--bold" d="M22 16V6h10M88 6h10v10M98 56v10H88M32 66H22V56" />
      </>
    )
  }
  {
    variant === 'fullpage' && (
      <>
        {/* One tall sheet, measured top to bottom. */}
        <rect class="ca-shadow" x="34" y="12" width="50" height="102" />
        <rect class="ca-paper" x="28" y="6" width="50" height="102" />
        <rect class="ca-orange" x="35" y="13" width="36" height="12" />
        <rect class="ca-grey" x="35" y="31" width="36" height="4" />
        <rect class="ca-grey" x="35" y="39" width="26" height="4" />
        <rect class="ca-grey" x="35" y="49" width="36" height="22" />
        <rect class="ca-grey" x="35" y="77" width="36" height="4" />
        <rect class="ca-grey" x="35" y="85" width="22" height="4" />
        <rect class="ca-ink" x="35" y="95" width="14" height="6" />
        <path class="ca-line" d="M96 7v100M90 7h12M90 107h12" />
        <path class="ca-orange" d="M96 12l-5 9h10zM96 102l-5-9h10z" />
      </>
    )
  }
  {
    variant === 'series' && (
      <>
        {/* Screen-sized frames in order, top of the page to the bottom. */}
        {[
          [10, 10, '01'],
          [30, 42, '02'],
          [50, 74, '03'],
        ].map(([x, y, label], index) => (
          <g>
            <rect class="ca-shadow" x={Number(x) + 5} y={Number(y) + 6} width="58" height="36" />
            <rect class="ca-paper" x={x} y={y} width="58" height="36" />
            <rect class={index === 2 ? 'ca-orange' : 'ca-ink'} x={Number(x) + 6} y={Number(y) + 6} width="18" height="10" />
            <text class={index === 2 ? 'ca-text' : 'ca-text ca-text--light'} x={Number(x) + 9} y={Number(y) + 14}>
              {label}
            </text>
            <rect class="ca-grey" x={Number(x) + 6} y={Number(y) + 22} width="40" height="4" />
          </g>
        ))}
      </>
    )
  }
  {
    variant === 'capture' && (
      <>
        {/* A viewfinder closing on the page's pixels. */}
        <path class="ca-line ca-line--bold" d="M14 34V14h20M86 14h20v20M106 86v20H86M34 106H14V86" />
        <rect class="ca-shadow" x="42" y="42" width="44" height="44" />
        <rect class="ca-orange" x="66" y="36" width="16" height="16" />
        <rect class="ca-orange" x="52" y="52" width="16" height="16" />
        <rect class="ca-orange" x="36" y="68" width="16" height="16" />
        <rect class="ca-orange" x="66" y="68" width="16" height="16" />
        <path class="ca-line" d="M60 18v8M60 94v8M18 60h8M94 60h8" />
      </>
    )
  }
  {
    variant === 'monitor' && (
      <>
        {/* Before and after, with the changed region called out. */}
        <rect class="ca-shadow" x="13" y="30" width="46" height="60" />
        <rect class="ca-paper" x="8" y="24" width="46" height="60" />
        <rect class="ca-grey" x="14" y="31" width="28" height="6" />
        <rect class="ca-grey" x="14" y="44" width="34" height="18" />
        <rect class="ca-grey" x="14" y="68" width="22" height="4" />
        <rect class="ca-shadow" x="71" y="30" width="46" height="60" />
        <rect class="ca-paper" x="66" y="24" width="46" height="60" />
        <rect class="ca-grey" x="72" y="31" width="28" height="6" />
        <rect class="ca-orange" x="72" y="44" width="34" height="18" />
        <rect class="ca-grey" x="72" y="68" width="22" height="4" />
        <rect class="ca-dash ca-dash--orange" x="68" y="40" width="42" height="26" />
        <path class="ca-line" d="M57 54h6M60 51l3 3-3 3" />
        <rect class="ca-ink" x="8" y="96" width="8" height="8" />
        <rect class="ca-grey" x="22" y="98" width="52" height="4" />
      </>
    )
  }
  {
    variant === 'report' && (
      <>
        {/* A report sheet: each row reviewed, one still waiting. */}
        <path class="ca-shadow" d="M36 14h46l16 16v84H36z" />
        <path class="ca-paper" d="M30 8h46l16 16v84H30z" />
        <path class="ca-line" d="M76 8v16h16" />
        <rect class="ca-orange" x="38" y="18" width="28" height="8" />
        {[44, 62, 80].map((y, index) => (
          <g>
            <rect class={index === 2 ? 'ca-orange' : 'ca-ink'} x="38" y={y} width="10" height="10" />
            {index < 2 && <path class="ca-check" d={`M40.5 ${y + 5}l2 2.2 3.4-4.2`} />}
            <rect class="ca-grey" x="54" y={y + 3} width={index === 1 ? 22 : 30} height="4" />
          </g>
        ))}
      </>
    )
  }
  {
    variant === 'devices' && (
      <>
        {/* Desktop, tablet and phone from the same page. */}
        <rect class="ca-shadow" x="11" y="22" width="74" height="50" />
        <rect class="ca-paper" x="6" y="16" width="74" height="50" />
        <rect class="ca-grey" x="13" y="23" width="30" height="6" />
        <rect class="ca-grey" x="13" y="35" width="44" height="18" />
        <path class="ca-line" d="M43 66v12M31 80h24" />
        <rect class="ca-shadow" x="61" y="44" width="34" height="48" />
        <rect class="ca-paper" x="56" y="38" width="34" height="48" />
        <rect class="ca-grey" x="61" y="44" width="18" height="5" />
        <rect class="ca-grey" x="61" y="54" width="24" height="14" />
        <rect class="ca-shadow" x="89" y="62" width="24" height="42" />
        <rect class="ca-paper" x="84" y="56" width="24" height="42" />
        <rect class="ca-orange" x="88" y="62" width="16" height="22" />
        <rect class="ca-ink" x="92" y="90" width="8" height="3" />
      </>
    )
  }
</svg>

<style>
  .concept-art {
    display: block;
    flex-shrink: 0;
    overflow: visible;
  }
  .ca-paper {
    fill: #fff;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linejoin: miter;
  }
  .ca-shadow {
    fill: #11111117;
  }
  .ca-orange {
    fill: var(--theme);
  }
  .ca-ink {
    fill: var(--ink);
  }
  .ca-grey {
    fill: #dddcd7;
  }
  .ca-line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .ca-line--bold {
    stroke-width: 4;
  }
  .ca-dash {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-dasharray: 5 5;
    opacity: 0.45;
  }
  .ca-dash--orange {
    stroke: var(--theme);
    opacity: 1;
  }
  .ca-check {
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: square;
  }
  .ca-text {
    font: 600 8px var(--mono);
    fill: var(--ink);
  }
  .ca-text--light {
    fill: #fff;
  }
</style>
