---
import MonitorBudget from '../../components/MonitorBudget.astro';
import { monitorDashboard } from '../../lib/monitor-dashboard';
import { forecast, runLabel, deliveryLabel } from '../../lib/monitor-health';
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import InstallHint from '../../components/InstallHint.astro';
import { getUsage } from '../../lib/captures';
import { formatRelative } from '../../lib/captures';
import { DEVICE_LIST } from '../../lib/capture-options';
import { formatDate } from '../../lib/dates';
import {
  FREQUENCIES,
  visualFrequencies,
  frequencyLabel,
  getPlan,
  cheapestPlanWith,
  runsPerMonth,
  watchLimit,
} from '../../lib/plans';
import { WATCH_LIMIT } from '../../lib/plans';
import { budgetSchedules, listWatches } from '../../lib/watches';
import { fastChecksReady } from '../../lib/fast-checks';
import { siteHealthTones } from '../../lib/site-health';
import '../../styles/projects.css';

const user = Astro.locals.user!;
const plan = getPlan(user.plan);
const limit = watchLimit(user.plan);
const [watches, usage, health, smart] = await Promise.all([
  listWatches(user.id),
  getUsage(user),
  monitorDashboard(user.id),
  fastChecksReady(),
]);
const schedules = await budgetSchedules(watches);
const budget = forecast(schedules, usage);
// Site health per monitor (migration 0020): an empty map before it, so no tag shows.
const siteTones = await siteHealthTones(user.id, watches).catch(() => new Map<string, string>());
const SITE_TAGS: Record<string, string> = { healthy: 'SITE OK', warning: 'SITE NEEDS A LOOK', problem: 'SITE PROBLEM' };

// Quick add makes a visual monitor, which never runs every 15 minutes.
const frequencies = FREQUENCIES.filter((entry) => visualFrequencies(user.plan).includes(entry.id));
const atLimit = watches.length >= limit;
const upgradeTo = cheapestPlanWith((candidate) => WATCH_LIMIT[candidate.id] > 0);
const prefillUrl = Astro.url.searchParams.get('url') ?? '';
const setupHref = `/app/watches/setup${prefillUrl ? `?url=${encodeURIComponent(prefillUrl)}` : ''}`;
const plural = (count: number, word: string) => `${count.toLocaleString()} ${word}${count === 1 ? '' : 's'}`;
---

<AppShell title="Monitors" tab="watches">
  <header class="appbar" slot="appbar">
    <div class="appbar__title">Monitors</div>
    {limit > 0 && (
      <span class="pill pill--quota">
        {watches.length.toLocaleString()} / {limit.toLocaleString()} monitors
      </span>
    )}
  </header>

  <div class="app-wrap stack gap-20">
    <InstallHint />
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">WEBSITE MONITORING</span>
        <h1>Know when something changes.</h1>
        <p>Your important pages, checked on your schedule.</p>
      </div>
      {limit > 0 &&
        (atLimit ? (
          <span class="btn btn--lime" aria-disabled="true">
            {plan.name} covers {plural(limit, 'monitor')}
          </span>
        ) : (
          <a class="btn btn--lime" href={setupHref}>
            New monitor
          </a>
        ))}
    </div>

    {(budget.shortfall > 0 || budget.monthlyOver || usage.remaining === 0) && (
      <div class="notice notice--info" role="status">
        <strong>
          {usage.remaining === 0 ? 'Screenshot allowance exhausted.' : 'Your schedule needs more screenshots.'}
        </strong>{' '}
        {budget.untilReset.toLocaleString()} checks are estimated before reset. Lower a monitor’s frequency, pause it,
        or <a href="/app/upgrade">review your plan</a>. Checks are skipped while no quota remains.
      </div>
    )}

    {limit === 0 ? (
      <div class="empty">
        <div class="empty__icon">
          <Icon name="eye" size={34} />
        </div>
        <h2 class="h4 empty__title">Have a page checked for you</h2>
        <p class="small muted empty__text">
          A monitor re-takes a screenshot on a schedule and emails you when the page actually looks different — with the
          before and after side by side.
        </p>
        <a class="btn btn--lime empty__action" href="/pricing">
          Available from {upgradeTo.name} — ${upgradeTo.priceMonthly}/mo
        </a>
      </div>
    ) : (
      <>
        <section class="stack gap-12" aria-labelledby="monitors-heading">
          <h2 class="section-heading" id="monitors-heading">
            <span>[ 01 ]</span> Your monitors
          </h2>
          {watches.length === 0 ? (
            <div class="empty empty--panel">
              <div class="empty__icon">
                <Icon name="eye" size={34} />
              </div>
              <p class="h4 empty__title">No monitors yet</p>
              <p class="small muted empty__text">
                Start with <a href={setupHref}>guided setup</a> to preview a baseline and quiet noisy areas, or quick-add
                a page below. The first check becomes the baseline.
              </p>
            </div>
          ) : (
            <div class="rows">
              {watches.map((watch) => (
                <a class="row" href={`/app/watches/${watch.id}`}>
                  <span class="monitor-row-main">
                    <span class="row__label truncate">{watch.label || watch.host}</span>
                    {watch.baseline_pinned_at && (
                      <span class="pin-tag" title={`Baseline pinned on ${formatDate(watch.baseline_pinned_at)}`}>
                        [ PINNED BASELINE ]
                      </span>
                    )}
                    {SITE_TAGS[siteTones.get(watch.id) ?? ''] && (
                      <span class={`site-tag site-tag--${siteTones.get(watch.id)}`}>
                        <span class="site-tag__dot" aria-hidden="true" />[ {SITE_TAGS[siteTones.get(watch.id)!]} ]
                      </span>
                    )}
                    <span class="xs muted-2">
                      {frequencyLabel(watch.frequency)}
                      {watch.status === 'paused'
                        ? ' · paused'
                        : watch.last_run_at
                          ? ` · attempted ${formatRelative(watch.last_run_at)}`
                          : ' · first check due'}
                    </span>
                  </span>
                  <span class="row__value monitor-row-status">
                    <strong>
                      {watch.status === 'paused'
                        ? 'Paused'
                        : watch.last_error
                          ? 'Needs attention'
                          : health.latest.has(watch.id)
                            ? runLabel(health.latest.get(watch.id)!)
                            : 'Awaiting first check'}
                    </strong>
                    <span class="xs muted">
                      Last successful check:{' '}
                      {health.successes.has(watch.id) ? formatRelative(health.successes.get(watch.id)!) : 'not recorded'}
                    </span>
                    {health.alerts.has(watch.id) && (
                      <span class="xs muted">
                        Email: {deliveryLabel[health.alerts.get(watch.id)!.delivery.email]} · Webhook:{' '}
                        {deliveryLabel[health.alerts.get(watch.id)!.delivery.webhook]} ·{' '}
                        {formatRelative(health.alerts.get(watch.id)!.created_at)}
                      </span>
                    )}
                  </span>
                </a>
              ))}
            </div>
          )}
        </section>

        <section class="project-panel stack gap-12" aria-labelledby="add-heading">
          <h2 class="section-heading" id="add-heading">
            <span>[ 02 ]</span> Add a monitor
          </h2>
          <p class="small muted">
            <strong>New monitor</strong> opens guided setup: preview the baseline, hide or ignore noisy areas, choose
            what should alert you, then set the schedule.
            {smart
              ? ' A visual monitor spends one screenshot from your monthly allowance on every check; a text, price, element or SEO monitor reads the page and spends one only when something changed — '
              : ' Each check spends one screenshot from your monthly allowance — '}
            {usage.remaining.toLocaleString()} left this month.
          </p>
          <p class="link-row">
            <a href="/app/watches/import">Import monitors from URLs or a sitemap →</a>
          </p>

          <details class="quick-add" open={watches.length === 0 || !!prefillUrl}>
            <summary>Quick add without a preview</summary>
            <form id="watch-form" class="stack gap-12">
              <div class="field">
                <label class="field__label" for="url">
                  Page
                </label>
                <input
                  class="input"
                  id="url"
                  name="url"
                  value={prefillUrl}
                  placeholder="stripe.com/pricing"
                  required
                />
              </div>

              <div class="field">
                <label class="field__label" for="label">
                  Name <span class="muted-2">(optional)</span>
                </label>
                <input class="input" id="label" name="label" maxlength="80" placeholder="Competitor pricing" />
              </div>

              <div class="field">
                <label class="field__label" for="frequency">
                  How often
                </label>
                <select class="input" id="frequency" name="frequency">
                  {frequencies.map((entry) => (
                    <option value={entry.id} selected={entry.id === 'daily'}>
                      {entry.label} · about {runsPerMonth(entry.id).toLocaleString()} screenshots a month
                    </option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label class="field__label" for="device">
                  Device
                </label>
                <select class="input" id="device" name="device">
                  {DEVICE_LIST.map((device) => (
                    <option value={device.id} selected={device.id === 'desktop'}>
                      {device.label} · {device.width}×{device.height}
                    </option>
                  ))}
                </select>
              </div>

              <details class="stack gap-12">
                <summary class="label">More settings</summary>

                <div class="field">
                  <label class="field__label" for="threshold">
                    Alert when more than this much changes
                  </label>
                  <select class="input" id="threshold" name="threshold">
                    <option value="0.5">0.5% of the page — very sensitive</option>
                    <option value="1" selected>
                      1% of the page
                    </option>
                    <option value="5">5% of the page</option>
                    <option value="20">20% of the page — big changes only</option>
                  </select>
                  <p class="xs muted-2">
                    Pages carry clocks, carousels and ads. A threshold keeps those from alerting you every check.
                  </p>
                </div>

                <div class="field">
                  <label class="field__label" for="mode">
                    What to capture
                  </label>
                  <select class="input" id="mode" name="mode">
                    <option value="fullpage" selected>
                      The whole page
                    </option>
                    <option value="visible">Just the first screen</option>
                  </select>
                </div>

                <div class="field">
                  <label class="field__label" for="webhook_url">
                    Webhook <span class="muted-2">(optional)</span>
                  </label>
                  <input class="input" id="webhook_url" name="webhook_url" placeholder="https://…" />
                  <p class="xs muted-2">
                    Send alerts to a Slack or Discord incoming webhook, or use a custom webhook for n8n and other tools.
                  </p>
                </div>
              </details>

              <MonitorBudget schedules={schedules} budget={usage} allowed={frequencies.map((entry) => entry.id)} smart={smart} />

              <div class="notice notice--error" id="watch-error" role="alert" hidden></div>

              <button type="submit" class="btn btn--outline-ink" id="watch-submit" disabled={atLimit}>
                {atLimit ? `${plan.name} covers ${plural(limit, 'monitor')}` : 'Start monitoring'}
              </button>
              <p class="xs muted">
                The first check runs on the next scheduler tick, usually within an hour, and becomes the baseline.
              </p>
            </form>
          </details>
        </section>
      </>
    )}

    <section class="stack gap-12" aria-labelledby="health-heading">
      <h2 class="section-heading" id="health-heading">
        <span>[ {limit === 0 ? '01' : '03'} ]</span> Capture health
      </h2>
      <div class="health-grid">
        <article>
          <span>Capture success</span>
          <strong>{health.successRate === null ? '—' : `${health.successRate}%`}</strong>
          <small>
            {(health.stats.succeeded || 0).toLocaleString()} succeeded · {(health.stats.failed || 0).toLocaleString()} failed
          </small>
        </article>
        <article>
          <span>Average capture time</span>
          <strong>{health.stats.average_ms === null ? '—' : `${(health.stats.average_ms / 1000).toFixed(1)}s`}</strong>
          <small>Successful captures only · {(health.stats.pending || 0).toLocaleString()} pending</small>
        </article>
        <article>
          <span>Monthly monitoring estimate</span>
          <strong>{budget.monthly.toLocaleString()}</strong>
          <small>
            {plural(budget.active, 'active monitor')} · per 30 days
            {budget.onChange > 0 && ` · plus one for each change ${budget.onChange === 1 ? 'the rule-based monitor finds' : `the ${budget.onChange} rule-based monitors find`}`}
          </small>
        </article>
        <article>
          <span>Remaining screenshots</span>
          <strong>{usage.remaining.toLocaleString()}</strong>
          <small>Resets {formatDate(`${usage.renewsOn}T00:00:00Z`)}</small>
        </article>
      </div>
      <p class="xs muted">
        Capture metrics cover your retained history from the last 7 days. Deleted captures are not included.
      </p>
    </section>
  </div>
</AppShell>

<style>
  .monitor-row-main {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .pin-tag {
    font: 500 10px/1.4 var(--mono);
    letter-spacing: 0.08em;
    color: var(--theme-text-sm);
  }
  /* Site health (uptime, certificate, domain, links): a square in the tone beside the words, never colour alone. */
  .site-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 10px/1.4 var(--mono);
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--muted-2);
  }
  .site-tag__dot {
    width: 7px;
    height: 7px;
    flex: none;
    background: currentColor;
  }
  .site-tag--warning {
    color: var(--theme-text-sm);
  }
  .site-tag--problem {
    color: var(--danger);
  }
  .quick-add {
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .quick-add > summary {
    font-weight: 600;
  }
  .quick-add > form {
    margin-top: 10px;
  }
</style>

<script>
  const form = document.getElementById('watch-form') as HTMLFormElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const errorBox = document.getElementById('watch-error') as HTMLElement | null;
    const submit = document.getElementById('watch-submit') as HTMLButtonElement | null;
    if (errorBox) errorBox.hidden = true;
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Starting…';
    }

    const payload: Record<string, string> = {};
    for (const [key, value] of new FormData(form).entries()) payload[key] = String(value);

    const response = await fetch('/api/watches', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        accept: 'application/json',
      },
      body: JSON.stringify(payload),
    }).catch(() => null);

    if (response?.ok) {
      const watch = (await response.json()) as { id: string };
      window.location.href = `/app/watches/${watch.id}`;
      return;
    }

    if (submit) {
      submit.disabled = false;
      submit.textContent = 'Start monitoring';
    }
    if (errorBox) {
      const body = (await response?.json().catch(() => null)) as {
        error?: { message?: string };
      } | null;
      errorBox.textContent = body?.error?.message ?? 'The monitor could not be created. Check your connection and try again.';
      errorBox.hidden = false;
    }
  });
</script>
