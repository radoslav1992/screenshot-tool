---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroVisual from '../components/HeroVisual.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { FRAME_LIST, MODES } from '../lib/capture-options';
import { PLANS, WATCH_LIMIT } from '../lib/plans';
const user = Astro.locals.user;
const captureHref = user ? '/app' : '/signup';
const monitorHref = user ? '/app/watches' : '/signup?next=%2Fapp%2Fwatches';
const justDeleted = Astro.url.searchParams.get('deleted') === '1';
const curl = `curl https://easyscreencapture.com/v1/capture \\
  -H "Authorization: Bearer $KEY" \\
  -d url="yoursite.com" \\
  -d device="desktop" \\
  -d mode="fullpage"`;
const workflows = [
  {
    number: '01',
    icon: 'desktop' as const,
    title: 'Deliver with confidence',
    text: 'Capture a client site on desktop and mobile. Keep a visual record before and after your changes.',
    tag: 'FOR AGENCIES',
  },
  {
    number: '02',
    icon: 'eye' as const,
    title: 'Stop checking by hand',
    text: 'Watch pricing, landing pages, and other public pages. Get an email when a visual change crosses your threshold.',
    tag: 'FOR BUSY TEAMS',
  },
  {
    number: '03',
    icon: 'frame-square' as const,
    title: 'Make your work shareable',
    text: 'Turn a live page into a full-page image, a scroll series, or a ready-sized social capture.',
    tag: 'FOR CREATORS',
  },
];
---

<Base
  title="Easy Screen Capture"
  themeColor="#f7f8fa"
  description="Capture websites, monitor visual changes, and share the evidence. A simple workspace for agencies, creators, and product teams."
>
  <div class="page landing">
    <SiteHeader user={user} />
    <main>
      {justDeleted && (
        <div class="wrap">
          <div class="notice notice--info">
            Your account and everything in it have been deleted. Thanks for trying Easy Screen Capture.
          </div>
        </div>
      )}
      <section class="studio-hero">
        <div class="wrap studio-hero-grid">
          <div class="studio-hero-copy">
            <span class="hero-kicker">
              <span></span> YOUR WEBSITE, IN FOCUS
            </span>
            <h1>
              Capture it.
              <br />
              Watch it.
              <br />
              <em>Stay a step ahead.</em>
            </h1>
            <p>
              Keep an eye on your clients’ websites. Capture a baseline, catch changes, and share clear visual reports
              from one workspace.
            </p>
            <form class="hero-capture" method="get" action={captureHref}>
              <label class="sr-only" for="hero-url">
                Website to capture
              </label>
              <Icon name="link" size={18} />
              <input
                id="hero-url"
                name="url"
                inputmode="url"
                autocomplete="url"
                spellcheck="false"
                placeholder="Paste a website URL"
                required
              />
              <button class="btn btn--ink" type="submit">
                Capture page <span aria-hidden="true">↗</span>
              </button>
            </form>
            <div class="hero-trust">
              <span>
                <Icon name="check" size={14} /> {PLANS.free.quota} free screenshots / month
              </span>
              <span>No credit card</span>
            </div>
            <a class="hero-secondary" href="#monitoring">
              Looking for website monitoring? <span aria-hidden="true">↓</span>
            </a>
          </div>
          <HeroVisual />
        </div>
      </section>
      <div class="capability-strip">
        <div class="wrap">
          <span>ONE WORKSPACE. LESS MANUAL WORK.</span>
          <span>
            <Icon name="camera" size={17} /> Capture
          </span>
          <span>
            <Icon name="eye" size={17} /> Monitor
          </span>
          <span>
            <Icon name="mode-series" size={17} /> Compare
          </span>
          <span>
            <Icon name="link" size={17} /> Share
          </span>
        </div>
      </div>
      <section class="section" id="workflows">
        <div class="wrap">
          <div class="section__head">
            <span class="eyebrow">BUILT AROUND YOUR WORK</span>
            <h2 class="section__title">
              Less busywork.
              <br />
              More useful screenshots.
            </h2>
            <p class="section__sub">From the first design review to the next competitor update.</p>
          </div>
          <div class="workflow-grid">
            {workflows.map((item) => (
              <article class="workflow-card">
                <div class="workflow-top">
                  <Icon name={item.icon} size={24} />
                  <span>{item.number}</span>
                </div>
                <span class="eyebrow">{item.tag}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="section monitor-section" id="monitoring">
        <div class="wrap monitor-grid">
          <div>
            <span class="eyebrow">YOUR SECOND PAIR OF EYES</span>
            <h2 class="section__title">
              The page changed.
              <br />
              You’re already on it.
            </h2>
            <p class="section__sub">
              Save a baseline, set a schedule, and let your monitor check back. When a visual change crosses your
              threshold, you get the before and after.
            </p>
            <div class="cta-row">
              <a class="btn btn--ink" href={monitorHref}>
                Set up a monitor <span aria-hidden="true">↗</span>
              </a>
            </div>
            <p class="small muted">
              From ${PLANS.plus.priceMonthly}/month · {WATCH_LIMIT.plus} watched pages on Plus.
              <br />
              Each scheduled check uses your screenshot allowance.
            </p>
          </div>
          <ol class="monitor-steps">
            <li>
              <span>01</span>
              <div>
                <h3>Pick a page that matters</h3>
                <p>A client homepage, competitor pricing, or your latest landing page.</p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <h3>Decide what deserves your attention</h3>
                <p>Choose the device, schedule, and visual change threshold.</p>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <h3>Get the evidence, then act</h3>
                <p>Review the comparison. Send change alerts to email, Slack, Discord, or your webhook.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>
      <section class="section" id="modes">
        <div class="wrap">
          <div class="section__head section__head--center">
            <span class="eyebrow">THE RIGHT FRAME FOR THE JOB</span>
            <h2 class="section__title">One screen. The whole page. Every detail.</h2>
          </div>
          <div class="cards-3">
            {MODES.map((mode) => (
              <article class="mode-card">
                <div class="mode-card__icon">
                  <Icon name={mode.icon} size={24} />
                </div>
                <h3 class="mode-card__title">{mode.label}</h3>
                <p class="mode-card__body">{mode.longHint}</p>
              </article>
            ))}
          </div>
          <div class="output-sizes" id="sizes">
            <span class="small muted">Ready-made output sizes</span>
            {FRAME_LIST.map((frame) => (
              <span>
                <Icon name={frame.icon} size={16} /> {frame.label} <small>{frame.output}</small>
              </span>
            ))}
          </div>
        </div>
      </section>
      <section class="section section--ink">
        <div class="wrap split">
          <div>
            <span class="eyebrow" style="color: var(--lime)">
              FITS INTO YOUR WORKFLOW
            </span>
            <h2 class="section__title">
              Your app.
              <br />
              Our capture engine.
            </h2>
            <p class="section__sub">
              Automate captures, process URL lists and sitemaps, and connect screenshots to the tools you already use.
              API access starts on Pro.
            </p>
            <div class="cta-row">
              <a class="btn btn--lime" href="/docs">
                Explore the API <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <CodeBlock tag="POST /v1/capture" code={curl} />
        </div>
      </section>
      <section class="section">
        <div class="wrap final-cta">
          <span class="hero-kicker">LESS CHECKING. MORE DOING.</span>
          <h2 class="section__title">Start with one page.</h2>
          <p class="section__sub">Get your first capture free. Build your workflow from there.</p>
          <div class="cta-row">
            <a class="btn btn--ink" href={captureHref}>
              {user ? 'Open your workspace' : 'Create your free account'} <span aria-hidden="true">↗</span>
            </a>
            <a class="btn btn--outline" href="/pricing">
              Compare plans
            </a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('.hero-capture');
  form?.addEventListener('submit', (event) => {
    const input = form.querySelector<HTMLInputElement>('input[name="url"]')!;
    const value = input.value.trim();
    if (!value) {
      event.preventDefault();
      input.focus();
      return;
    }
    input.value = /^https?:\/\//i.test(value) ? value : `https://${value}`;
  });
</script>
