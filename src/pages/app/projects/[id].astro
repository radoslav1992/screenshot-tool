---
import { env } from 'cloudflare:workers';
import AppShell from '../../../layouts/AppShell.astro';
import ProjectForms from '../../../components/ProjectForms.astro';
import { projectsReady, ownProject } from '../../../lib/projects';
import { listCaptures, safeParseFiles, type CaptureRow } from '../../../lib/captures';
import { displayUrl } from '../../../lib/capture-options';
import { listWatches } from '../../../lib/watches';
import { formatDateTime } from '../../../lib/dates';
import '../../../styles/projects.css';
const user = Astro.locals.user!;
if (!(await projectsReady())) return Astro.redirect('/app/projects');
let project;
try {
  project = await ownProject(user.id, Astro.params.id!);
} catch {
  return new Response('Project not found', { status: 404 });
}
const [attached, available, watches, monitors, presets, reports] = await Promise.all([
  env.DB.prepare(
    'SELECT c.*,pc.review_status FROM captures c JOIN project_captures pc ON pc.capture_id=c.id WHERE pc.project_id=? AND c.user_id=? ORDER BY c.created_at DESC LIMIT 200',
  )
    .bind(project.id, user.id)
    .all<CaptureRow & { review_status: string }>(),
  listCaptures(user.id, { limit: 100, search: (Astro.url.searchParams.get('q') ?? '').slice(0, 200) }),
  listWatches(user.id),
  env.DB.prepare(
    'SELECT w.id,w.label,w.url FROM watches w JOIN project_watches pw ON pw.watch_id=w.id WHERE pw.project_id=? AND w.user_id=?',
  )
    .bind(project.id, user.id)
    .all<{ id: string; label: string; url: string }>(),
  env.DB.prepare('SELECT * FROM capture_presets WHERE project_id=? ORDER BY created_at DESC')
    .bind(project.id)
    .all<{ id: string; name: string; settings: string }>(),
  env.DB.prepare('SELECT * FROM review_reports WHERE project_id=? ORDER BY created_at DESC')
    .bind(project.id)
    .all<{ id: string; title: string }>(),
]);
const eligible = attached.results.filter(
  (c) => c.status === 'done' && ['png', 'jpg'].includes(c.format) && c.mode !== 'series',
);
/** A thumbnail from the row already loaded: the first image file, if there is one. */
const thumb = (c: CaptureRow) => {
  if (c.status !== 'done' || !['png', 'jpg'].includes(c.format)) return null;
  const file = safeParseFiles(c.files)[0];
  return file ? `/f/${c.id}/${file.name}?t=${c.share_token}` : null;
};
const approved = attached.results.filter((c) => c.review_status === 'approved').length;
const captureOption = (c: CaptureRow) => `${formatDateTime(c.created_at)} · ${c.device} · ${displayUrl(c.url)}`;
---

<AppShell title={project.name} tab="projects">
  <header class="appbar" slot="appbar">
    <a href="/app/projects">← Projects</a>
    <div class="appbar__title truncate">{project.name}</div>
  </header>
  <div class="app-wrap stack gap-20">
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">CLIENT WORKSPACE</span>
        <h1>{project.name}</h1>
        <p>{project.brand || 'From first capture to final approval.'}</p>
      </div>
      <a class="btn btn--lime" href={`/app/batch?project=${project.id}`}>
        Capture pages
      </a>
    </div>
    <nav class="link-row" aria-label="More for this project">
      <a href={`/app/batch?project=${project.id}&launch=1`}>Desktop + mobile launch check →</a>
      <a href={`/app/watches/setup`}>New monitor →</a>
      <a href={`/app/team/${project.id}`}>Team &amp; weekly digest →</a>
      <a href={`/app/start?project=${project.id}`}>Setup progress →</a>
    </nav>
    <div class="project-grid">
      <section class="project-panel" aria-labelledby="add-heading">
        <h2 class="section-heading" id="add-heading"><span>[ 01 ]</span> Add existing work</h2>
        <form method="get">
          <label>
            Find older captures
            <input class="input" name="q" placeholder="Website or URL" value={Astro.url.searchParams.get('q') ?? ''} />
          </label>
          <div class="btn-row">
            <button class="btn btn--outline">Search library</button>
          </div>
        </form>
        <p class="small muted">Up to 100 matching captures shown.</p>
        <form data-project-form>
          <input type="hidden" name="action" value="attach" />
          <input type="hidden" name="project_id" value={project.id} />
          <input type="hidden" name="kind" value="capture" />
          <label>
            Capture
            <select class="input" name="asset_id" required>
              <option value="">Choose a capture</option>
              {available.map((c) => (
                <option value={c.id}>{captureOption(c)}</option>
              ))}
            </select>
          </label>
          <div class="btn-row">
            <button type="submit" class="btn btn--outline">
              Add capture
            </button>
          </div>
          <p role="status"></p>
        </form>
        <form data-project-form>
          <input type="hidden" name="action" value="attach" />
          <input type="hidden" name="project_id" value={project.id} />
          <input type="hidden" name="kind" value="watch" />
          <label>
            Monitor
            <select class="input" name="asset_id" required>
              <option value="">Choose a monitor</option>
              {watches.map((w) => (
                <option value={w.id}>{w.label || w.url}</option>
              ))}
            </select>
          </label>
          <div class="btn-row">
            <button type="submit" class="btn btn--outline">
              Add monitor
            </button>
          </div>
          <p role="status"></p>
        </form>
      </section>
      <section class="project-panel" aria-labelledby="report-heading">
        <h2 class="section-heading" id="report-heading"><span>[ 02 ]</span> Build a review report</h2>
        <p class="small muted">
          Compare existing images without taking new captures. Optional second pair for mobile launch evidence.
        </p>
        <form data-project-form data-pending="Creating report…">
          <input type="hidden" name="action" value="report" />
          <input type="hidden" name="project_id" value={project.id} />
          <label>
            Report title
            <input class="input" name="title" required maxlength="160" placeholder="Website launch review" />
          </label>
          {['before', 'after', 'mobile_before', 'mobile_after'].map((name, i) => (
            <label>
              {['Before / baseline', 'After / current', 'Mobile before (optional)', 'Mobile after (optional)'][i]}
              <select class="input" name={name} required={i < 2}>
                <option value="">Choose capture</option>
                {eligible.map((c) => (
                  <option value={c.id}>{captureOption(c)}</option>
                ))}
              </select>
            </label>
          ))}
          <label>
            Changes and annotations
            <textarea
              class="input"
              name="notes"
              maxlength="4000"
              rows="4"
              placeholder="What changed, what to check, and next steps."
            ></textarea>
          </label>
          <div class="btn-row">
            <button type="submit" class="btn btn--outline-ink" disabled={eligible.length < 2}>
              Create report
            </button>
            {eligible.length < 2 && <span class="small muted">Needs two completed PNG or JPG captures.</span>}
          </div>
          <p role="status"></p>
        </form>
      </section>
    </div>
    <section class="project-panel" aria-labelledby="checklist-heading">
      <h2 class="section-heading" id="checklist-heading">
        <span>[ 03 ]</span> Review checklist · {approved}/{attached.results.length} approved
      </h2>
      <p class="small muted">
        Review status records your manual assessment. Up to 200 most recent attached captures shown.
      </p>
      {attached.results.length > 0 && (
        <div class="project-grid checklist">
          {attached.results.map((c) => (
            <article class="project-item project-item--capture">
              {thumb(c) ? (
                <a class="project-item__thumb" href={`/app/c/${c.id}`} tabindex="-1" aria-hidden="true">
                  <img src={thumb(c)!} alt="" loading="lazy" decoding="async" />
                </a>
              ) : null}
              <a href={`/app/c/${c.id}`}>{displayUrl(c.url)}</a>
              <p class="small muted">
                {c.device} · {formatDateTime(c.created_at)} · {c.status}
              </p>
              <form data-project-form class="project-item__actions">
                <input type="hidden" name="action" value="review" />
                <input type="hidden" name="project_id" value={project.id} />
                <input type="hidden" name="asset_id" value={c.id} />
                <label>
                  Review status
                  <select class="input" name="review_status">
                    {['pending', 'approved', 'changes'].map((s) => (
                      <option selected={s === c.review_status} value={s}>
                        {s === 'changes' ? 'Needs changes' : s === 'approved' ? 'Approved' : 'To review'}
                      </option>
                    ))}
                  </select>
                </label>
                <button type="submit" class="btn btn--outline">
                  Save
                </button>
                <p role="status"></p>
              </form>
              <form
                data-project-form
                class="project-item__remove"
                data-pending="Removing…"
                data-confirm="Remove this capture from the project? It stays in your library and in existing reports, but its review status here is lost."
              >
                <input type="hidden" name="action" value="detach" />
                <input type="hidden" name="project_id" value={project.id} />
                <input type="hidden" name="asset_id" value={c.id} />
                <button type="submit" class="btn btn--sm btn--danger-outline">
                  Remove from project
                </button>
                <p role="status"></p>
              </form>
            </article>
          ))}
        </div>
      )}
      {!attached.results.length && (
        <p class="small">No captures yet. Add existing work above or capture pages for this project.</p>
      )}
    </section>
    <div class="project-grid">
      <section class="project-panel" aria-labelledby="reports-heading">
        <h2 class="section-heading" id="reports-heading"><span>[ 04 ]</span> Review reports</h2>
        <div class="project-items">
          {reports.results.map((r) => (
            <a class="project-item" href={`/app/reports/${r.id}`}>
              {r.title} →
            </a>
          ))}
        </div>
        {!reports.results.length && <p class="small muted">Your first report starts with two captures.</p>}
      </section>
      <section class="project-panel" aria-labelledby="monitors-heading">
        <h2 class="section-heading" id="monitors-heading"><span>[ 05 ]</span> Project monitors</h2>
        <div class="project-items">
          {monitors.results.map((w) => (
            <div class="project-item project-item--row">
              <a href={`/app/watches/${w.id}`}>{w.label || w.url}</a>
              <form
                data-project-form
                data-pending="Removing…"
                data-confirm="Remove this monitor from the project? It keeps running and keeps its history."
              >
                <input type="hidden" name="action" value="detach" />
                <input type="hidden" name="kind" value="watch" />
                <input type="hidden" name="project_id" value={project.id} />
                <input type="hidden" name="asset_id" value={w.id} />
                <button type="submit" class="btn btn--sm btn--danger-outline">
                  Remove from project
                </button>
                <p role="status"></p>
              </form>
            </div>
          ))}
        </div>
        {!monitors.results.length && (
          <p class="small muted">
            No monitors attached yet. Add one under Add existing work, or <a href="/app/watches/setup">set up a new
            monitor</a> and attach it here.
          </p>
        )}
      </section>
      <section class="project-panel" aria-labelledby="presets-heading">
        <h2 class="section-heading" id="presets-heading"><span>[ 06 ]</span> Saved capture settings</h2>
        <p class="small muted">
          Create reusable settings in batch capture. Credentials and input actions are never saved.
        </p>
        <div class="project-items">
          {presets.results.map((p) => (
            <div class="project-item project-item--row">
              <a href={`/app/batch?project=${project.id}&preset=${p.id}`}>{p.name} →</a>
              <form
                data-project-form
                data-pending="Deleting…"
                data-confirm={`Delete the saved settings “${p.name}”? Captures already made with them are kept.`}
              >
                <input type="hidden" name="action" value="delete_preset" />
                <input type="hidden" name="project_id" value={project.id} />
                <input type="hidden" name="preset_id" value={p.id} />
                <button type="submit" class="btn btn--sm btn--danger-outline">
                  Delete
                </button>
                <p role="status"></p>
              </form>
            </div>
          ))}
        </div>
      </section>
      <section class="project-panel">
        <details>
          <summary>Project settings</summary>
          <form data-project-form>
            <input type="hidden" name="action" value="rename" />
            <input type="hidden" name="project_id" value={project.id} />
            <label>
              Name
              <input class="input" name="name" required maxlength="100" value={project.name} />
            </label>
            <label>
              Report brand
              <input class="input" name="brand" maxlength="100" value={project.brand} />
            </label>
            <div class="btn-row">
              <button type="submit" class="btn btn--outline-ink">
                Save project
              </button>
            </div>
            <p role="status"></p>
          </form>
          <form
            data-project-form
            class="danger-zone"
            data-pending="Deleting…"
            data-confirm="Delete this project, its reports, notes and review links? Original captures and monitors will be kept."
          >
            <span class="danger-zone__label">Danger zone</span>
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="project_id" value={project.id} />
            <div class="btn-row">
              <button type="submit" class="btn btn--danger-outline">
                Delete project
              </button>
            </div>
            <p role="status"></p>
          </form>
        </details>
      </section>
    </div>
  </div>
  <ProjectForms />
</AppShell>
