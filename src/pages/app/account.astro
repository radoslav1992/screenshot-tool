---
import { env } from 'cloudflare:workers';
import AppShell from '../../layouts/AppShell.astro';
import PasswordField from '../../components/PasswordField.astro';
import TrialStatus from '../../components/TrialStatus.astro';
import { getUsage } from '../../lib/captures';
import { getPlan, PLANS, PLAN_ORDER } from '../../lib/plans';
import { billingEnabled, getBillingRow, hasActiveSubscription } from '../../lib/billing';
import { billingErrorMessage } from '../../lib/billing-errors';
import { takeFlash } from '../../lib/flash';
import { PASSWORD_MIN_LENGTH, countSessions } from '../../lib/auth';
import { canSendEmail } from '../../lib/mailer';
import { REFERRAL_BONUS, REFERRAL_CAP, referralSummary, referralUrl, rewardReferral } from '../../lib/growth';
import { isOwner } from '../../lib/growth-report';
import { webPushReady } from '../../lib/push';
import { trialOfferFor } from '../../lib/trials';
import { TRIAL_DAYS } from '../../lib/trial-plan';
import { isVerified } from '../../lib/verification';
import { formatDate } from '../../lib/dates';

const user = Astro.locals.user!;
// Catches a referral that became payable some other way (a password reset that
// confirmed the address, say), so the bonus below is already counted.
await rewardReferral(user.id, Astro.url.origin);
const usage = await getUsage(user);
// The invite section exists once migration 0017 does.
const referral = await referralSummary(user.id).catch(() => null);
const inviteLink = referral ? referralUrl(Astro.url.origin, referral.code) : '';
const owner = isOwner(user.email);
// Change alerts in this browser exist once migration 0018 and the VAPID secrets do.
const webPush = await webPushReady().catch(() => false);
// What the account holds and pays for; a Pro trial lends it more for a while (`user.plan`).
const plan = getPlan(user.ownPlan);
const onTrial = Boolean(user.trial?.active && user.plan !== user.ownPlan);
// Offered once, from Free or Lite, with no Stripe subscription (lib/trials.ts).
const offerTrial = await trialOfferFor(user);
const trialWaitsForEmail = offerTrial && !(await isVerified(user.id).catch(() => true));
const initials = (user.name || user.email).trim().charAt(0).toUpperCase();
const pct = usage.quota ? Math.min(100, Math.round((usage.used / usage.quota) * 100)) : 0;
const renews = new Date(usage.renewsOn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const longDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const checkout = billingEnabled();
// The billing columns only exist once migration 0003 has been applied, and the
// account screen is not the place to find that out.
const billing = checkout ? await getBillingRow(user.id).catch(() => null) : null;
const hasCustomer = Boolean(billing?.stripe_customer_id);
const subscribed = hasActiveSubscription(billing);
const pastDue = billing?.plan_status === 'past_due';
const paidThrough = billing?.plan_period_end ? longDate(billing.plan_period_end) : null;

// The plan to buy next: the next one up, or during a trial with nothing to
// switch from, the one being tried.
const nextPlanId = PLAN_ORDER[PLAN_ORDER.indexOf(plan.id) + 1] ?? null;
const nextPlan = onTrial && !subscribed ? PLANS[user.plan] : nextPlanId ? PLANS[nextPlanId] : null;

// Apple bills iOS subscribers itself; nothing here can change or cancel that,
// so the screen says where to go instead. The columns arrive with 0011.
const apple = await env.DB.prepare(
  `SELECT u.apple_expires_at AS expires_at,
          (SELECT product_id FROM apple_subscriptions s WHERE s.user_id = u.id ORDER BY s.expires_at DESC LIMIT 1) AS product_id
   FROM users u WHERE u.id = ?`,
)
  .bind(user.id)
  .first<{ expires_at: string | null; product_id: string | null }>()
  .catch(() => null);
const appleActive = Boolean(apple?.expires_at && apple.expires_at > new Date().toISOString());
const appleInterval = apple?.product_id?.endsWith('.yearly') ? 'yearly' : 'monthly';
const APPLE_SUBSCRIPTIONS = 'https://apps.apple.com/account/subscriptions';

// Which confirmation the delete form asks for, and whether there is a password
// to change. An account created by a future sign-in provider would have none.
const account = await env.DB.prepare(
  `SELECT password_hash IS NOT NULL AS has_password, email_verified_at FROM users WHERE id = ?`,
)
  .bind(user.id)
  .first<{ has_password: number; email_verified_at: string | null }>();
const hasPassword = Boolean(account?.has_password);
const emailConfirmed = Boolean(account?.email_verified_at);
const mailReady = canSendEmail();
const sessions = await countSessions(user.id).catch(() => 1);
const otherSessions = Math.max(0, sessions - 1);

const params = Astro.url.searchParams;
const justUpgraded = params.get('checkout') === 'success';
const trialStarted = params.get('trial') === 'started' && onTrial;
// A code, looked up in a fixed list: nothing from the URL is ever shown as text.
const billingError = billingErrorMessage(params.get('billing_error'));
const passwordNotice =
  params.get('password') === 'changed'
    ? 'Password changed. Every other device was signed out.'
    : params.get('password') === 'reset'
      ? 'Your password has been reset. Every other device signed in to this account was signed out.'
      : null;
const signedOut = params.has('signed_out') ? Number.parseInt(params.get('signed_out') ?? '0', 10) || 0 : null;
// Left by the password routes when a form post failed; never read from the URL.
const passwordError = takeFlash(Astro.cookies, Astro.url.pathname);
---

<AppShell title="Account" tab="account">
  <header class="appbar" slot="appbar">
    <div class="appbar__title">Account</div>
    <span class="avatar">{initials}</span>
  </header>

  <div class="app-wrap app-split stack gap-16">
    <div class="workspace-intro" style="grid-column: 1 / -1">
      <div>
        <span class="eyebrow">ACCOUNT &amp; BILLING</span>
        <h1>Your account.</h1>
        <p>Profile, plan, sign-in and billing in one place.</p>
      </div>
    </div>

    <TrialStatus user={user} span />

    {
      trialStarted && user.trial && (
        <div class="notice notice--ok" role="status">
          Your {TRIAL_DAYS}-day Pro trial has started: everything Pro includes until {formatDate(user.trial.endsAt)}.
          Then you go back to {plan.name} automatically, and nothing is charged.
        </div>
      )
    }

    {
      justUpgraded && (
        <div class="notice notice--info">
          You returned from Stripe. Your currently recorded plan is <strong>{plan.name}</strong>.
          Changes appear after Stripe confirms them; returning here alone does not confirm payment.
          <a href="/app/account">Refresh billing status</a>.
        </div>
      )
    }

    {
      pastDue && (
        <div class="notice notice--error">
          Your last payment did not go through. Update your card to keep the {plan.name} plan.
        </div>
      )
    }

    {
      billingError && (
        <div class="notice notice--error">
          <strong>Billing could not be opened.</strong> {billingError}
        </div>
      )
    }

    {passwordNotice && <div class="notice notice--ok" role="status">{passwordNotice}</div>}
    {
      signedOut !== null && (
        <div class="notice notice--ok" role="status">
          {signedOut === 0
            ? 'No other devices were signed in.'
            : `Signed out ${signedOut} other ${signedOut === 1 ? 'device' : 'devices'}.`}
        </div>
      )
    }
    {
      passwordError && (
        <div class="notice notice--error" role="alert">
          {passwordError}
        </div>
      )
    }

    <div class="app-col">
    <div class="card" style="padding: 18px; display: flex; align-items: center; gap: 14px">
      <span class="avatar avatar--lg">{initials}</span>
      <div style="flex: 1; min-width: 0">
        <div class="truncate" style="font: 700 15px var(--display)">{user.name || 'Your account'}</div>
        <div class="xs muted truncate">{user.email}</div>
        {
          !emailConfirmed && (
            <div class="xs" style="margin-top: 4px; color: var(--muted)">
              Email not confirmed.
              {mailReady ? (
                <>
                  {' '}
                  <button type="button" id="send-confirmation" style="font-weight: 600; color: var(--green)">
                    Send confirmation email
                  </button>
                  <span id="confirmation-state" aria-live="polite" />
                </>
              ) : (
                ' Needed to join team projects.'
              )}
            </div>
          )
        }
      </div>
      <button
        type="button"
        class="btn btn--sm btn--outline"
        id="edit-profile"
        aria-expanded="false"
        aria-controls="profile-form"
      >
        Edit
      </button>
    </div>

    <form id="profile-form" class="card card--pad stack gap-12" hidden>
      <div class="field">
        <label class="field__label" for="name">Display name</label>
        <input class="input" id="name" name="name" value={user.name} maxlength="60" />
      </div>
      <div class="notice notice--error" id="profile-error" hidden></div>
      <div style="display: flex; gap: 8px">
        <button type="submit" class="btn btn--ink">Save</button>
        <button type="button" class="btn btn--outline" id="cancel-profile">Cancel</button>
      </div>
    </form>

    <section class="panel-dark">
      <div class="row-between">
        <div style="font: 700 14px var(--display)">{onTrial ? 'Pro trial' : `${plan.name} plan`}</div>
        <div class="mono" style="font-size: 11px; color: var(--lime)">quota resets {renews}</div>
      </div>

      {
        onTrial && user.trial && (
          <div class="xs" style="color: var(--dim); margin-top: 4px">
            Until {formatDate(user.trial.endsAt)}, then back to {plan.name}
          </div>
        )
      }
      {
        paidThrough && (
          <div class="xs" style="color: var(--dim); margin-top: 4px">Paid through {paidThrough}</div>
        )
      }
      {
        appleActive && apple?.expires_at && (
          <div class="xs" style="color: var(--dim); margin-top: 4px">
            Billed {appleInterval} by Apple · current period ends {longDate(apple.expires_at)}
          </div>
        )
      }

      <div style="margin-top: 14px">
        <div class="row-between xs" style="color: var(--dim); margin-bottom: 6px">
          <span>Screenshots used</span>
          <span style="color: var(--paper); font-weight: 600">
            {usage.used.toLocaleString()} / {usage.quota.toLocaleString()}
          </span>
        </div>
        <div class="meter"><div class="meter__fill" style={`width: ${pct}%`}></div></div>
        {
          usage.bonus > 0 && (
            <div class="row-between xs" style="color: var(--dim); margin-top: 8px">
              <span>Bonus screenshots, used after these</span>
              <span style="color: var(--paper); font-weight: 600">+{usage.bonus.toLocaleString()}</span>
            </div>
          )
        }
      </div>

      <div class="stat-row" style="margin-top: 16px">
        <div class="stat">
          <div class="stat__value">{usage.viaApp.toLocaleString()}</div>
          <div class="stat__label">via app</div>
        </div>
        <div class="stat">
          <div class="stat__value">{usage.viaApi.toLocaleString()}</div>
          <div class="stat__label">via API</div>
        </div>
        <div class="stat">
          <div class="stat__value">{usage.daysLeft}</div>
          <div class="stat__label">days left</div>
        </div>
      </div>

      {
        // The trial is the one orange action while it is on offer; buying stays
        // a link beside it. Without a card, it is the smaller step to Pro.
        offerTrial && (
          <form method="post" action="/api/trial" class="trial-offer">
            <button type="submit" class="btn btn--lime" disabled={trialWaitsForEmail}>
              Start your {TRIAL_DAYS}-day Pro trial
            </button>
            <p class="xs trial-offer__note">
              {trialWaitsForEmail
                ? 'Confirm your email address first, then start it here.'
                : `Everything Pro includes, no card. Back to ${plan.name} automatically after ${TRIAL_DAYS} days.`}
            </p>
            {nextPlan && !appleActive && (
              <a class="trial-offer__buy" href="/pricing">
                Or upgrade to {nextPlan.name} — ${nextPlan.priceMonthly}/mo
              </a>
            )}
          </form>
        )
      }
      {
        // An Apple subscription cannot be combined with a Stripe one, so the
        // upgrade offer would only end at a refusal.
        !offerTrial && nextPlan && !(appleActive && !subscribed) &&
          (subscribed ? (
            <a class="btn btn--lime" href="/app/upgrade" style="margin-top: 16px; padding: 12px; font-size: 13px">
              Upgrade to {nextPlan.name}
            </a>
          ) : (
            <a
              class="btn btn--lime"
              href={onTrial ? `/pricing#plan-${nextPlan.id}` : '/pricing'}
              style="margin-top: 16px; padding: 12px; font-size: 13px"
            >
              {onTrial ? 'Keep' : 'Upgrade to'} {nextPlan.name} — ${nextPlan.priceMonthly}/mo
            </a>
          ))
      }
    </section>

    {
      referral && (
        <section class="card card--pad stack gap-12 invite" id="invite" aria-labelledby="invite-title">
          <div class="row-between">
            <h2 id="invite-title" class="invite__title">Invite a friend</h2>
            <span class="invite__label">[ REFERRALS ]</span>
          </div>
          <p class="xs muted">
            When someone signs up through your link, confirms their email and takes a first capture, you each get{' '}
            {REFERRAL_BONUS} bonus screenshots — for up to {REFERRAL_CAP} friends. Bonus screenshots are used after your
            monthly allowance and never expire.
          </p>
          <div class="invite__link">
            <input class="input" id="invite-link" value={inviteLink} readonly aria-label="Your referral link" />
            <button type="button" class="btn btn--outline" data-copy data-copy-value={inviteLink}>
              Copy link
            </button>
          </div>
          <dl class="invite__stats">
            <div>
              <dt>Invited</dt>
              <dd>{referral.invited.toLocaleString()}</dd>
            </div>
            <div>
              <dt>Rewarded</dt>
              <dd>{referral.rewarded.toLocaleString()}</dd>
            </div>
            <div>
              <dt>Bonus balance</dt>
              <dd>{referral.bonus.toLocaleString()}</dd>
            </div>
          </dl>
        </section>
      )
    }

    {
      webPush && (
        <section
          class="card card--pad stack gap-12 device-alerts"
          id="device-alerts"
          aria-labelledby="device-alerts-title"
          data-device-alerts
        >
          <div class="row-between">
            <h2 id="device-alerts-title" class="device-alerts__title">Change alerts on this device</h2>
            <span class="device-alerts__label" data-alerts-label>[ CHECKING ]</span>
          </div>
          <p class="xs muted" data-alerts-text>
            A notification on this device when a monitored page changes, alongside your email and webhook alerts.
          </p>
          <div class="device-alerts__actions">
            <button type="button" class="btn btn--ink" data-alerts-on hidden>
              Turn on
            </button>
            <button type="button" class="btn btn--outline" data-alerts-test hidden>Send a test alert</button>
            <button type="button" class="btn btn--outline" data-alerts-off hidden>Turn off</button>
          </div>
          <p class="xs muted-2" role="status" aria-live="polite" data-alerts-status></p>
        </section>
      )
    }

    </div>

    <div class="app-col">
    <div class="rows">
      <a class="row" href="/pricing">
        <span class="row__label">Plans &amp; pricing</span>
        <span class="row__value" style="color: var(--muted-2)">›</span>
      </a>
      {
        appleActive && (
          <a class="row" href={APPLE_SUBSCRIPTIONS} target="_blank" rel="noopener">
            <span class="row__label">Apple subscription</span>
            <span class="row__value">Manage in Apple ↗</span>
          </a>
        )
      }
      {
        hasCustomer ? (
          <form method="post" action="/api/billing/portal">
            <button type="submit" class="row" style="width: 100%">
              <span class="row__label">Billing, card &amp; invoices</span>
              <span class="row__value" style="color: var(--muted-2)">Manage ›</span>
            </button>
          </form>
        ) : (
          !appleActive && (
            <div class="row">
              <span class="row__label">Payment method</span>
              <span class="row__value">{checkout ? 'None yet' : 'Not connected'}</span>
            </div>
          )
        )
      }
      <button type="button" class="row" id="install-app" hidden>
        <span class="row__label">Install Easy Screen Capture</span>
        <span class="row__value">Add to home screen ›</span>
      </button>
      <a class="row" href="/docs">
        <span class="row__label">API documentation</span>
        <span class="row__value" style="color: var(--muted-2)">›</span>
      </a>
      {
        owner && (
          <a class="row" href="/app/growth">
            <span class="row__label">Growth dashboard</span>
            <span class="row__value" style="color: var(--muted-2)">Owner ›</span>
          </a>
        )
      }
      {
        hasPassword ? (
          <button
            type="button"
            class="row"
            id="open-password"
            aria-expanded="false"
            aria-controls="password-form"
            style="width: 100%"
          >
            <span class="row__label">Change password</span>
            <span class="row__value" style="color: var(--muted-2)">›</span>
          </button>
        ) : (
          <a class="row" href="/forgot-password">
            <span class="row__label">Set a password</span>
            <span class="row__value" style="color: var(--muted-2)">By email ›</span>
          </a>
        )
      }
      <form method="post" action="/api/auth/sign-out-others">
        <button type="submit" class="row" style="width: 100%" disabled={otherSessions === 0}>
          <span class="row__label">Sign out other devices</span>
          <span class="row__value" style="color: var(--muted-2)">
            {otherSessions === 0
              ? 'Only this one'
              : `${otherSessions} other ${otherSessions === 1 ? 'session' : 'sessions'} ›`}
          </span>
        </button>
      </form>
      <form method="post" action="/api/auth/logout">
        <button type="submit" class="row" style="width: 100%">
          <span class="row__label" style="color: var(--danger)">Sign out</span>
          <span class="row__value" style="color: var(--muted-2)">›</span>
        </button>
      </form>
      <button
        type="button"
        class="row"
        id="open-delete"
        aria-expanded="false"
        aria-controls="delete-form"
        style="width: 100%"
      >
        <span class="row__label" style="color: var(--danger)">Delete account</span>
        <span class="row__value" style="color: var(--muted-2)">›</span>
      </button>
    </div>

    {
      hasPassword && (
        <form
          id="password-form"
          class="card card--pad stack gap-12"
          method="post"
          action="/api/auth/change-password"
          hidden
        >
          <div style="font: 700 14px var(--display)">Change password</div>
          <p class="xs muted">
            Every other device signed in to this account, including the iOS app, is signed out. This one stays signed
            in.
          </p>
          <input type="text" name="username" value={user.email} autocomplete="username" hidden />
          <PasswordField
            id="current-password"
            name="current_password"
            label="Current password"
            autocomplete="current-password"
          />
          <PasswordField
            id="new-password"
            name="password"
            label="New password"
            autocomplete="new-password"
            placeholder={`At least ${PASSWORD_MIN_LENGTH} characters`}
            minlength={PASSWORD_MIN_LENGTH}
          />
          <div style="display: flex; gap: 8px">
            <button type="submit" class="btn btn--ink">Change password</button>
            <button type="button" class="btn btn--outline" id="cancel-password">Cancel</button>
          </div>
          <p class="xs muted-2">
            Forgotten the current one? <a href="/forgot-password">Reset it by email</a>.
          </p>
        </form>
      )
    }

    <form id="delete-form" class="card card--pad stack gap-12" hidden>
      <div style="font: 700 14px var(--display); color: var(--danger)">Delete this account</div>
      <p class="xs muted">
        This removes your captures and their files, your API keys and this account itself, and cannot be undone. Share
        links stop working immediately.
        {
          subscribed && (
            <>
              {' '}Your {plan.name} subscription is cancelled at the same time — the rest of the period you have paid
              for is not refunded.
            </>
          )
        }
        {' '}Invoices stay with Stripe, which the law requires us to keep.
      </p>
      {
        appleActive && (
          <div class="notice notice--error">
            <strong>Cancel your Apple subscription first.</strong> Deleting your account does not stop Apple billing
            you — only Apple can do that. Open{' '}
            <a href={APPLE_SUBSCRIPTIONS} target="_blank" rel="noopener">
              Apple subscriptions
            </a>{' '}
            (or Settings → your name → Subscriptions on your iPhone) and cancel Easy Screen Capture, then come back.
          </div>
        )
      }
      <div class="field">
        <label class="field__label" for="delete-confirm">{hasPassword ? 'Your password' : 'Type your email to confirm'}</label>
        <input
          class="input"
          id="delete-confirm"
          name={hasPassword ? 'password' : 'confirm'}
          type={hasPassword ? 'password' : 'email'}
          autocomplete={hasPassword ? 'current-password' : 'off'}
          placeholder={hasPassword ? '' : user.email}
          required
        />
      </div>
      <div class="notice notice--error" id="delete-error" hidden></div>
      <div style="display: flex; gap: 8px">
        <button type="submit" class="btn btn--danger" id="delete-submit">Delete permanently</button>
        <button type="button" class="btn btn--outline" id="cancel-delete">Keep my account</button>
      </div>
    </form>

    <p class="xs muted-2 center">
      Easy Screen Capture · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a>
    </p>
    </div>
  </div>
</AppShell>

<style>
  .trial-offer {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }
  .trial-offer .btn {
    padding: 12px;
    font-size: 13px;
  }
  .trial-offer__note {
    color: var(--dim);
  }
  /* Buying is still one tap away, as a link that does not compete with the trial. */
  .trial-offer__buy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    font-weight: 600;
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .invite {
    scroll-margin-top: 16px;
  }
  .invite__title,
  .device-alerts__title {
    font: 700 14px var(--display);
  }
  .invite__label,
  .device-alerts__label {
    font: 10px/1.5 var(--mono);
    color: var(--muted);
  }
  .device-alerts {
    scroll-margin-top: 16px;
  }
  .device-alerts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .device-alerts__actions:not(:has(> :not([hidden]))),
  .device-alerts [role='status']:empty {
    display: none;
  }
  .device-alerts__actions .btn {
    width: auto;
    min-height: 44px;
  }
  .invite__link {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .invite__link .input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: 44px;
    font: 12px var(--mono);
  }
  .invite__link .btn {
    width: auto;
    flex: 0 0 auto;
  }
  .invite__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line-2);
    margin: 0;
  }
  .invite__stats > div {
    padding: 10px 12px;
    border-right: 1px solid var(--line-2);
    min-width: 0;
  }
  .invite__stats > div:last-child {
    border-right: 0;
  }
  .invite__stats dt {
    font: 9px/1.4 var(--mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .invite__stats dd {
    margin: 4px 0 0;
    font: 700 16px var(--display);
  }
</style>

<script>
  import { wirePasswordToggles } from '../../scripts/auth';
  import { installEnvironment, installHint, isIOS, isStandalone, promptInstall, watchInstall } from '../../scripts/install';
  import {
    browserSubscription,
    pushAlertState,
    pushSupported,
    sendTest,
    serverStatus,
    turnOff,
    turnOn,
    type PushAlertState,
  } from '../../scripts/push-alerts';


  wirePasswordToggles();

  /** Shows or hides a panel and keeps its toggle's `aria-expanded` in step. */
  function setOpen(toggle: HTMLElement | null, panel: HTMLElement | null, open: boolean) {
    if (panel) panel.hidden = !open;
    toggle?.setAttribute('aria-expanded', String(open));
  }

  const form = document.getElementById('profile-form') as HTMLFormElement | null;
  const editToggle = document.getElementById('edit-profile');

  editToggle?.addEventListener('click', () => {
    if (form) setOpen(editToggle, form, form.hidden);
  });
  document.getElementById('cancel-profile')?.addEventListener('click', () => {
    setOpen(editToggle, form, false);
    editToggle?.focus();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const errorBox = document.getElementById('profile-error') as HTMLElement | null;
    if (errorBox) errorBox.hidden = true;

    const response = await fetch('/api/account', {
      method: 'POST',
      headers: { 'content-type': 'application/json', accept: 'application/json' },
      body: JSON.stringify({ name: new FormData(form).get('name') }),
    });

    if (response.ok) {
      window.location.reload();
    } else if (errorBox) {
      const payload = (await response.json().catch(() => null)) as { error?: { message?: string } } | null;
      errorBox.textContent = payload?.error?.message ?? 'Could not save your profile.';
      errorBox.hidden = false;
    }
  });

  const passwordForm = document.getElementById('password-form') as HTMLFormElement | null;
  const passwordToggle = document.getElementById('open-password');

  passwordToggle?.addEventListener('click', () => {
    if (!passwordForm) return;
    const open = passwordForm.hidden;
    setOpen(passwordToggle, passwordForm, open);
    if (open) (document.getElementById('current-password') as HTMLInputElement | null)?.focus();
  });
  document.getElementById('cancel-password')?.addEventListener('click', () => {
    passwordForm?.reset();
    setOpen(passwordToggle, passwordForm, false);
    passwordToggle?.focus();
  });

  document.getElementById('send-confirmation')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const state = document.getElementById('confirmation-state');
    button.disabled = true;
    try {
      const response = await fetch('/api/auth/resend-verification', {
        method: 'POST',
        headers: { accept: 'application/json' },
      });
      const payload = (await response.json().catch(() => null)) as {
        sent?: boolean;
        reason?: string;
        error?: { message?: string };
      } | null;
      if (state) {
        state.textContent = response.ok
          ? payload?.sent
            ? ' Sent — check your inbox.'
            : payload?.reason === 'already_verified'
              ? ' Already confirmed.'
              : ' Could not send it right now.'
          : ` ${payload?.error?.message ?? 'Could not send it.'}`;
      }
    } catch {
      if (state) state.textContent = ' Could not send. Check your connection and try again.';
    } finally {
      button.disabled = false;
    }
  });

  const deleteForm = document.getElementById('delete-form') as HTMLFormElement | null;
  const deleteToggle = document.getElementById('open-delete');

  deleteToggle?.addEventListener('click', () => {
    if (!deleteForm) return;
    setOpen(deleteToggle, deleteForm, true);
    deleteForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
    (document.getElementById('delete-confirm') as HTMLInputElement | null)?.focus();
  });

  document.getElementById('cancel-delete')?.addEventListener('click', () => {
    if (deleteForm) {
      deleteForm.reset();
      setOpen(deleteToggle, deleteForm, false);
    }
  });

  deleteForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const errorBox = document.getElementById('delete-error') as HTMLElement | null;
    const submit = document.getElementById('delete-submit') as HTMLButtonElement | null;
    if (errorBox) errorBox.hidden = true;

    // The point of no return deserves the browser's own confirmation too — the
    // form itself is one tap away from every other row on this screen.
    if (!window.confirm('Delete this account and everything in it? This cannot be undone.')) return;

    const field = new FormData(deleteForm);
    const payload: Record<string, string> = {};
    for (const [key, value] of field.entries()) payload[key] = String(value);

    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Deleting…';
    }

    // Deleting a full library is a long request; leave the button disabled and
    // let it finish rather than racing it with a second submit.
    const response = await fetch('/api/account', {
      method: 'DELETE',
      headers: { 'content-type': 'application/json', accept: 'application/json' },
      body: JSON.stringify(payload),
    }).catch(() => null);

    if (response?.ok) {
      // Nothing cached belongs to anyone now.
      if ('caches' in window) {
        await caches.keys().then((keys) => Promise.all(keys.map((key) => caches.delete(key))));
      }
      window.location.href = '/?deleted=1';
      return;
    }

    if (submit) {
      submit.disabled = false;
      submit.textContent = 'Delete permanently';
    }
    if (errorBox) {
      const body = (await response?.json().catch(() => null)) as { error?: { message?: string } } | null;
      errorBox.textContent = body?.error?.message ?? 'Could not delete your account. Try again.';
      errorBox.hidden = false;
    }
  });

  // Offer the PWA install prompt when the browser makes one available. This
  // row stays whether or not the workspace's install hint was dismissed.
  const installRow = document.getElementById('install-app') as HTMLButtonElement | null;
  watchInstall(() => {
    if (installRow) installRow.hidden = installHint(installEnvironment({ ignoreDismissed: true })) !== 'prompt';
  });
  installRow?.addEventListener('click', () => void promptInstall());

  // Change alerts on this device: the card is only rendered when the server
  // can send them; what it says depends on this browser.
  const alerts = document.querySelector<HTMLElement>('[data-device-alerts]');
  if (alerts) {
    const part = <T extends HTMLElement>(name: string) => alerts.querySelector<T>(`[data-alerts-${name}]`)!;
    const label = part('label'), text = part('text'), status = part('status');
    const on = part<HTMLButtonElement>('on'), test = part<HTMLButtonElement>('test'), off = part<HTMLButtonElement>('off');
    const COPY: Record<PushAlertState, [string, string]> = {
      unsupported: ['UNAVAILABLE', 'This browser cannot show push alerts. Email and webhook alerts arrive as usual.'],
      install: [
        'INSTALL FIRST',
        'On iPhone and iPad, alerts need the app on your Home Screen: tap Share, then Add to Home Screen, and open Easy Capture from there. Needs iOS 16.4 or later.',
      ],
      blocked: ['BLOCKED', 'Notifications are blocked for this site. Allow them in your browser’s site settings, then reload this page.'],
      off: ['OFF', 'Get a notification on this device when a monitored page changes. It says only that a page changed, never which one.'],
      on: ['ON', 'This device gets a notification when a monitored page changes. Signing out turns it off.'],
    };
    let publicKey: string | null = null;

    const refresh = async () => {
      const environment = {
        supported: pushSupported(),
        ios: isIOS(navigator.userAgent, navigator.maxTouchPoints),
        standalone: isStandalone(),
        permission: 'Notification' in window ? Notification.permission : ('default' as NotificationPermission),
        subscribed: false,
      };
      if (environment.supported && !(environment.ios && !environment.standalone)) {
        const [server, subscription] = await Promise.all([serverStatus().catch(() => null), browserSubscription()]);
        if (server && !server.available) {
          alerts.hidden = true;
          return;
        }
        publicKey = server?.publicKey ?? null;
        environment.subscribed = Boolean(server?.subscribed && subscription);
      }
      const state = pushAlertState(environment);
      [label.textContent, text.textContent] = [`[ ${COPY[state][0]} ]`, COPY[state][1]];
      on.hidden = state !== 'off';
      test.hidden = off.hidden = state !== 'on';
    };

    const act = async (button: HTMLButtonElement, work: () => Promise<string>) => {
      for (const b of [on, test, off]) b.disabled = true;
      status.textContent = '';
      try {
        status.textContent = await work();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Something went wrong. Try again.';
      } finally {
        for (const b of [on, test, off]) b.disabled = false;
        await refresh().catch(() => {});
        if (!button.hidden) button.focus();
      }
    };

    on.addEventListener('click', () => {
      // Asked here, inside the click, and never on load: Safari only shows the
      // question to a page the person just tapped.
      const permission = new Promise<NotificationPermission>((resolve) => {
        const asked = Notification.requestPermission(resolve);
        if (asked) asked.then(resolve, () => resolve('default'));
      });
      void act(on, async () => {
        if (!publicKey) throw new Error('Push alerts are not available right now. Reload the page and try again.');
        const answer = await turnOn(publicKey, permission);
        return answer === 'granted' ? 'Alerts are on for this device.' : answer === 'denied' ? '' : 'Notifications were not allowed.';
      });
    });
    test.addEventListener('click', () =>
      void act(test, async () => {
        const result = await sendTest();
        return result.sent
          ? 'Test alert sent. It should arrive in a few seconds.'
          : result.removed
            ? 'The push service no longer knows this device. Turn alerts on again.'
            : 'The push service did not take the test alert. Try again later.';
      }),
    );
    off.addEventListener('click', () =>
      void act(off, async () => {
        await turnOff();
        return 'Alerts are off for this device.';
      }),
    );
    void refresh().catch(() => {
      label.textContent = '[ UNAVAILABLE ]';
    });
  }
</script>
