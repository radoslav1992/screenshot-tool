---
import PlanEstimator from '../components/PlanEstimator.astro';
import WorkspaceFeatures from '../components/WorkspaceFeatures.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import { PLANS, PLAN_ORDER } from '../lib/plans';
import { billingEnabled, getBillingRow, hasActiveSubscription, planPurchasable } from '../lib/billing';
import { billingErrorMessage } from '../lib/billing-errors';

const user = Astro.locals.user;
const plans = PLAN_ORDER.map((id) => PLANS[id]);

const checkout = billingEnabled();
const purchasable = new Set(plans.filter((plan) => planPurchasable(plan.id)).map((plan) => plan.id));
const cancelled = Astro.url.searchParams.get('checkout') === 'cancelled';
// A code, looked up in a fixed list: nothing from the URL is ever shown as text.
const billingError = billingErrorMessage(Astro.url.searchParams.get('billing_error'));

// Someone Stripe is already billing switches plan in the portal — a second
// Checkout would start a second subscription and charge for both. The billing
// columns only exist after migration 0003, so a stale schema falls back to links.
const billing = checkout && user ? await getBillingRow(user.id).catch(() => null) : null;
const subscribed = hasActiveSubscription(billing);

// Open on the period the subscriber is actually billed on. Otherwise a yearly
// customer looking at the default monthly prices would switch plan and quietly
// change their billing period at the same time.
const startYearly = subscribed && billing?.plan_interval === 'yearly';
---

<Base title="Pricing" description="Start free with 20 screenshots a month. Upgrade when you need more.">
  <AiPage user={user}>
    <AiPageHead label="PRICING" meta={`${plans.length} PLANS / START FREE`} aside="Monthly or yearly billing">
      <Fragment slot="title">Simple <span>pricing</span></Fragment>
      <p>Start with a client project. Upgrade for clean PDF exports, monitoring, API access or collaboration.</p>
      <div class="switch" role="group" aria-label="Billing period">
        <button type="button" data-period="monthly" aria-pressed={!startYearly}>Monthly</button>
        <button type="button" data-period="yearly" aria-pressed={startYearly}>Yearly · save about 20%</button>
      </div>
    </AiPageHead>

    <section class="pricing-plans" aria-label="Plans">
      {
        billingError && (
          <p class="ai-strip ai-strip--error" role="alert">
            <strong>Checkout could not be started.</strong> {billingError}
          </p>
        )
      }

      {
        cancelled && (
          <p class="ai-strip" role="status">
            Checkout was cancelled — nothing was charged. Pick a plan whenever you are ready.
          </p>
        )
      }

      <div class="ai-panel">
        <div class="plan-grid">
          {
            plans.map((plan) => (
              <section id={`plan-${plan.id}`} class={plan.id === 'pro' ? 'plan plan--featured' : 'plan'}>
                {plan.id === 'pro' && <div class="plan__badge">FOR FREELANCERS</div>}

                <div class="plan__head">
                  <div class="plan__name">{plan.name}</div>
                  <div>
                    <span class="plan__price" data-price-for={plan.id} data-monthly={plan.priceMonthly} data-yearly={plan.priceYearly}>
                      ${startYearly ? plan.priceYearly : plan.priceMonthly}
                    </span>
                    <span class="plan__per" data-per>{startYearly ? '/yr' : '/mo'}</span>
                  </div>
                </div>

                <p class="small" style={plan.id === 'pro' ? 'color: var(--dim); margin-top: 6px' : 'color: var(--muted); margin-top: 6px'}>
                  {plan.tagline}
                </p>

                <p class="xs" data-annual-note data-annual={plan.priceYearly} data-month={plan.priceMonthly}
                  style="margin-top: 10px" hidden={!startYearly || plan.id === 'free'}>
                  Billed ${plan.priceYearly} once per year · save ${plan.priceMonthly * 12 - plan.priceYearly}/year.
                </p>
                <ul class="plan__features">
                  {plan.features.map((feature) => (
                    <li data-included={String(feature.included)} style="display: flex; gap: 8px; align-items: flex-start">
                      <Icon name={feature.included ? 'check' : 'alert'} size={15} />
                      <span>{feature.text}</span>
                    </li>
                  ))}
                </ul>

                {
                  user && user.plan === plan.id ? (
                    <div class="plan__cta">
                      <span class="btn btn--outline-ink is-current" aria-disabled="true">Current plan</span>
                    </div>
                  ) : subscribed && plan.id !== 'free' ? (
                    <form class="plan__cta" method="post" action="/api/billing/portal">
                      <input type="hidden" name="plan" value={plan.id} />
                      <input type="hidden" name="interval" value={startYearly ? 'yearly' : 'monthly'} data-interval />
                      <button type="submit" class={plan.id === 'pro' ? 'btn btn--lime' : 'btn btn--outline-ink'}>
                        Switch to {plan.name}
                      </button>
                    </form>
                  ) : user && purchasable.has(plan.id) ? (
                    <form class="plan__cta" method="post" action="/api/billing/checkout">
                      <input type="hidden" name="plan" value={plan.id} />
                      <input type="hidden" name="interval" value="monthly" data-interval />
                      <button type="submit" class={plan.id === 'pro' ? 'btn btn--lime' : 'btn btn--outline-ink'}>
                        {plan.cta}
                      </button>
                    </form>
                  ) : (
                    <div class="plan__cta">
                      <a
                        class={plan.id === 'pro' ? 'btn btn--lime' : 'btn btn--outline-ink'}
                        href={user ? '/app/account' : `/signup?plan=${plan.id}`}
                      >
                        {plan.cta}
                      </a>
                    </div>
                  )
                }
              </section>
            ))
          }
        </div>

      </div>

      <div class="pricing-foot">
        <span class="pricing-foot__label">[ GOOD TO KNOW ]</span>
        <div>
          <p>
            Need more? <a href="mailto:hello@easyscreencapture.com">Talk to us</a> about custom volume.
          </p>
          {
            checkout && (
              <p>Secure checkout by Stripe. Cancel any time — you keep the plan until the period you paid for ends.</p>
            )
          }
          {
            !checkout && (
              <p>Paid checkout is not available yet. You can start with Free and keep using your workspace.</p>
            )
          }
          <p>
            Manual captures and monitor checks share the monthly screenshot allowance. A daily monitor uses about 30
            screenshots per month; an hourly monitor uses about 720. Pro includes 2,000 screenshots: enough for 25 daily
            monitors, but not all 25 hourly. Monitor limits describe saved pages, not unlimited checks.
          </p>
        </div>
      </div>
    </section>

    <PlanEstimator />
    <WorkspaceFeatures />
  </AiPage>
</Base>

<style>
  .pricing-plans {
    margin-top: 35px;
    border-top: 1px solid var(--line);
  }
  .pricing-foot {
    display: grid;
    grid-template-columns: 1fr 3fr;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .pricing-foot__label {
    padding: 20px;
    border-right: 1px solid var(--line);
    font: 10px/1.5 var(--mono);
  }
  .pricing-foot > div {
    display: grid;
    gap: 10px;
    padding: 22px 25px 26px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }
  .pricing-foot p {
    max-width: 80ch;
  }
  .pricing-foot a {
    color: var(--green);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 767px) {
    .pricing-plans {
      margin-top: 20px;
    }
    .pricing-foot {
      grid-template-columns: 1fr;
    }
    .pricing-foot__label {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 14px 15px;
    }
    .pricing-foot > div {
      padding: 18px 15px 22px;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-period]');
  const prices = document.querySelectorAll<HTMLElement>('[data-price-for]');
  const pers = document.querySelectorAll<HTMLElement>('[data-per]');
  const intervals = document.querySelectorAll<HTMLInputElement>('[data-interval]');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const yearly = button.dataset.period === 'yearly';
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));

      for (const price of prices) {
        const monthly = Number(price.dataset.monthly ?? 0);
        const annual = Number(price.dataset.yearly ?? 0);
        price.textContent = yearly ? `$${annual}` : `$${monthly}`;
      }
      for (const note of document.querySelectorAll<HTMLElement>('[data-annual-note]')) {
        note.hidden = !yearly || Number(note.dataset.annual) === 0;
      }
      for (const per of pers) per.textContent = yearly ? '/yr' : '/mo';
      // Checkout has to buy the price the visitor is looking at.
      for (const input of intervals) input.value = yearly ? 'yearly' : 'monthly';
    });
  }
</script>
