---
/**
 * The product, shown rather than described: one page captured at two sizes.
 *
 * Drawn in CSS rather than shipped as an image — it stays crisp at any density,
 * costs no bytes, and never goes stale against the real UI.
 */
---

<div class="heroviz" aria-hidden="true">
  <div class="heroviz__desktop">
    <div class="heroviz__chrome">
      <span></span><span></span><span></span>
      <div class="heroviz__url">yoursite.com</div>
    </div>
    <div class="heroviz__page">
      <div class="heroviz__nav">
        <div class="heroviz__logo"></div>
        <div class="heroviz__links"><i></i><i></i><i></i></div>
      </div>
      <div class="heroviz__hero">
        <div class="heroviz__h1"></div>
        <div class="heroviz__h1 heroviz__h1--short"></div>
        <div class="heroviz__p"></div>
        <div class="heroviz__p heroviz__p--short"></div>
        <div class="heroviz__cta"></div>
      </div>
      <div class="heroviz__cards"><b></b><b></b><b></b></div>
    </div>
    <div class="heroviz__tag heroviz__tag--desktop">1440×900</div>
  </div>

  <div class="heroviz__phone">
    <div class="heroviz__page heroviz__page--sm">
      <div class="heroviz__nav">
        <div class="heroviz__logo"></div>
        <div class="heroviz__burger"></div>
      </div>
      <div class="heroviz__hero">
        <div class="heroviz__h1"></div>
        <div class="heroviz__h1 heroviz__h1--short"></div>
        <div class="heroviz__p"></div>
        <div class="heroviz__cta"></div>
      </div>
      <div class="heroviz__cards heroviz__cards--stack"><b></b><b></b></div>
    </div>
    <div class="heroviz__tag heroviz__tag--phone">1080×1920</div>
  </div>
</div>
