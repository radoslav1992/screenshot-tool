---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AdonPreview from "../components/AdonPreview.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { FRAME_LIST, MODES } from "../lib/capture-options";
import { PLANS, WATCH_LIMIT } from "../lib/plans";
import "../styles/adon/ai-source.css";
import "../styles/adon/previews.css";
import "../styles/adon/ai-landing.css";
const user = Astro.locals.user;
const captureHref = user ? "/app" : "/signup";
const monitorHref = user ? "/app/watches" : "/signup?next=%2Fapp%2Fwatches";
const justDeleted = Astro.url.searchParams.get("deleted") === "1";
const curl = `curl https://easyscreencapture.com/v1/capture \\\n  -H "Authorization: Bearer $KEY" \\\n  -d url="yoursite.com" \\\n  -d device="desktop" \\\n  -d mode="fullpage"`;
const projects = [
  {
    number: "01",
    title: "The whole page. In one take.",
    text: "Capture the viewport, the full page, or a scroll series. Keep the details that matter.",
    tag: "WEBSITE CAPTURE",
    variant: "capture",
    href: captureHref,
  },
  {
    number: "02",
    title: "A change you won’t miss.",
    text: "Schedule a check. Compare it with the last capture. Get an alert when your threshold is met.",
    tag: "VISUAL MONITORING",
    variant: "monitor",
    href: monitorHref,
  },
  {
    number: "03",
    title: "Made for the next handoff.",
    text: "Bring captures together in a project and share a before-and-after report with an expiring link.",
    tag: "CLIENT REPORTS",
    variant: "report",
    href: "/sample-report",
  },
  {
    number: "04",
    title: "Every screen, considered.",
    text: "Check desktop and mobile, or choose a ready-made size for your next social post.",
    tag: "RESPONSIVE CAPTURE",
    variant: "devices",
    href: "#sizes",
  },
] as const;
const faqs = [
  {
    q: "Can I start without a subscription?",
    a: `Yes. Create a free account with ${PLANS.free.quota} screenshots per calendar month. No credit card is needed. You can upgrade when your workflow grows.`,
  },
  {
    q: "How does website monitoring work?",
    a: `Save a page, choose a device and a schedule, then set your change threshold. We compare new captures with the previous capture and send alerts when it is met. Plus includes ${WATCH_LIMIT.plus} monitor slots; scheduled checks use your screenshot allowance.`,
  },
  {
    q: "Can I capture through an API?",
    a: "Yes. API access starts on Pro. Generate an API key in your workspace and use the same capture engine in your own tools. See the API documentation for supported options.",
  },
  {
    q: "How do I share my work?",
    a: "Download a capture, organise images into projects, or create a web report with an expiring review link. PDF report exports are available on plans that include PDF.",
  },
];
---

<Base
  title="Easy Screen Capture"
  themeColor="#F5F5F5"
  bodyClass="body-ai-agency"
  description="Capture websites, monitor visual changes, and share clear visual reports. Your website workflow, connected."
>
  <a class="adon-skip-link" href="#main-content">
    Skip to content
  </a>
  <div class="page ai-landing">
    <SiteHeader user={user} />
    <main id="main-content" class="ai-grid wrap">
      {justDeleted && (
        <div class="notice notice--info">
          Your account and everything in it have been deleted. Thanks for trying
          Easy Screen Capture.
        </div>
      )}
      <section class="hero-area-17" aria-labelledby="hero-title">
        <div class="ai-hero-label">
          <span>[ YOUR WEBSITE, IN FOCUS ]</span>
          <span>CAPTURE / MONITOR / SHARE</span>
        </div>
        <div class="hero-17-header">
          <h1 id="hero-title" class="hero-17-title" data-adon-title>
            CAPTURE THE WEB.
            <br />
            CATCH THE CHANGE.
            <br />
            <span>STAY AHEAD.</span>
          </h1>
        </div>
        <div class="hero-17-content">
          <div class="location-wrapper">
            <span class="location">[ ONE CONNECTED WORKSPACE ]</span>
            <div class="ai-network-art" aria-hidden="true">
              <img
                src="/vendor/adon/shapes/shape-s-5.webp"
                alt=""
                width="125"
                height="125"
              />
              <span class="ai-cross ai-cross--one">+</span>
              <span class="ai-cross ai-cross--two">+</span>
              <span class="ai-cross ai-cross--three">+</span>
              <span class="ai-cross ai-cross--four">+</span>
            </div>
            <span class="ai-art-label">CAPTURE. CONNECT. CONTINUE.</span>
          </div>
          <div class="experience-wrapper">
            <span class="experience">FREE CAPTURES / MONTH</span>
            <span class="year" data-adon-count={PLANS.free.quota}>
              {PLANS.free.quota}
            </span>
            <span class="ai-art-label">NO CREDIT CARD NEEDED</span>
          </div>
          <div class="text-wrapper">
            <p class="text">
              Turn a live page into a clear picture. Capture websites, catch
              updates, and keep every review in one place.
            </p>
            <form class="hero-capture" method="get" action={captureHref}>
              <label for="hero-url">YOUR FIRST CAPTURE STARTS HERE</label>
              <input
                id="hero-url"
                name="url"
                inputmode="url"
                autocomplete="url"
                placeholder="Paste a website URL"
                required
              />
              <button class="rr-btn-classic" type="submit">
                Capture page <span aria-hidden="true">↗</span>
              </button>
            </form>
          </div>
        </div>
        <div class="hero-17-image ai-hero-showcase">
          <div class="ai-showcase-caption">
            <span>[ THE BIG PICTURE ]</span>
            <span>ILLUSTRATIVE PREVIEW / 01</span>
          </div>
          <div class="ai-showcase-main" data-adon-parallax>
            <AdonPreview />
          </div>
          <div class="ai-showcase-monitor" data-adon-reveal>
            <AdonPreview variant="monitor" />
          </div>
          <div class="ai-showcase-bottom">
            <span>
              EVERY SCREEN.
              <br />
              EVERY DETAIL.
            </span>
            <a href="#workflows">EXPLORE YOUR WORKFLOW ↓</a>
          </div>
        </div>
      </section>
      <section class="service-area-17" id="workflows">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ CAPABILITIES ]</span>
          <h2 data-adon-title>
            YOUR VISUAL
            <br />
            WORKFLOW.
            <br />
            CONNECTED.
          </h2>
        </div>
        <div class="ai-capabilities" data-ai-tabs>
          <div class="ai-tab-list" aria-label="Workspace capabilities">
            {projects.map((_project, index) => (
              <button
                type="button"
                id={`capability-${index}`}
                data-ai-tab={index}
                aria-controls={`capability-panel-${index}`}
              >
                <span>[ 0{index + 1} ]</span>
                {
                  [
                    "Website capture",
                    "Visual monitoring",
                    "Client reports",
                    "Every screen",
                  ][index]
                }
                <span aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
          <div class="ai-tab-panels">
            {projects.map((project, index) => (
              <article
                id={`capability-panel-${index}`}
                data-ai-panel={index}
                aria-labelledby={`capability-${index}`}
              >
                <div class="ai-capability-copy">
                  <span class="ai-eyebrow">{project.tag}</span>
                  <h3>{project.title}</h3>
                  <p>{project.text}</p>
                  <a class="rr-btn-classic" href={project.href}>
                    Explore this workflow <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <div class="ai-capability-art">
                  <img
                    src={`/vendor/adon/shapes/shape-s-${[5, 7, 8, 9][index]}.webp`}
                    width="125"
                    height="125"
                    alt=""
                    loading="lazy"
                  />
                  <span>[ 0{index + 1} / CONNECTED ]</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="portfolio-area-17">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ OUTPUT, NOT BUSYWORK ]</span>
          <h2 data-adon-title>
            SEE IT.
            <br />
            SAVE IT.
            <br />
            SHARE IT.
          </h2>
        </div>
        <div class="ai-gallery-toolbar">
          <p>A better view of your work.</p>
          <div>
            <button type="button" data-ai-prev aria-label="Previous example">
              ←
            </button>
            <button type="button" data-ai-next aria-label="Next example">
              →
            </button>
          </div>
        </div>
        <div
          class="ai-gallery"
          data-ai-gallery
          tabindex="0"
          role="region"
          aria-label="Capture examples, scroll horizontally"
        >
          {projects.map((project) => (
            <article class="ai-gallery-card">
              <a href={project.href} aria-label={project.title}>
                <AdonPreview variant={project.variant} />
              </a>
              <div>
                <span>{project.tag}</span>
                <span>/{project.number}</span>
              </div>
              <h3>
                <a href={project.href}>{project.title}</a>
              </h3>
            </article>
          ))}
        </div>
      </section>
      <section class="feature-area-17" id="modes">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ CORE FEATURES ]</span>
          <h2 data-adon-title>
            THE RIGHT FRAME.
            <br />
            EVERY TIME.
          </h2>
        </div>
        <div class="ai-features">
          {MODES.map((mode, index) => (
            <article data-adon-reveal>
              <div class="ai-feature-top">
                <img
                  src={`/vendor/adon/shapes/shape-s-${7 + index}.webp`}
                  alt=""
                  width="100"
                  height="100"
                  loading="lazy"
                />
                <span>[ 0{index + 1} ]</span>
              </div>
              <h3>{mode.label}</h3>
              <p>{mode.longHint}</p>
              <Icon name={mode.icon} size={28} />
            </article>
          ))}
        </div>
        <div class="output-sizes" id="sizes">
          <span>READY-MADE SIZES</span>
          {FRAME_LIST.map((frame) => (
            <span>
              <Icon name={frame.icon} size={16} />
              {frame.label}
              <small>{frame.output}</small>
            </span>
          ))}
        </div>
      </section>
      <section class="funfact-area-17" id="monitoring">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ ALWAYS IN THE PICTURE ]</span>
          <h2 data-adon-title>
            THE PAGE CHANGED.
            <br />
            YOU’RE ALREADY
            <br />
            ON IT.
          </h2>
        </div>
        <div class="ai-monitor-grid">
          <div class="growth-cube-wrapper">
            <h3>[ YOUR WORKFLOW, IN MOTION ]</h3>
            <div class="cubes-wrapper" data-ai-cubes aria-hidden="true">
              <img
                class="cube-one"
                src="/vendor/adon/shapes/shape-s-10.webp"
                alt=""
                width="225"
                height="204"
              />
              <img
                class="cube-two"
                src="/vendor/adon/shapes/shape-s-11.webp"
                alt=""
                width="200"
                height="183"
              />
              <img
                class="cube-three"
                src="/vendor/adon/shapes/shape-s-12.webp"
                alt=""
                width="200"
                height="184"
              />
            </div>
            <button
              class="adon-motion-toggle"
              type="button"
              aria-pressed="false"
            >
              Pause motion
            </button>
          </div>
          <div class="ai-monitor-copy">
            <h3>A SECOND PAIR OF EYES.</h3>
            <p>
              Pick a page, choose a schedule, and set your change threshold.
              Review the before and after, then send alerts to email, Slack,
              Discord, or your webhook.
            </p>
            <p>
              Use “any change” when every detected pixel matters. Each scheduled
              check uses your screenshot allowance.
            </p>
            <a class="rr-btn-classic" href={monitorHref}>
              Set up a monitor <span aria-hidden="true">↗</span>
            </a>
            <div class="ai-stats">
              <div>
                <span>PLUS MONITOR SLOTS</span>
                <strong data-adon-count={WATCH_LIMIT.plus}>
                  {WATCH_LIMIT.plus}
                </strong>
              </div>
              <div>
                <span>PLUS / MONTH</span>
                <strong>${PLANS.plus.priceMonthly}</strong>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="ai-api">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ FOR THE BUILDERS ]</span>
          <h2 data-adon-title>
            YOUR APP.
            <br />
            OUR CAPTURE ENGINE.
          </h2>
        </div>
        <div class="ai-api-grid">
          <div>
            <p>
              Capture through an API, process URL lists and sitemaps, and
              connect the tools you already use. API access starts on Pro.
            </p>
            <a class="rr-btn-classic" href="/docs">
              Explore the API <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div data-adon-reveal>
            <CodeBlock tag="POST /v1/capture" code={curl} />
          </div>
        </div>
      </section>
      <section class="ai-faq">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ GOOD QUESTIONS ]</span>
          <h2 data-adon-title>
            A LITTLE
            <br />
            MORE CLARITY.
          </h2>
        </div>
        <div class="ai-faq-list">
          {faqs.map((faq, index) => (
            <details>
              <summary>
                <span>[ 0{index + 1} ]</span>
                {faq.q}
                <i aria-hidden="true">+</i>
              </summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
      <section class="cta-area-17">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ YOUR NEXT MOVE ]</span>
          <div>
            <h2 data-adon-title>
              LET’S
              <br />
              <span class="ai-orange-text">CAPTURE.</span>
            </h2>
            <a class="rr-btn-classic" href={captureHref}>
              {user ? "Open your workspace" : "Start capturing free"}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</Base>
<script>
  import "../scripts/adon-ai";
  const form = document.querySelector<HTMLFormElement>(".hero-capture");
  form?.addEventListener("submit", (event) => {
    const input = form.querySelector<HTMLInputElement>('input[name="url"]')!;
    const value = input.value.trim();
    if (!value) {
      event.preventDefault();
      input.focus();
      return;
    }
    input.value = /^https?:\/\//i.test(value) ? value : `https://${value}`;
  });
</script>
