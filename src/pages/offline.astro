---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

export const prerender = true;
---

<Base title="Offline">
  <div class="shell">
    <div class="empty" style="margin: auto">
      <div class="empty__icon"><Icon name="offline" size={34} /></div>
      <h1 class="h3" style="margin-top: 12px">You are offline</h1>
      <p class="small muted" style="margin-top: 8px; max-width: 30ch; margin-inline: auto">
        Screenify needs a connection to render captures. Your library will be here when you are back.
      </p>
      <button type="button" class="btn btn--ink" style="max-width: 220px; margin: 20px auto 0" onclick="location.reload()">
        Try again
      </button>
    </div>
  </div>
</Base>
