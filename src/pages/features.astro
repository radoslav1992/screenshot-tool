---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import WorkspaceFeatures from '../components/WorkspaceFeatures.astro';
const user = Astro.locals.user;
---

<Base
  title="Website capture, monitoring and client reports"
  description="Capture pages in batches, monitor visual changes, and deliver branded client reports. Compare features, usage limits, sharing and retention."
>
  <AiPage user={user}>
    <AiPageHead
      label="FEATURES"
      meta="CAPTURE / CHECK / EXPLAIN"
      eyebrow="BUILT FOR CLIENT WEBSITE WORK"
      aside="From launch check to scheduled comparison"
    >
      <Fragment slot="title">
        Capture. Check.
        <br />
        <span>Explain the change.</span>
      </Fragment>
      <p>
        Keep client evidence in one project—from desktop and mobile launch checks to the next scheduled comparison.
      </p>
      <div class="ai-actions">
        <a class="rr-btn-classic" href={user ? '/app/start' : '/signup?next=%2Fapp%2Fstart'}>
          Build your first workflow <span aria-hidden="true">↗</span>
        </a>
      </div>
    </AiPageHead>
    <WorkspaceFeatures />
  </AiPage>
</Base>
