---
import { env } from 'cloudflare:workers';
import AppShell from '../../../layouts/AppShell.astro';
import ProjectForms from '../../../components/ProjectForms.astro';
import ReviewReport from '../../../components/ReviewReport.astro';
import BrandingForm from '../../../components/BrandingForm.astro';
import { collaborationReady, projectAccess } from '../../../lib/collaboration';
import { reportCaptures, type Report } from '../../../lib/projects';
import { brandingReady, brandingRow, projectBranding } from '../../../lib/branding';
import { canHideAttribution } from '../../../lib/branding-rules';
import { SIGNOFF_LABELS, currentSignoff, projectSignoffStates, signoffsReady } from '../../../lib/signoff';
import { canSendEmail } from '../../../lib/mailer';
import '../../../styles/projects.css';
const mailReady = canSendEmail();
if (!(await collaborationReady()))
  return new Response('Collaboration is being prepared. Please try again later.', { status: 503 });
let access;
try {
  access = await projectAccess(Astro.locals.user!.id, Astro.params.id!);
} catch {
  return new Response('Project not found', { status: 404 });
}
const { project, role } = access;
const reports = (
  await env.DB.prepare('SELECT * FROM review_reports WHERE project_id=? ORDER BY created_at DESC')
    .bind(project.id)
    .all<Report>()
).results;
const selected = reports.find((r) => r.id === Astro.url.searchParams.get('report'));
const captures = selected ? await reportCaptures(selected, project.user_id) : [];
// Sign-off and branding read as absent until their migration is applied.
const [signoffs, brandingOn] = await Promise.all([signoffsReady(), brandingReady()]);
const editsBranding = role === 'editor' && brandingOn;
const [signoffStates, signoff, branding, brandingSaved, owner] = await Promise.all([
  signoffs ? projectSignoffStates(project.id) : null,
  signoffs && selected ? currentSignoff(selected.id) : undefined,
  selected ? projectBranding(project) : null,
  editsBranding ? brandingRow(project.id) : null,
  editsBranding
    ? env.DB.prepare('SELECT plan FROM users WHERE id=?').bind(project.user_id).first<{ plan: string }>()
    : null,
]);
const members =
  role === 'owner'
    ? (
        await env.DB.prepare('SELECT id,email_lower,role,user_id,expires_at FROM project_members WHERE project_id=?')
          .bind(project.id)
          .all<{ id: string; email_lower: string; role: string; user_id: string | null; expires_at: string }>()
      ).results
    : [];
const comments = selected
  ? (
      await env.DB.prepare(
        'SELECT c.body,c.created_at,u.name FROM team_comments c JOIN users u ON u.id=c.user_id WHERE report_id=? ORDER BY c.created_at',
      )
        .bind(selected.id)
        .all<{ body: string; created_at: string; name: string }>()
    ).results
  : [];
const digest = await env.DB.prepare('SELECT * FROM project_digests WHERE project_id=? AND user_id=?')
  .bind(project.id, Astro.locals.user!.id)
  .first<{ timezone: string; enabled: number }>();
const delivery = await env.DB.prepare(
  'SELECT status,created_at FROM digest_deliveries WHERE project_id=? AND user_id=? ORDER BY created_at DESC LIMIT 1',
)
  .bind(project.id, Astro.locals.user!.id)
  .first<{ status: string; created_at: string }>();
Astro.response.headers.set('cache-control', 'private, no-store');
---

<AppShell title={project.name + ' · Team'} tab="projects">
  <header class="appbar" slot="appbar">
    <a href={role === 'owner' ? `/app/projects/${project.id}` : '/app/projects'}>← Projects</a>
    <span class="pill">{role}</span>
  </header>
  <div class="app-wrap stack gap-20">
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">PROJECT COLLABORATION</span>
        <h1>{project.name}</h1>
        <p>Review the evidence together.</p>
      </div>
    </div>
    <div class="project-grid">
      <section class="project-panel">
        <h2>Shared with the team</h2>
        <div class="project-items">
          {reports.map((r) => {
            const state = signoffStates ? (signoffStates.get(r.id) ?? 'awaiting') : null;
            return (
              <a class:list={['project-item', { 'project-item--report': state }]} href={`?report=${r.id}`}>
                <span>{r.title} →</span>
                {state && <span class:list={['signoff-tag', `signoff-tag--${state}`]}>[ {SIGNOFF_LABELS[state]} ]</span>}
              </a>
            );
          })}
        </div>
        <p class="small muted">
          Project reports are visible to every member. Owner-only internal notes and account capture history remain
          private.
        </p>
      </section>
      <section class="project-panel">
        <h2>Your weekly digest</h2>
        <p class="small muted">
          Every Monday after 09:00 in your timezone. Sent only to your verified account email:{' '}
          {Astro.locals.user!.email}. Includes completed checks, changes and failures from this project.
        </p>
        <form data-project-form data-endpoint="/api/collaboration">
          <input type="hidden" name="action" value="digest" />
          <input type="hidden" name="project_id" value={project.id} />
          <label>
            <span>
              <input type="checkbox" name="enabled" value="1" checked={!!digest?.enabled} /> Email me a weekly summary
            </span>
          </label>
          <label>
            Timezone
            <input
              class="input"
              name="timezone"
              required
              value={digest?.timezone ?? 'UTC'}
              placeholder="Europe/Sofia"
            />
          </label>
          <button type="submit" class="btn btn--outline">
            Save digest preference
          </button>
          <p role="status"></p>
        </form>
        {delivery && (
          <p class="small muted">
            Last digest: {delivery.status} · {delivery.created_at.slice(0, 16)} UTC. Accepted means provider acceptance,
            not inbox delivery.
          </p>
        )}
      </section>
      {role === 'owner' && (
        <section class="project-panel">
          <h2>Team access · Business</h2>
          <p class="small muted">
            Business includes up to three collaborators per project at the existing price. Pending invites reserve a
            seat for seven days. Viewers read reports; editors also add team comments. The owner manages captures,
            reports, links, billing and monitors. A downgrade pauses collaborator access.
          </p>
          {members.map((m) => (
            <div class="project-item">
              <p>
                {m.email_lower} · {m.role} · {m.user_id ? 'Joined' : `Pending until ${m.expires_at.slice(0, 10)}`}
              </p>
              <form data-project-form data-endpoint="/api/collaboration">
                <input type="hidden" name="action" value="revoke_member" />
                <input type="hidden" name="project_id" value={project.id} />
                <input type="hidden" name="member_id" value={m.id} />
                <button type="submit" class="btn btn--outline">
                  Revoke access
                </button>
                <p role="status"></p>
              </form>
            </div>
          ))}
          <form data-invite-form>
            <input type="hidden" name="action" value="invite" />
            <input type="hidden" name="project_id" value={project.id} />
            <label>
              Email
              <input class="input" name="email" type="email" required maxlength="254" />
            </label>
            <label>
              Role
              <select class="input" name="role">
                <option value="viewer">Viewer · read reports</option>
                <option value="editor">Editor · read and comment</option>
              </select>
            </label>
            <button type="submit" class="btn btn--ink">
              {mailReady ? 'Send invitation' : 'Create invitation link'}
            </button>
            <p role="status"></p>
          </form>
          <p class="small muted">
            {mailReady
              ? 'We email the invitation link to your collaborator. You also get the link here, to copy and send yourself if the email does not arrive.'
              : 'Invitation emails are not available right now, so copy the invitation link and send it to your collaborator yourself.'}
            {' '}The collaborator signs in or creates a free account with that address and confirms it before joining.
          </p>
        </section>
      )}
    </div>
    {editsBranding && (
      <BrandingForm
        projectId={project.id}
        brand={project.brand || project.name}
        row={brandingSaved}
        canHide={canHideAttribution(owner?.plan)}
      />
    )}
    {selected && (
      <>
        <ReviewReport project={project} report={selected} captures={captures} branding={branding} signoff={signoff} />
        <section class="project-panel">
          <h2>Team discussion</h2>
          <p class="small muted">Visible to project members. Excluded from public review links and PDF exports.</p>
          {comments.map((c) => (
            <div class="project-item">
              <p class="report-notes">{c.body}</p>
              <small>
                {c.name || 'Project member'} · {c.created_at.slice(0, 16)} UTC
              </small>
            </div>
          ))}
          {role !== 'viewer' && (
            <form data-project-form data-endpoint="/api/collaboration">
              <input type="hidden" name="action" value="comment" />
              <input type="hidden" name="project_id" value={project.id} />
              <input type="hidden" name="report_id" value={selected.id} />
              <label>
                Comment<textarea class="input" name="body" required maxlength="2000" rows="3"></textarea>
              </label>
              <button type="submit" class="btn btn--outline">
                Add team comment
              </button>
              <p role="status"></p>
            </form>
          )}
        </section>
      </>
    )}
  </div>
  <ProjectForms />
</AppShell>

<script>
  // Invitations get their own handler: the shared one only knows "copy this
  // link", and here the link has usually been emailed already.
  document.querySelectorAll<HTMLFormElement>('form[data-invite-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.busy) return;
      const status = form.querySelector<HTMLElement>('[role="status"]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      form.dataset.busy = 'true';
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const response = await fetch('/api/collaboration', { method: 'POST', body: new FormData(form) });
        const result = (await response.json()) as {
          error?: { message?: string };
          share_url?: string;
          emailed?: boolean;
          email?: string;
        };
        if (!response.ok || !result.share_url) throw new Error(result.error?.message ?? 'Could not create the invitation.');

        status.textContent = result.emailed
          ? `Invitation emailed to ${result.email}. If it does not arrive, send them this link: `
          : 'The invitation was not emailed. Copy this link now and send it to your collaborator: ';
        const output = document.createElement('input');
        output.className = 'input';
        output.value = result.share_url;
        output.readOnly = true;
        output.setAttribute('aria-label', 'Invitation link');
        status.appendChild(output);
        output.select();
        form.querySelector<HTMLInputElement>('input[name="email"]')!.value = '';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Could not send the invitation. Please try again.';
      } finally {
        delete form.dataset.busy;
        button.disabled = false;
      }
    });
  });
</script>
