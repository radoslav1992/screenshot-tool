---
import AppShell from '../../../layouts/AppShell.astro';
import ProjectForms from '../../../components/ProjectForms.astro';
import CareReport from '../../../components/CareReport.astro';
import {
  CARE_EMAIL_PLANS,
  CARE_REPORT_PLANS,
  careDeliveries,
  careReportsReady,
  careSettings,
  linkLive,
  ownCareReport,
} from '../../../lib/care-reports';
import { CARE_LIMITS, CARE_LINK_DAYS } from '../../../lib/care-rules';
import { manualPeriods } from '../../../lib/care-period';
import { projectBranding } from '../../../lib/branding';
import { careEmailsIncluded, careReportsIncluded } from '../../../lib/plans';
import { canSendEmail } from '../../../lib/mailer';
import { formatDateTime } from '../../../lib/dates';
import '../../../styles/projects.css';

const user = Astro.locals.user!;
if (!(await careReportsReady().catch(() => false))) return new Response('Not found', { status: 404 });
let data;
try {
  data = await ownCareReport(user.id, Astro.params.id ?? '');
} catch {
  return new Response('Care report not found', { status: 404 });
}
const { report, project, snapshot } = data;
const [branding, deliveries, settings] = await Promise.all([
  projectBranding(project).catch(() => null),
  careDeliveries(report.id),
  careSettings(project.id),
]);
Astro.response.headers.set('cache-control', 'private, no-store');
const reports = careReportsIncluded(user.plan);
const emails = careEmailsIncluded(user.plan);
const live = linkLive(report);
const fields = { report_id: report.id };
const clients = deliveries.filter((d) => d.role === 'client');
const pending = settings.recipients.filter((email) => !deliveries.some((d) => d.email === email));
const regenerable = report.kind === 'manual' && manualPeriods(settings.timezone, new Date()).includes(report.period);
const linkState = report.revoked_at
  ? `Revoked ${formatDateTime(report.revoked_at)}. No link to this report works.`
  : live
    ? `Links work until ${formatDateTime(report.expires_at)}`
    : `Links expired ${formatDateTime(report.expires_at)}`;
const views = `${report.access_count.toLocaleString()} view${report.access_count === 1 ? '' : 's'}`;
const statusWords: Record<string, string> = { accepted: 'Accepted by the mail provider', failed: 'Failed', unknown: 'Not confirmed' };
---

<AppShell title={`${snapshot.period.label} care report`} tab="projects">
  <header class="appbar" slot="appbar">
    <a href={`/app/projects/${project.id}/care`}>← Care reports</a>
    <div class="appbar__title truncate">{project.name}</div>
  </header>
  <div class="app-wrap stack gap-20">
    <div class="btn-row no-print">
      {
        reports ? (
          <form method="post" action={`/api/care/${report.id}/pdf`}>
            <button class="btn btn--lime" type="submit">
              Download PDF
            </button>
          </form>
        ) : (
          <a class="btn btn--outline" href="/app/upgrade">
            PDF · {CARE_REPORT_PLANS}
          </a>
        )
      }
      <span class="small muted">
        {report.kind === 'scheduled' ? 'Made by the monthly schedule' : 'Generated by hand'} on {formatDateTime(report.generated_at)}{' '}
        and frozen then: later checks, retention and edits do not change it. Up to {CARE_LIMITS.pdf.limit} PDFs an hour.
      </span>
    </div>

    <CareReport snapshot={snapshot} branding={branding} mode="owner" reportId={report.id} />

    <div class="project-grid no-print">
      <section class="project-panel" aria-labelledby="care-link-heading">
        <h2 class="section-heading" id="care-link-heading"><span>[ 01 ]</span> Share link</h2>
        <p class="small muted">
          Anyone with a link can read this report, with no account. Each client gets their own link by email; yours
          is separate, so replacing it never breaks theirs. Revoking stops every link at once.
        </p>
        <p class="link-state">
          {linkState}
          {!report.revoked_at && <> · {views}</>}
          {report.last_access_at && <> · Last view {formatDateTime(report.last_access_at)}</>}
        </p>
        {
          reports && (
            <form
              data-project-form
              data-endpoint="/api/care"
              data-pending="Making a link…"
              data-confirm={report.token_hash ? 'Make a new link? The one you copied before stops working; links emailed to clients keep working.' : undefined}
            >
              <input type="hidden" name="action" value="link" />
              {Object.entries(fields).map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}
              <div class="btn-row">
                <button class="btn btn--outline-ink" type="submit">
                  {report.token_hash ? 'New link to copy' : 'Make a link to copy'}
                </button>
              </div>
              <p role="status" />
            </form>
          )
        }
        {
          reports && !report.revoked_at && (
            <form data-project-form data-endpoint="/api/care" data-pending="Extending…">
              <input type="hidden" name="action" value="extend" />
              {Object.entries(fields).map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}
              <div class="btn-row">
                <button class="btn btn--outline" type="submit">
                  Extend to {CARE_LINK_DAYS} days from today
                </button>
              </div>
              <p role="status" />
            </form>
          )
        }
        {
          !report.revoked_at && (
            <form
              data-project-form
              data-endpoint="/api/care"
              class="danger-zone"
              data-pending="Revoking…"
              data-confirm="Revoke every link to this report? Your client loses access immediately, including the links in their emails."
            >
              <input type="hidden" name="action" value="revoke" />
              {Object.entries(fields).map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}
              <div class="btn-row">
                <button class="btn btn--danger-outline" type="submit">
                  Revoke all links
                </button>
              </div>
              <p role="status" />
            </form>
          )
        }
      </section>

      <section class="project-panel" aria-labelledby="care-send-heading">
        <h2 class="section-heading" id="care-send-heading"><span>[ 02 ]</span> Email to your client</h2>
        {
          clients.length > 0 ? (
            <ul class="care-sent">
              {deliveries.map((d) => (
                <li>
                  <span class="care-sent__who">
                    {d.email}
                    {d.role === 'owner' && ' (your copy)'}
                  </span>
                  <span class="small muted">
                    {statusWords[d.status] ?? d.status} · {formatDateTime(d.created_at)}
                    {d.role === 'client' && (d.opened_at ? ` · opened ${formatDateTime(d.opened_at)}` : d.live ? ' · not opened yet' : ' · link revoked')}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="small muted">Not emailed to anyone yet.</p>
          )
        }
        {
          emails ? (
            <form
              data-project-form
              data-endpoint="/api/care"
              data-pending="Sending…"
              data-confirm={`Email this report to ${pending.join(', ')}?`}
            >
              <input type="hidden" name="action" value="send" />
              {Object.entries(fields).map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}
              <div class="btn-row">
                <button class="btn btn--outline-ink" type="submit" disabled={!pending.length || !live || !canSendEmail()}>
                  Send now
                </button>
              </div>
              <p class="small muted">
                {!canSendEmail()
                  ? 'Email is not configured on this deployment.'
                  : !settings.recipients.length
                    ? 'Add your client’s addresses in the project’s care report settings first.'
                    : pending.length
                      ? `Goes to ${pending.length} recipient${pending.length === 1 ? '' : 's'} who ${pending.length === 1 ? 'has' : 'have'} not had it, each with their own link${settings.owner_copy ? ', and a copy to you' : ''}.`
                      : 'Every recipient has had this report. Each address gets a report once.'}{' '}
                Up to {CARE_LIMITS.sendProject.limit} sends a day per project. Replies go to {user.email}.
              </p>
              <p role="status" />
            </form>
          ) : (
            <p class="small muted">
              Emailing reports to clients, on the 1st or with Send now, is included on {CARE_EMAIL_PLANS}.{' '}
              <a href="/app/upgrade">Upgrade</a>
            </p>
          )
        }
        <nav class="link-row" aria-label="Care report settings">
          <a href={`/app/projects/${project.id}/care#care-settings`}>Recipients and schedule →</a>
        </nav>
      </section>

      <section class="project-panel">
        <details>
          <summary>Regenerate or delete</summary>
          {
            regenerable && reports && (
              <form data-project-form data-endpoint="/api/care" data-pending="Generating…" data-confirm="Replace this report with the figures as they are now? Its links stay the same and show the new version.">
                <input type="hidden" name="action" value="generate" />
                <input type="hidden" name="project_id" value={project.id} />
                <input type="hidden" name="period" value={report.period} />
                <p class="small muted">Reads the month again and replaces this manual report. Scheduled reports are never replaced.</p>
                <div class="btn-row">
                  <button class="btn btn--outline-ink" type="submit">
                    Regenerate {snapshot.period.label}
                  </button>
                </div>
                <p role="status" />
              </form>
            )
          }
          <form
            data-project-form
            data-endpoint="/api/care"
            class="danger-zone"
            data-pending="Deleting…"
            data-confirm="Delete this care report? Every link to it stops working. Monitors and their history are kept."
          >
            <span class="danger-zone__label">Danger zone</span>
            <input type="hidden" name="action" value="delete" />
            {Object.entries(fields).map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}
            <div class="btn-row">
              <button class="btn btn--danger-outline" type="submit">
                Delete report
              </button>
            </div>
            <p role="status" />
          </form>
        </details>
      </section>
    </div>
  </div>
  <ProjectForms />
</AppShell>
<style>
  .care-sent {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .care-sent li {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--line-2);
    overflow-wrap: anywhere;
  }
  .care-sent__who {
    font: 500 13px/1.4 var(--mono);
  }
</style>
