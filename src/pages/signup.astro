---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { PLANS } from '../lib/plans';

const next = Astro.url.searchParams.get('next') ?? '/app';
const url = Astro.url.searchParams.get('url') ?? '';
const initialError = Astro.url.searchParams.get('error') ?? '';
const target = url ? `/app?url=${encodeURIComponent(url)}` : next;
---

<Base title="Create your account">
  <div class="shell">
    <div style="padding: 24px 24px 32px; display: flex; flex-direction: column">
      <div style="padding: 8px 0 36px">
        <Logo />
      </div>

      <h1 class="h2">Create your account</h1>
      <p class="small muted" style="margin-top: 8px">
        Free plan, no card needed. {PLANS.free.quota} screenshots a month on us.
      </p>

      <div class="stack gap-12" style="margin-top: 28px">
        <button type="button" class="btn btn--white" data-oauth="Google">
          <span aria-hidden="true">🇬</span> Continue with Google
        </button>
        <button type="button" class="btn btn--white" data-oauth="GitHub">
          <span aria-hidden="true">⌘</span> Continue with GitHub
        </button>
      </div>

      <div class="divider"><span>or with email</span></div>

      <form id="signup-form" method="post" action="/api/auth/signup" class="stack gap-12" novalidate>
        <input type="hidden" name="next" value={target} />

        <div class="notice notice--error" id="form-error" hidden={!initialError}>{initialError}</div>

        <div class="field">
          <label class="field__label" for="name">Name</label>
          <input class="input" id="name" name="name" autocomplete="name" placeholder="Mia Torres" />
        </div>

        <div class="field">
          <label class="field__label" for="email">Email</label>
          <input
            class="input"
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@studio.co"
          />
        </div>

        <div class="field">
          <label class="field__label" for="password">Password</label>
          <div class="input-affix">
            <input
              class="input"
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="At least 8 characters"
            />
            <button type="button" class="input-affix__button" data-toggle-password="#password" aria-label="Show password">
              👁
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn--ink" style="margin-top: 8px">Create account</button>
      </form>

      <p class="small muted center" style="margin-top: 16px">
        Already have an account? <a href="/login" style="font-weight: 600">Log in</a>
      </p>
    </div>
  </div>
</Base>

<script>
  import { wireAuthForm, wirePasswordToggles, wireOauthPlaceholders } from '../scripts/auth';

  wireAuthForm('#signup-form', '#form-error');
  wirePasswordToggles();
  wireOauthPlaceholders('#form-error');
</script>
