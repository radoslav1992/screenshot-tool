---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';

export const prerender = true;
---

<Base title="Offline">
  <AiPage>
    <AiPageHead label="OFFLINE" meta="NO CONNECTION" aside="Waiting for a connection">
      <Fragment slot="title">You are <span>offline</span></Fragment>
      <p>Easy Screen Capture needs a connection to render captures. Your library will be here when you are back.</p>
      <div class="ai-actions">
        <button type="button" class="rr-btn-classic" onclick="location.reload()">
          Try again <span aria-hidden="true">↻</span>
        </button>
      </div>
    </AiPageHead>
  </AiPage>
</Base>
