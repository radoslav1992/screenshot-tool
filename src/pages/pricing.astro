---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PLANS, PLAN_ORDER } from '../lib/plans';

const user = Astro.locals.user;
const plans = PLAN_ORDER.map((id) => PLANS[id]);
---

<Base title="Pricing" description="Start free with 200 screenshots a month. Upgrade when you need more.">
  <div class="page">
    <SiteHeader user={user} />

    <section class="section">
      <div class="wrap">
        <div class="section__head section__head--center">
          <h1 class="section__title">Simple pricing</h1>
          <p class="section__sub">Start free. Upgrade when you need more shots.</p>

          <div class="switch" style="margin-top: 20px" role="group" aria-label="Billing period">
            <button type="button" data-period="monthly" aria-pressed="true">Monthly</button>
            <button type="button" data-period="yearly" aria-pressed="false">Yearly −20%</button>
          </div>
        </div>

        <div class="plan-grid">
          {
            plans.map((plan) => (
              <section class={plan.id === 'pro' ? 'plan plan--featured' : 'plan'}>
                {plan.id === 'pro' && <div class="plan__badge">MOST POPULAR</div>}

                <div class="plan__head">
                  <div class="plan__name">{plan.name}</div>
                  <div>
                    <span class="plan__price" data-price-for={plan.id} data-monthly={plan.priceMonthly} data-yearly={plan.priceYearly}>
                      ${plan.priceMonthly}
                    </span>
                    <span class="plan__per" data-per>/mo</span>
                  </div>
                </div>

                <p class="small" style={plan.id === 'pro' ? 'color: var(--dim); margin-top: 6px' : 'color: var(--muted); margin-top: 6px'}>
                  {plan.tagline}
                </p>

                <ul class="plan__features">
                  {plan.features.map((feature) => (
                    <li data-included={String(feature.included)} style="display: flex; gap: 8px; align-items: flex-start">
                      <Icon name={feature.included ? 'check' : 'alert'} size={15} />
                      <span>{feature.text}</span>
                    </li>
                  ))}
                </ul>

                <a
                  class={plan.id === 'pro' ? 'btn btn--lime' : 'btn btn--outline-ink'}
                  href={user ? '/app/account' : `/signup?plan=${plan.id}`}
                  style="margin-top: 20px"
                >
                  {user && user.plan === plan.id ? 'Current plan' : plan.cta}
                </a>
              </section>
            ))
          }
        </div>

        <p class="small muted center" style="margin-top: 26px">
          Need more? <a href="mailto:hello@screenify.app" style="font-weight: 600">Talk to us</a> about custom volume.
        </p>

        <div class="notice notice--info" style="max-width: 640px; margin: 22px auto 0">
          Checkout is not connected in this deployment — plans are switched manually. Wire up your payment provider in
          {' '}<span class="mono" style="font-size: 12px">src/lib/plans.ts</span>{' '}and the account routes when you are
          ready.
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-period]');
  const prices = document.querySelectorAll<HTMLElement>('[data-price-for]');
  const pers = document.querySelectorAll<HTMLElement>('[data-per]');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const yearly = button.dataset.period === 'yearly';
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));

      for (const price of prices) {
        const monthly = Number(price.dataset.monthly ?? 0);
        const annual = Number(price.dataset.yearly ?? 0);
        price.textContent = yearly ? `$${annual}` : `$${monthly}`;
      }
      for (const per of pers) per.textContent = yearly ? '/yr' : '/mo';
    });
  }
</script>
