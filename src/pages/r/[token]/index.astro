---
import Base from '../../../layouts/Base.astro';
import ReviewReport from '../../../components/ReviewReport.astro';
import ReportSignoff from '../../../components/ReportSignoff.astro';
import { sharedReport, reportCaptures } from '../../../lib/projects';
import { projectBranding } from '../../../lib/branding';
import { currentSignoff, signoffsReady } from '../../../lib/signoff';
import { approvalPinsMonitors } from '../../../lib/approval-baseline';
import '../../../styles/projects.css';
let data;
try {
  data = await sharedReport(Astro.params.token!, true);
} catch {
  return new Response('This review link is unavailable, expired or revoked.', {
    status: 404,
    headers: { 'cache-control': 'no-store' },
  });
}
const { project, report, expiresAt } = data;
/** Branding and sign-off are extras: if either cannot be read, the report still opens as it always has. */
const optional = <T,>(work: Promise<T>, what: string) =>
  work.catch((error) => {
    console.error(`[shared-report] ${what} unavailable`, error);
    return undefined;
  });
// Whether approving would pin monitor baselines is only asked when there is a sign-off form to say it beside.
const [captures, branding, [signoff, baselines]] = await Promise.all([
  reportCaptures(report, project.user_id),
  optional(projectBranding(project), 'branding'),
  optional(signoffsReady(), 'sign-off').then((ready) =>
    Promise.all([
      ready ? optional(currentSignoff(report.id), 'sign-off') : undefined,
      ready ? optional(approvalPinsMonitors(report, project), 'baseline note') : false,
    ]),
  ),
]);
const whiteLabel = !!branding && !branding.attribution;
Astro.response.headers.set('cache-control', 'private, no-store');
// With the sign-off form, same-origin rather than no-referrer: under no-referrer a
// form post sends `Origin: null`, which the route's origin check must refuse.
// Nothing on the page loads from or links to another site either way.
Astro.response.headers.set('referrer-policy', signoff ? 'same-origin' : 'no-referrer');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow, noarchive');
---

<Base
  title={whiteLabel ? (project.brand ? `${project.brand} · Website review` : 'Website review') : 'Shared website review'}
  plainTitle={whiteLabel}
  description="A private, time-limited website review."
>
  <main class="wrap shared-report">
    <p class="shared-report__notice">
      <strong>Shared review</strong> · Anyone with this link can view until {expiresAt.slice(0, 16)} UTC, unless revoked
      earlier.
    </p>
    <ReviewReport
      project={project}
      report={report}
      captures={captures}
      token={Astro.params.token}
      branding={branding}
      signoff={signoff}
    >
      {
        signoff && (
          <ReportSignoff
            token={Astro.params.token!}
            signoff={signoff}
            status={Astro.url.searchParams.get('signoff')}
            baselines={baselines === true}
          />
        )
      }
    </ReviewReport>
  </main>
</Base>
<style>
  .shared-report {
    padding-block: 32px 64px;
  }
  .shared-report__notice {
    padding: 14px 22px;
    border: 1px solid var(--line);
    border-bottom: 0;
    background: var(--lime-tint);
    font-size: 13px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .shared-report__notice strong {
    font-weight: 600;
  }
  @media (max-width: 767px) {
    .shared-report {
      padding-block: 16px 40px;
    }
    .shared-report__notice {
      padding: 14px;
    }
  }
  @media print {
    .shared-report {
      padding: 0;
      width: auto;
    }
  }
</style>
