---
import MonitorThreshold from '../../../components/MonitorThreshold.astro';
import MonitorRuleFields from '../../../components/MonitorRuleFields.astro';
import AppShell from '../../../layouts/AppShell.astro';
import MonitorBudget from '../../../components/MonitorBudget.astro';
import { canSendEmail } from '../../../lib/mailer';
import { getUsage } from '../../../lib/captures';
import { listWatches } from '../../../lib/watches';
import { FREQUENCIES, allowedFrequencies } from '../../../lib/plans';
import { watchSettingsReady } from '../../../lib/watch-settings';
import '../../../styles/projects.css';
const emailReady = canSendEmail();
const user = Astro.locals.user!;
const ready = await watchSettingsReady();
const [usage, watches] = await Promise.all([getUsage(user), listWatches(user.id)]);
const frequencies = FREQUENCIES.filter((f) => allowedFrequencies(user.plan).includes(f.id));
---

<AppShell title="Set up a monitor" tab="watches">
  <header class="appbar" slot="appbar">
    <a href="/app/watches">← Monitors</a>
    <span class="pill pill--quota">{usage.remaining.toLocaleString()} shots left</span>
  </header>
  <div class="app-wrap stack gap-20">
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">PREVIEW BEFORE YOU MONITOR</span>
        <h1>Keep the changes that matter.</h1>
        <p>Choose your page, quiet the distractions, then set your schedule.</p>
      </div>
    </div>
    {!ready ? (
      <p class="project-panel" role="status">Monitor setup is being prepared. Existing monitors remain available.</p>
    ) : !frequencies.length ? (
      <section class="project-panel stack gap-12">
        <p>Your plan does not include monitors.</p>
        <div class="btn-row">
          <a class="btn btn--lime" href="/app/upgrade">
            Upgrade to start monitoring
          </a>
        </div>
      </section>
    ) : (
      <form id="monitor-setup" class="stack gap-20">
        <section class="project-panel">
          <h2 class="section-heading"><span>[ 01 ]</span> Page &amp; capture area</h2>
          <div class="project-grid">
            <label>
              Page URL
              <input
                class="input"
                name="url"
                required
                value={Astro.url.searchParams.get('url') ?? ''}
                placeholder="https://example.com/pricing"
              />
            </label>
            <label>
              Monitor name
              <input class="input" name="label" maxlength="80" placeholder="Client pricing page" />
            </label>
            <label>
              Device
              <select class="input" name="device">
                <option value="desktop">Desktop</option>
                <option value="tablet">Tablet</option>
                <option value="mobile">Mobile</option>
              </select>
            </label>
            <label>
              Capture area
              <select class="input" name="mode">
                <option value="fullpage">Full page</option>
                <option value="visible">First screen</option>
              </select>
            </label>
          </div>
        </section>
        <section class="project-panel stack gap-12">
          <h2 class="section-heading"><span>[ 02 ]</span> Ignore noise &amp; preview</h2>
          <label>
            Hide elements by CSS selector
            <input class="input" name="hide" placeholder=".cookie-banner, .live-clock" maxlength="2000" />
          </label>
          <label>
            Ignore rectangular regions
            <input class="input" name="ignore_regions" placeholder="0,0,300,100; 1000,200,200,200" maxlength="600" />
          </label>
          <p class="small muted">
            Each rectangle is x, y, width, height in CSS pixels from the page’s top-left corner. Separate up to ten
            rectangles with semicolons. Regions are covered in the saved image. Ignore regions affect visual comparison
            only; underlying page text may still be collected. Mobile coordinates differ from desktop. Ads and consent
            dismissal are enabled.
          </p>
          <div class="btn-row">
            <button type="button" class="btn btn--outline-ink" id="monitor-preview">
              Preview baseline · 1 screenshot
            </button>
          </div>
          <p role="status" id="monitor-preview-status" aria-live="polite"></p>
          <p class="notice notice--error" id="monitor-preview-error" role="alert" hidden></p>
          <label>
            Draw on preview
            <select class="input" id="region-tool">
              <option value="watch_region">Watch this area only</option>
              <option value="ignore_regions">Ignore this area</option>
            </select>
          </label>
          <p class="small muted">
            Drag across the preview to select a rectangle. You can also enter coordinates in the fields. Ignored areas
            require a new preview before saving.
          </p>
          <div id="region-canvas" class="region-canvas">
            <img id="monitor-baseline" hidden alt="Monitor baseline preview" draggable="false" />
            <div id="region-outline" class="region-outline" hidden></div>
          </div>
          <input type="hidden" name="preview_token" id="preview-token" />
          <input type="hidden" name="format" value="png" />
        </section>
        <section class="project-panel stack gap-12">
          <h2 class="section-heading"><span>[ 03 ]</span> Rules, schedule &amp; destination</h2>
          <MonitorRuleFields />
          <MonitorThreshold />
          <label>
            Frequency
            <select class="input" name="frequency" id="frequency">
              {frequencies.map((f) => (
                <option value={f.id} selected={f.id === 'daily'}>
                  {f.label}
                </option>
              ))}
            </select>
          </label>
          <MonitorBudget schedules={watches} budget={usage} allowed={frequencies.map((f) => f.id)} />
          <label>
            Email alerts
            <select class="input" name="notify_email">
              <option value="1" disabled={!emailReady}>
                Send to my verified account email
              </option>
              <option value="0" selected={!emailReady}>
                Email off
              </option>
            </select>
          </label>
          {!emailReady && (
            <p class="notice notice--info">
              Email alerts are currently unavailable. You can still review changes here or use a webhook.
            </p>
          )}
          <label>
            Webhook URL (optional)
            <input class="input" type="url" name="webhook_url" placeholder="https://hooks.slack.com/…" />
          </label>
          <p class="small muted">
            The accepted preview becomes the baseline; the first scheduled comparison runs after the selected interval.
            Preview approval expires after 15 minutes. You can test notifications on the monitor’s detail page.
          </p>
          <div class="save-row">
            <button type="submit" class="btn btn--lime" id="monitor-save" disabled aria-describedby="monitor-save-hint">
              Use baseline &amp; start monitor
            </button>
            <p class="small muted" id="monitor-save-hint">Preview the baseline first (step 02) to enable this.</p>
          </div>
          <p role="status" id="monitor-save-status" aria-live="polite"></p>
          <p class="notice notice--error" id="monitor-save-error" role="alert" hidden></p>
        </section>
      </form>
    )}
  </div>
</AppShell>
<style>
  .region-canvas {
    position: relative;
    width: fit-content;
    max-width: 100%;
    touch-action: none;
  }
  .region-canvas img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .save-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .save-row .btn {
    width: auto;
  }
  .save-row p {
    flex: 1 1 200px;
  }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#monitor-setup');
  if (form) {
    const preview = document.querySelector<HTMLButtonElement>('#monitor-preview')!;
    const save = document.querySelector<HTMLButtonElement>('#monitor-save')!;
    const saveHint = document.querySelector<HTMLElement>('#monitor-save-hint')!;
    const token = document.querySelector<HTMLInputElement>('#preview-token')!;
    const previewStatus = document.querySelector<HTMLElement>('#monitor-preview-status')!;
    const previewError = document.querySelector<HTMLElement>('#monitor-preview-error')!;
    const saveStatus = document.querySelector<HTMLElement>('#monitor-save-status')!;
    const saveError = document.querySelector<HTMLElement>('#monitor-save-error')!;
    const tool = document.querySelector<HTMLSelectElement>('#region-tool')!;
    const ruleKind = form.querySelector<HTMLSelectElement>('[name="rule_kind"]');
    let busy = false;
    const canvas = document.querySelector<HTMLElement>('#region-canvas')!;
    const img = document.querySelector<HTMLImageElement>('#monitor-baseline')!;
    const outline = document.querySelector<HTMLElement>('#region-outline')!;
    let start: { x: number; y: number } | null = null;

    const showError = (box: HTMLElement, message: string) => {
      box.textContent = message;
      box.hidden = !message;
    };
    /** Keep the reason for a disabled final button next to it. */
    const setSaveReady = (ready: boolean) => {
      save.disabled = !ready;
      saveHint.textContent = ready
        ? 'Baseline approved. It becomes the first comparison; approval expires after 15 minutes.'
        : 'Preview the baseline first (step 02) to enable this.';
    };
    /** Only visual rules use a watched rectangle, so only they can draw one. */
    const syncRegionTool = () => {
      const visual = !ruleKind || ruleKind.value === 'visual';
      const watchOption = tool.querySelector<HTMLOptionElement>('option[value="watch_region"]')!;
      watchOption.disabled = !visual;
      if (!visual && tool.value === 'watch_region') tool.value = 'ignore_regions';
    };
    ruleKind?.addEventListener('change', syncRegionTool);
    syncRegionTool();

    const point = (event: PointerEvent) => {
      const rect = img.getBoundingClientRect();
      return {
        x: Math.max(0, Math.min(rect.width, event.clientX - rect.left)),
        y: Math.max(0, Math.min(rect.height, event.clientY - rect.top)),
      };
    };
    canvas.onpointerdown = (e) => {
      if (busy || img.hidden || !img.complete) return;
      start = point(e);
      canvas.setPointerCapture(e.pointerId);
      outline.hidden = false;
      outline.style.width = '0';
      outline.style.height = '0';
    };
    canvas.onpointermove = (e) => {
      if (!start) return;
      const end = point(e);
      Object.assign(outline.style, {
        left: Math.min(start.x, end.x) + 'px',
        top: Math.min(start.y, end.y) + 'px',
        width: Math.abs(end.x - start.x) + 'px',
        height: Math.abs(end.y - start.y) + 'px',
      });
    };
    canvas.onpointerup = (e) => {
      if (!start) return;
      const end = point(e),
        rect = img.getBoundingClientRect();
      const factor = img.naturalWidth / rect.width / Number(img.dataset.scale || 2);
      const values = [
        Math.floor(Math.min(start.x, end.x) * factor),
        Math.floor(Math.min(start.y, end.y) * factor),
        Math.floor(Math.abs(end.x - start.x) * factor),
        Math.floor(Math.abs(end.y - start.y) * factor),
      ];
      start = null;
      if (values[2] < 1 || values[3] < 1) return;
      const target = tool.value;
      const input = form.querySelector<HTMLInputElement>(`[name="${target}"]`)!;
      if (target === 'ignore_regions' && input.value.split(';').filter(Boolean).length >= 10) {
        showError(previewError, 'You can ignore at most ten regions. Remove one before drawing another.');
        return;
      }
      input.value =
        target === 'ignore_regions' && input.value.trim() ? input.value + ';' + values.join(',') : values.join(',');
      input.dispatchEvent(new Event('input', { bubbles: true }));
    };
    canvas.onpointercancel = () => {
      start = null;
      outline.hidden = true;
    };
    const invalidate = () => {
      if (!token.value) return;
      token.value = '';
      setSaveReady(false);
      previewStatus.textContent = 'Capture settings changed. Preview again before starting.';
    };
    for (const name of ['url', 'device', 'mode', 'hide', 'ignore_regions'])
      form.querySelector(`[name="${name}"]`)?.addEventListener('input', invalidate);
    async function submit(url: string) {
      const response = await fetch(url, { method: 'POST', body: new FormData(form!) });
      const result = (await response.json().catch(() => ({}))) as {
        error?: { message: string };
        preview_token?: string;
        capture?: { images: string[]; viewport: { scale: number } };
        id?: string;
      };
      if (!response.ok) throw new Error(result.error?.message ?? 'Request failed.');
      return result;
    }
    preview.onclick = async () => {
      if (busy || !form.reportValidity()) return;
      busy = true;
      preview.disabled = true;
      setSaveReady(false);
      token.value = '';
      showError(previewError, '');
      previewStatus.textContent = 'Capturing baseline…';
      const controls = Array.from(form.querySelectorAll('input,select')) as unknown as Array<
        HTMLInputElement | HTMLSelectElement
      >;
      // Serialize before disabling controls so the request includes their values.
      const pending = submit('/api/watch-preview');
      controls.forEach((c) => (c.disabled = true));
      try {
        const result = await pending;
        token.value = result.preview_token!;
        img.src = result.capture!.images[0];
        img.dataset.scale = String(result.capture!.viewport.scale);
        img.hidden = false;
        previewStatus.textContent = 'Baseline ready. One screenshot used. Review masks, then choose your schedule.';
      } catch (e) {
        previewStatus.textContent = '';
        showError(
          previewError,
          (e instanceof Error ? e.message : 'Preview failed.') +
            ' Check the library before retrying an interrupted request.',
        );
      } finally {
        controls.forEach((c) => (c.disabled = false));
        syncRegionTool();
        busy = false;
        preview.disabled = false;
        setSaveReady(!!token.value);
      }
    };
    form.onsubmit = async (e) => {
      e.preventDefault();
      if (busy || !token.value) return;
      busy = true;
      save.disabled = true;
      preview.disabled = true;
      showError(saveError, '');
      saveStatus.textContent = 'Creating monitor…';
      try {
        const result = await submit('/api/watches');
        location.assign(`/app/watches/${result.id}`);
      } catch (e) {
        saveStatus.textContent = '';
        showError(saveError, e instanceof Error ? e.message : 'Could not create the monitor. Try again.');
        busy = false;
        save.disabled = false;
        preview.disabled = false;
      }
    };
  }
</script>
