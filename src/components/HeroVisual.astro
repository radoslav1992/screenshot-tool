---
import Icon from './Icon.astro';
---

<figure class="product-demo" aria-label="Illustrated example of a website change comparison">
  <div class="demo-toolbar">
    <span class="demo-dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span>
      <Icon name="eye" size={14} /> Website monitor
    </span>
    <span class="demo-example">Example</span>
  </div>
  <div class="demo-content">
    <div class="demo-heading">
      <div>
        <span class="eyebrow">PRICING PAGE</span>
        <h3>
          A small change.
          <br />A useful heads-up.
        </h3>
      </div>
      <span class="demo-status">Change detected</span>
    </div>
    <div class="demo-comparison">
      <div class="demo-snapshot">
        <div class="demo-caption">
          BEFORE <span>Previous capture</span>
        </div>
        <div class="demo-site">
          <span class="demo-site-brand">
            acme<span>®</span>
          </span>
          <p>Room to do more.</p>
          <div class="demo-price">
            <small>PRO PLAN</small>
            <strong>
              $29<span>/mo</span>
            </strong>
            <span>For growing businesses</span>
            <div class="demo-site-cta">Get started</div>
          </div>
        </div>
      </div>
      <div class="demo-snapshot">
        <div class="demo-caption">
          AFTER <span>Latest capture</span>
        </div>
        <div class="demo-site">
          <span class="demo-site-brand">
            acme<span>®</span>
          </span>
          <p>Room to do more.</p>
          <div class="demo-price demo-price--changed">
            <small>PRO PLAN</small>
            <strong>
              $39<span>/mo</span>
            </strong>
            <span>For growing businesses</span>
            <div class="demo-site-cta">Get started</div>
          </div>
        </div>
      </div>
    </div>
    <div class="demo-note">
      <span class="demo-note-icon">
        <Icon name="check" size={18} />
      </span>
      <div>
        <strong>See what changed, with the evidence.</strong>
        <p>Scheduled checks · Before &amp; after · Email alerts</p>
      </div>
    </div>
  </div>
</figure>
