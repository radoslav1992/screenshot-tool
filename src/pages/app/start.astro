---
import { env } from 'cloudflare:workers';
import AppShell from '../../layouts/AppShell.astro';
import { projectsReady, listProjects, ownProject } from '../../lib/projects';
import { getUsage } from '../../lib/captures';
import { fastChecksReady } from '../../lib/fast-checks';
import '../../styles/projects.css';
const user = Astro.locals.user!;
const [ready, smart] = await Promise.all([projectsReady(), fastChecksReady()]);
const projects = ready ? await listProjects(user.id) : [];
const requested = Astro.url.searchParams.get('project');
let project = projects[0];
if (requested) {
  try {
    project = await ownProject(user.id, requested);
  } catch {
    return new Response('Project not found', { status: 404 });
  }
}
const usage = await getUsage(user);
const counts = project
  ? await env.DB.prepare(
      `SELECT
 (SELECT COUNT(*) FROM project_captures pc JOIN captures c ON c.id=pc.capture_id WHERE pc.project_id=?1 AND c.user_id=?2 AND c.status='done') captures,
 (SELECT COUNT(*) FROM review_reports WHERE project_id=?1) reports,
 (SELECT COUNT(*) FROM project_watches pw JOIN watches w ON w.id=pw.watch_id WHERE pw.project_id=?1 AND w.user_id=?2) monitors`,
    )
      .bind(project.id, user.id)
      .first<{ captures: number; reports: number; monitors: number }>()
  : null;
const steps = [
  {
    done: !!project,
    title: 'Give your client work a home',
    text: 'Create a project with a client name and your report brand.',
    href: project ? `/app/projects/${project.id}` : '/app/projects',
    cta: project ? 'Open project' : 'Create your first project',
    doneCta: 'Open project',
  },
  {
    done: (counts?.captures ?? 0) > 0,
    title: 'Capture your first page',
    text: 'Preview a URL list and its cost. Start with one page, or choose desktop + mobile for two screenshots.',
    href: project ? `/app/batch?project=${project.id}` : '/app/projects',
    cta: 'Capture a page',
    doneCta: 'Capture more',
  },
  {
    done: !!(counts?.reports || counts?.monitors),
    title: 'Turn the capture into useful work',
    text: 'Create a before-and-after report from two retained images, or set up a monitor and attach it to this project.',
    href: project ? `/app/projects/${project.id}` : '/app/projects',
    cta: 'Create a report or attach a monitor',
    doneCta: 'Open reports',
  },
];
const completed = steps.filter((s) => s.done).length;
// Completed steps collapse to one line each; only open steps keep a panel and a button.
const numbered = steps.map((step, index) => ({ step, number: index + 1 }));
const done = numbered.filter(({ step }) => step.done);
const pending = numbered.filter(({ step }) => !step.done);
---
<AppShell title="Get started" tab="projects">
  <header class="appbar" slot="appbar">
    <a href="/app">← Capture workspace</a>
    <span class="pill pill--quota">{usage.remaining.toLocaleString()} shots left</span>
  </header>
  <div class="app-wrap stack gap-20">
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">YOUR FIRST CLIENT WORKFLOW</span>
        <h1>One page. A useful result.</h1>
        <p>Start with a project, make a capture, then use it in a report or monitor.</p>
      </div>
    </div>
    <nav class="link-row" aria-label="Other ways to start">
      <a href="/sample-report">See a sample report →</a>
      <a href="/app">Go straight to capture →</a>
    </nav>
    {!ready ? (
      <p class="project-panel">Project setup is still pending. You can capture pages and view the sample report now.</p>
    ) : (
      <>
        {projects.length > 0 && (
          <form method="get" class="project-form start-project">
            <label>
              Continue a project
              <select class="input" name="project">
                {projects.map((p) => (
                  <option value={p.id} selected={p.id === project?.id}>
                    {p.name}
                  </option>
                ))}
              </select>
            </label>
            <button class="btn btn--outline" type="submit">
              Show project progress
            </button>
          </form>
        )}
        <p role="status">
          <strong>
            {completed} of {steps.length} steps complete
          </strong>
          {project ? ` for ${project.name}` : ''}. Progress reflects your retained project work.
        </p>
        {done.length > 0 && (
          <ol class="start-done" aria-label="Completed steps">
            {done.map(({ step, number }) => (
              <li>
                <span class="start-done__mark" aria-hidden="true">✓</span>
                <span>
                  <span class="sr-only">Step {number}, complete: </span>
                  {step.title}
                </span>
                <a href={step.href}>{step.doneCta} →</a>
              </li>
            ))}
          </ol>
        )}
        {pending.length > 0 ? (
          <div class="project-grid">
            {pending.map(({ step, number }, index) => (
              <section class="project-panel stack gap-12">
                <h2 class="section-heading">
                  <span>[ Step {String(number).padStart(2, '0')} ]</span> {step.title}
                </h2>
                <p>{step.text}</p>
                <div class="btn-row">
                  {/* Only the next step is the primary action. */}
                  <a class={index === 0 ? 'btn btn--lime' : 'btn btn--outline'} href={step.href}>
                    {step.cta}
                  </a>
                </div>
              </section>
            ))}
          </div>
        ) : (
          <section class="project-panel stack gap-12">
            <h2 class="section-heading">
              <span>[ Done ]</span> Your first client workflow is set up
            </h2>
            <p>Keep adding captures, reports and monitors from the project workspace.</p>
            {project && (
              <div class="btn-row">
                <a class="btn btn--lime" href={`/app/projects/${project.id}`}>
                  Open {project.name}
                </a>
              </div>
            )}
          </section>
        )}
        {project && (
          <section class="project-panel stack gap-12">
            <h2>Prefer ongoing monitoring?</h2>
            <p>
              A baseline preview uses one screenshot. Daily checks use about 30 more per month; hourly checks use about
              720.{smart ? ' Text, price, element and SEO monitors read the page first and use one only when something changes. ' : ' '}
              Set a schedule within your allowance, then attach the monitor from your project.
            </p>
            <p class="link-row">
              <a href="/app/watches/setup">Set up a monitor →</a>
            </p>
          </section>
        )}
      </>
    )}
    <section class="project-panel stack gap-12">
      <h2>Know what counts</h2>
      <p>
        Each generated image uses one screenshot. Desktop + mobile uses two; scroll series uses one per frame. Creating
        a report from existing captures uses none. PDF report export is available on paid plans.
      </p>
      <p>Source images keep their existing retention period. Creating a report or sharing a link does not extend it.</p>
      <p class="link-row">
        <a href="/pricing">Compare plans and retention →</a>
      </p>
    </section>
  </div>
</AppShell>

<style>
  .start-project {
    max-width: 520px;
  }
  .start-project .btn {
    width: auto;
    justify-self: start;
  }
  .start-done {
    display: grid;
    border: 1px solid var(--line);
    background: white;
  }
  .start-done li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    min-height: 56px;
    border-bottom: 1px solid var(--line-3);
    font-size: 14px;
  }
  .start-done li:last-child {
    border-bottom: 0;
  }
  .start-done__mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--theme);
    color: var(--ink);
    font-size: 12px;
  }
  .start-done a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    font-weight: 600;
  }
</style>
