---
import Icon from './Icon.astro';

/**
 * A password input with a show/hide toggle. Wired by `wirePasswordToggles()`
 * in scripts/auth.ts. The toggle is a full 44px square so it is easy to hit
 * with a thumb; the input keeps room on its right so text never runs under it.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  autocomplete: 'current-password' | 'new-password';
  placeholder?: string;
  minlength?: number;
  required?: boolean;
}

const { id, name, label, autocomplete, placeholder, minlength, required = true } = Astro.props;
---

<div class="field">
  <label class="field__label" for={id}>{label}</label>
  <div class="input-affix">
    <input
      class="input"
      id={id}
      name={name}
      type="password"
      required={required}
      minlength={minlength}
      autocomplete={autocomplete}
      placeholder={placeholder}
    />
    <button
      type="button"
      class="input-affix__button"
      data-toggle-password={`#${id}`}
      data-showing="false"
      aria-label="Show password"
      aria-controls={id}
    >
      <Icon name="eye" size={18} class="pw-on" />
      <Icon name="eye-off" size={18} class="pw-off" />
    </button>
  </div>
</div>

<style>
  .input {
    padding-right: 52px;
  }
  .input-affix__button {
    right: 2px;
    width: 44px;
    height: 44px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
