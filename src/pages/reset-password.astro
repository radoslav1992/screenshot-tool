---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import PasswordField from '../components/PasswordField.astro';
import { PASSWORD_MIN_LENGTH } from '../lib/auth';
import { findResetUser } from '../lib/password-reset';
import { takeFlash } from '../lib/flash';

// Looking the link up does not use it, so a mail scanner opening it first does
// no harm. The token stays out of the Referer header and out of caches.
const token = (Astro.url.searchParams.get('token') ?? '').trim();
// Left by the API when the form post failed; never read from the URL.
const error = takeFlash(Astro.cookies, Astro.url.pathname);
const user = token ? await findResetUser(token).catch(() => null) : null;
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');
---

<Base title={user ? 'Choose a new password' : 'Link not valid'} description="Choose a new Easy Screen Capture password.">
  <AiPage user={Astro.locals.user}>
    <AiPageHead
      label="ACCOUNT / PASSWORD"
      meta={user ? 'NEW PASSWORD' : 'LINK NOT VALID'}
      aside={user ? 'Password reset' : 'Reset link'}
    >
      {
        error && (
          <div slot="notice" class="ai-strip ai-strip--error" role="alert">
            {error}
          </div>
        )
      }
      <Fragment slot="title">
        {
          user ? (
            <>
              Choose a new <span>password</span>
            </>
          ) : (
            <>
              That link did <span>not work</span>
            </>
          )
        }
      </Fragment>

      {
        user ? (
          <>
            <p>
              For <strong>{user.email}</strong>. Saving it signs out every device signed in to this account, including
              the iOS app, and signs you in here.
            </p>
            <form class="reset-form" method="post" action="/api/auth/reset-password">
              <input type="hidden" name="token" value={token} />
              <input type="text" name="username" value={user.email} autocomplete="username" hidden />
              <PasswordField
                id="password"
                name="password"
                label="New password"
                autocomplete="new-password"
                placeholder={`At least ${PASSWORD_MIN_LENGTH} characters`}
                minlength={PASSWORD_MIN_LENGTH}
              />
              <button type="submit" class="rr-btn-classic">
                Save new password <span aria-hidden="true">↗</span>
              </button>
            </form>
          </>
        ) : (
          <>
            <p>
              Reset links work once and expire after an hour. Changing your password any other way also retires
              them. Ask for a fresh one and use the newest email.
            </p>
            <div class="ai-actions">
              <a class="rr-btn-classic" href="/forgot-password">
                Send a new link <span aria-hidden="true">↗</span>
              </a>
              <a class="rr-btn-classic ai-btn-outline" href="/login">
                Log in <span aria-hidden="true">↗</span>
              </a>
            </div>
          </>
        )
      }
    </AiPageHead>
  </AiPage>
</Base>

<style>
  .reset-form {
    display: grid;
    gap: 12px;
    max-width: 440px;
  }
  .reset-form .rr-btn-classic {
    margin-top: 6px;
  }
</style>

<script>
  import { wirePasswordToggles } from '../scripts/auth';

  wirePasswordToggles();
</script>
