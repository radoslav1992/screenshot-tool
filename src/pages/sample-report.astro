---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/adon/ai-source.css';
import '../styles/adon/ai-landing.css';
const user = Astro.locals.user;
const startHref = user ? '/app/start' : '/signup?next=%2Fapp%2Fstart';
const notes = [
  'The headline now names the service and audience.',
  'The booking action is visible in the first screen.',
  'Before approval, test the booking form and check the mobile layout.',
];
---

<Base
  title="Sample client review report"
  bodyClass="body-ai-agency"
  description="See how a before-and-after website report explains a change and gives clients clear next steps."
>
  <a class="adon-skip-link" href="#main-content">
    Skip to content
  </a>
  <div class="page ai-landing">
    <SiteHeader user={user} />
    <main id="main-content" class="ai-grid wrap sample-report">
      <section class="sr-intro" aria-labelledby="report-title">
        <div class="ai-hero-label">
          <span>[ SAMPLE REPORT ]</span>
          <span>CLIENT WEBSITE REVIEW / ILLUSTRATIVE</span>
        </div>
        <p class="sr-notice">
          <strong>Illustrative example</strong> · Fictional client and page layouts. These are not captured websites or
          measured results.
        </p>
        <header class="sr-header">
          <span class="ai-eyebrow">NORTH STUDIO · CLIENT WEBSITE REVIEW</span>
          <h1 id="report-title" data-adon-title>
            A clearer path
            <br />
            <span>to booking.</span>
          </h1>
        </header>
        <dl class="sr-facts">
          <div>
            <dt>EXAMPLE CLIENT</dt>
            <dd>Fieldwork Studio</dd>
          </div>
          <div>
            <dt>REVIEW</dt>
            <dd>Desktop homepage</dd>
          </div>
          <div>
            <dt>COMPARISON</dt>
            <dd>10 → 11 Sep 2026</dd>
          </div>
          <div>
            <dt>STATUS</dt>
            <dd><span class="sr-dot" aria-hidden="true"></span>Needs review</dd>
          </div>
        </dl>
      </section>

      <section class="sr-changes" aria-labelledby="what-changed">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ 01 / WHAT CHANGED ]</span>
          <div>
            <h2 id="what-changed" data-adon-title>What changed</h2>
            <p class="sr-lede">
              The revised page puts the service and booking action first. The review notes explain what to check
              before approving the update.
            </p>
          </div>
        </div>
        <div class="sr-compare">
          <figure class="sr-shot">
            <figcaption>
              <div class="sr-shot-label">
                <span>[ BEFORE ]</span>
                <span>BASELINE / 01</span>
              </div>
              <h3>Before · baseline</h3>
              <p class="sr-meta">
                Illustrative desktop layout · example.com · 1440 × 900 CSS px
                <br />
                Example baseline: 10 September 2026, 09:00 UTC
              </p>
            </figcaption>
            <div class="sr-stage" data-adon-reveal>
              <div
                class="sample-frame before"
                role="img"
                aria-label="Fictional baseline homepage with a vague headline and a low-contrast contact button"
              >
                <div class="sample-bar" aria-hidden="true">
                  <span class="adon-preview-dots"><i></i><i></i><i></i></span>
                  <span>example.com / home</span>
                  <span>↗</span>
                </div>
                <div class="sample-nav">
                  FIELDWORK <small>About · Work · Contact</small>
                </div>
                <div class="sample-body">
                  <span>WELCOME TO OUR WEBSITE</span>
                  <h4>
                    Ideas for
                    <br />
                    what comes next.
                  </h4>
                  <p>We bring creativity and experience to every project.</p>
                  <span class="sample-button">Learn more</span>
                </div>
              </div>
            </div>
          </figure>
          <figure class="sr-shot sr-shot--after">
            <figcaption>
              <div class="sr-shot-label">
                <span>[ AFTER ]</span>
                <span>READY FOR REVIEW / 02</span>
              </div>
              <h3>After · ready for review</h3>
              <p class="sr-meta">
                Illustrative desktop layout · example.com · 1440 × 900 CSS px
                <br />
                Example update: 11 September 2026, 14:00 UTC
              </p>
            </figcaption>
            <div class="sr-stage" data-adon-reveal>
              <div
                class="sample-frame after"
                role="img"
                aria-label="Fictional updated homepage with a specific service headline and a prominent booking button"
              >
                <div class="sample-bar" aria-hidden="true">
                  <span class="adon-preview-dots"><i></i><i></i><i></i></span>
                  <span>example.com / home</span>
                  <span>↗</span>
                </div>
                <div class="sample-nav">
                  FIELDWORK <small>Services · Work · Book a call</small>
                </div>
                <div class="sample-body">
                  <span>WEB DESIGN FOR SMALL BUSINESSES</span>
                  <h4>
                    Your next client
                    <br />
                    starts here.
                  </h4>
                  <p>A clear website. A simple way to get in touch.</p>
                  <span class="sample-button">Book a discovery call ↗</span>
                </div>
              </div>
            </div>
          </figure>
        </div>
      </section>

      <section class="sr-notes" aria-labelledby="review-notes">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ 02 / REVIEW NOTES ]</span>
          <h2 id="review-notes" data-adon-title>Review notes</h2>
        </div>
        <ol class="sr-note-list">
          {
            notes.map((note, index) => (
              <li>
                <span aria-hidden="true">[ 0{index + 1} ]</span>
                {note}
              </li>
            ))
          }
        </ol>
        <div class="sr-status">
          <span class="sr-status-badge">
            <span class="sr-dot" aria-hidden="true"></span>
            NEEDS REVIEW
          </span>
          <p>
            <strong>Review status: Needs review.</strong> Screenshots document appearance; they do not prove the form
            works or that conversion improved.
          </p>
        </div>
      </section>

      <section class="sr-cta" aria-labelledby="make-it-yours">
        <div class="ai-section-head">
          <span class="section-subtitle-5">[ YOUR NEXT MOVE ]</span>
          <div>
            <h2 id="make-it-yours" data-adon-title>
              Make this
              <br />
              <span class="ai-orange-text">workflow yours.</span>
            </h2>
            <p class="sr-lede">
              Create a project, capture a baseline and an updated page, then add your notes. Share a web report with an
              expiring link or export a branded PDF on a paid plan.
            </p>
            <div class="sr-actions">
              <a class="rr-btn-classic" href={startHref}>
                Create your first report <span aria-hidden="true">↗</span>
              </a>
              <a class="rr-btn-classic sr-btn-outline" href="/pricing">
                Compare plans <span aria-hidden="true">↗</span>
              </a>
            </div>
            <p class="sr-fineprint">
              This example uses no screenshot quota. Real reports keep their source images’ original retention period.
            </p>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</Base>
<style>
  .sr-notice {
    padding: 14px 22px;
    border-bottom: 1px solid var(--line);
    background: var(--lime-tint);
    font-size: 13px;
    line-height: 1.6;
  }
  .sr-header {
    padding: 60px 25px 55px;
  }
  .sr-header h1 {
    font: 300 clamp(52px, 7.2vw, 116px) / 0.9 var(--font_astronebula);
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin-top: 28px;
  }
  .sr-header h1 > span {
    color: var(--theme);
  }
  .sr-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .sr-facts > div {
    min-width: 0;
    border-right: 1px solid var(--line);
  }
  .sr-facts > div:last-child {
    border-right: 0;
  }
  .sr-facts dt {
    font: 9px/1.4 var(--mono);
    padding: 15px 20px;
    border-bottom: 1px solid var(--line);
  }
  .sr-facts dd {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 22px 20px 26px;
    font-size: clamp(18px, 1.7vw, 24px);
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }
  .sr-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--theme);
  }
  .sr-lede {
    font-size: 16px;
    line-height: 1.8;
    max-width: 58ch;
    margin-top: 28px;
  }
  .sr-compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--paper);
  }
  .sr-shot {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
  }
  .sr-shot:last-child {
    border-right: 0;
  }
  .sr-shot figcaption {
    padding: 0 0 22px;
  }
  .sr-shot-label {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 15px 25px;
    border-bottom: 1px solid var(--line);
    font: 9px/1.4 var(--mono);
  }
  .sr-shot--after .sr-shot-label {
    background: var(--theme);
  }
  .sr-shot h3 {
    font: 300 clamp(26px, 2.6vw, 37px) / 1 var(--font_astronebula);
    text-transform: uppercase;
    padding: 30px 25px 0;
  }
  .sr-meta {
    padding: 14px 25px 0;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .sr-stage {
    flex: 1;
    margin: 0 25px 25px;
    padding: clamp(18px, 3vw, 40px);
    background-color: #e5e5e1;
    background-image: radial-gradient(#1111111a 0.8px, transparent 0.8px);
    background-size: 10px 10px;
  }
  .sample-frame {
    overflow: hidden;
    min-height: 350px;
    box-shadow:
      12px 25px 0 #11111112,
      0 35px 60px #68321e1f;
  }
  .sample-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px;
    border-bottom: 1px solid #11111120;
    background: white;
    font: 8px var(--mono);
    color: #666;
  }
  .sample-nav {
    padding: 20px;
    font-size: 15px;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    border-bottom: 1px solid #d8d3c8;
  }
  .sample-nav small {
    font-size: 10px;
    font-weight: 400;
  }
  .sample-body {
    padding: 32px 24px;
  }
  .sample-body > span:first-child {
    font: 9px var(--mono);
    letter-spacing: 0.08em;
  }
  .sample-body h4 {
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.05;
    margin: 20px 0;
  }
  .sample-body p {
    font-size: 14px;
    margin-bottom: 24px;
  }
  .sample-button {
    display: inline-block;
    padding: 12px 15px;
    font-size: 12px;
  }
  .before {
    background: #eeeae2;
    color: #615e56;
  }
  .before .sample-button {
    border: 1px solid #8d887c;
  }
  .after {
    background-color: #1b1c1c;
    background-image:
      linear-gradient(90deg, #ffffff08 1px, transparent 1px), linear-gradient(#ffffff08 1px, transparent 1px);
    background-size: 40px 40px;
    color: white;
  }
  .after .sample-nav {
    border-color: #ffffff26;
  }
  .after .sample-button {
    background: var(--theme);
    color: var(--ink);
    font-weight: 600;
    text-transform: uppercase;
  }
  .sr-note-list {
    margin: 0 0 0 25%;
    padding: 0;
    list-style: none;
    background: var(--paper);
  }
  .sr-note-list li {
    display: flex;
    gap: 25px;
    align-items: baseline;
    padding: 27px 25px;
    border-bottom: 1px solid var(--line);
    font-size: 19px;
    line-height: 1.4;
  }
  .sr-note-list li > span {
    font: 10px var(--mono);
    white-space: nowrap;
  }
  .sr-status {
    display: grid;
    grid-template-columns: 1fr 3fr;
    background: var(--paper);
  }
  .sr-status-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 27px 20px;
    border-right: 1px solid var(--line);
    font: 10px var(--mono);
  }
  .sr-status p {
    padding: 27px 25px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 75ch;
  }
  .sr-status strong {
    color: var(--ink);
    font-weight: 500;
  }
  .sr-cta .ai-section-head {
    border-bottom: 0;
  }
  .sr-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 35px;
  }
  .sr-actions .rr-btn-classic {
    width: auto;
    min-width: 280px;
  }
  .ai-landing .sr-btn-outline {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .ai-landing .sr-btn-outline:hover {
    background: var(--ink);
    color: white;
  }
  .sr-fineprint {
    margin-top: 22px;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .sr-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sr-facts > div:nth-child(2) {
      border-right: 0;
    }
    .sr-facts > div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
    .sr-compare {
      grid-template-columns: 1fr;
    }
    .sr-shot {
      border-right: 0;
    }
    .sr-shot + .sr-shot {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 767px) {
    .sr-notice {
      padding: 14px;
    }
    .sr-header {
      padding: 36px 15px;
    }
    .sr-header h1 {
      font-size: 11vw;
      line-height: 0.95;
    }
    .sr-facts dt {
      padding: 12px;
      font-size: 8px;
    }
    .sr-facts dd {
      padding: 16px 12px 20px;
      font-size: 17px;
    }
    .sr-shot-label {
      padding: 12px 15px;
      font-size: 8px;
    }
    .sr-shot h3 {
      padding: 24px 15px 0;
    }
    .sr-meta {
      padding-inline: 15px;
    }
    .sr-stage {
      margin: 0 15px 15px;
    }
    .sample-frame {
      min-height: 0;
    }
    .sample-nav {
      flex-wrap: wrap;
    }
    .sr-note-list {
      margin-left: 0;
    }
    .sr-note-list li {
      gap: 12px;
      padding: 23px 15px;
      font-size: 16px;
    }
    .sr-note-list li > span {
      font-size: 8px;
    }
    .sr-status {
      grid-template-columns: 1fr;
    }
    .sr-status-badge {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 15px;
    }
    .sr-status p {
      padding: 20px 15px 24px;
    }
    .sr-actions .rr-btn-classic {
      width: 100%;
      min-width: 0;
    }
  }
</style>
