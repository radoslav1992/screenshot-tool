---
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import Mark from '../../components/Mark.astro';
import { DEVICE_LIST, FORMATS, FRAME_LIST, MODES } from '../../lib/capture-options';
import { getUsage } from '../../lib/captures';
import { cheapestPlanWith, getPlan } from '../../lib/plans';
import { isVerified } from '../../lib/verification';

const user = Astro.locals.user!;
const [usage, verified] = await Promise.all([getUsage(user), isVerified(user.id)]);
const plan = getPlan(user.plan);

// Name the plan someone actually has to buy, rather than a hard-coded tier.
const sizePlan = cheapestPlanWith((entry) => entry.customViewport);
const pdfPlan = cheapestPlanWith((entry) => entry.formats.includes('pdf'));
const cleanPlan = cheapestPlanWith((entry) => !entry.watermark);
const prefillUrl = Astro.url.searchParams.get('url') ?? '';
const initials = (user.name || user.email).trim().charAt(0).toUpperCase();
---

<AppShell title="New capture" tab="capture">
  <header class="appbar" slot="appbar">
    <div class="logo">
      <span class="logo__mark"><Mark size={16} /></span>
      <span class="appbar__title">New capture</span>
    </div>
    <a class="avatar" href="/app/account" aria-label="Account">{initials}</a>
  </header>

  <form id="capture-form" class="app-wrap app-split stack gap-20">
    {
      !verified && (
        <div class="notice notice--info" id="verify-banner">
          <strong>Confirm your email to start capturing.</strong> We sent a link to {user.email}.
          <button type="button" id="resend-verification" style="font-weight: 600; color: var(--green); margin-left: 4px">
            Send it again
          </button>
          <span id="resend-state" class="xs muted-2" />
        </div>
      )
    }

    <div class="notice notice--error" id="capture-error" hidden></div>

    <div class="app-col">
    <div class="field">
      <label class="field__label" for="url">Page URL</label>
      <div class="input-affix">
        <input
          class="input input--mono"
          id="url"
          name="url"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          required
          placeholder="stripe.com/pricing"
          value={prefillUrl}
        />
        <span class="input-affix__end" id="url-state" hidden>✓ reachable</span>
      </div>
    </div>

    <div>
      <div class="field__label" style="margin-bottom: 8px">Device</div>
      <div class="device-grid">
        {
          DEVICE_LIST.map((device, index) => (
            <label class="device">
              <input type="radio" name="device" value={device.id} checked={index === 0} />
              <div class="device__icon"><Icon name={device.icon} size={20} /></div>
              <div class="device__name">{device.label}</div>
              <div class="device__size">{device.width}×{device.height}</div>
            </label>
          ))
        }
      </div>

      <div style="margin-top: 14px">
        <div class="row-between" style="margin-bottom: 8px">
          <div class="field__label">Or a ready-made size</div>
          <span class="xs muted-2">exact pixels, no cropping</span>
        </div>
        <div class="frames" id="frame-chips">
          {
            FRAME_LIST.map((frame) => (
              <label class="chip chip--frame">
                <input type="radio" name="device" value={frame.id} />
                <Icon name={frame.icon} size={13} />
                <span>{frame.label}</span>
                <span class="chip__size mono">{frame.output}</span>
              </label>
            ))
          }
        </div>
      </div>

      <p class="xs muted" style="margin-top: 10px">
        Custom size?
        <button type="button" id="custom-toggle" style="font-weight: 600; color: var(--green)">
          Set width × height
        </button>
      </p>

      <div id="custom-size" class="stack gap-8" hidden style="margin-top: 8px">
        {
          plan.customViewport ? null : (
            <div class="notice notice--info">
              Custom viewports start on {sizePlan.name}, ${sizePlan.priceMonthly}/mo. <a href="/pricing">See plans</a>
            </div>
          )
        }
        <div style="display: flex; gap: 8px">
          <div class="field" style="flex: 1">
            <label class="field__label" for="width">Width</label>
            <input class="input input--mono" id="width" name="width" type="number" min="240" max="3840" placeholder="1280" disabled={!plan.customViewport} />
          </div>
          <div class="field" style="flex: 1">
            <label class="field__label" for="height">Height</label>
            <input class="input input--mono" id="height" name="height" type="number" min="240" max="4320" placeholder="800" disabled={!plan.customViewport} />
          </div>
        </div>
      </div>
    </div>
    </div>

    <div class="app-col">
    <div>
      <div class="field__label" style="margin-bottom: 8px">Capture mode</div>
      <div class="mode-list">
        {
          MODES.map((mode) => (
            <label class="mode">
              <input type="radio" name="mode" value={mode.id} checked={mode.id === 'fullpage'} />
              <span class="mode__dot" aria-hidden="true" />
              <span class="mode__body">
                <span class="mode__name" style="display: block">{mode.label}</span>
                <span class="mode__hint">{mode.hint}</span>
              </span>
              <span class="mode__icon"><Icon name={mode.icon} size={20} /></span>
            </label>
          ))
        }
      </div>
    </div>

    <details class="card card--pad" style="padding: 14px 16px">
      <summary class="label" style="cursor: pointer">More options</summary>
      <div class="stack gap-12" style="margin-top: 14px">
        <div class="field">
          <label class="field__label" for="format">Format</label>
          <select class="input" id="format" name="format">
            {
              FORMATS.map((format) => (
                <option value={format} disabled={!plan.formats.includes(format)}>
                  {format.toUpperCase()}
                  {plan.formats.includes(format) ? '' : ` — ${pdfPlan.name}`}
                </option>
              ))
            }
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="delay">Wait before capture (ms)</label>
          <input class="input input--mono" id="delay" name="delay" type="number" min="0" max="15000" step="250" value="0" />
        </div>

        <label class="row-between" style="cursor: pointer">
          <span class="label">Block ads &amp; trackers</span>
          <input type="checkbox" name="block_ads" value="1" checked />
        </label>

        <label class="row-between" style="cursor: pointer">
          <span class="label">Prefer dark mode</span>
          <input type="checkbox" name="dark_mode" value="1" />
        </label>

        <label class="row-between" style="cursor: pointer">
          <span class="label">Click through cookie banners</span>
          <input type="checkbox" name="dismiss_consent" value="1" checked />
        </label>

        <div class="field">
          <div class="field__label" style="margin-bottom: 8px">Also capture at</div>
          <div class="chips chips--wrap">
            {
              DEVICE_LIST.map((device) => (
                <label class="chip chip--check">
                  <input type="checkbox" name="sizes" value={device.id} />
                  <span>{device.label}</span>
                </label>
              ))
            }
          </div>
          <p class="xs muted-2" style="margin-top: 6px">
            One page load, one file per size. Each counts as a screenshot.
          </p>
        </div>
      </div>
    </details>

    <details class="card card--pad" style="padding: 14px 16px">
      <summary class="label" style="cursor: pointer">Clean up the page</summary>
      <div class="stack gap-12" style="margin-top: 14px">
        <div class="field">
          <label class="field__label" for="hide">Hide elements</label>
          <input class="input input--mono" id="hide" name="hide" placeholder=".cookie-banner, #chat-widget" />
          <p class="xs muted-2" style="margin-top: 6px">CSS selectors, comma separated.</p>
        </div>

        <div class="field">
          <label class="field__label" for="blur">Blur elements</label>
          <input class="input input--mono" id="blur" name="blur" placeholder=".customer-name" />
        </div>

        <label class="row-between" style="cursor: pointer">
          <span>
            <span class="label" style="display: block">Cover personal details</span>
            <span class="xs muted-2">Emails, phone numbers, card numbers and IBANs</span>
          </span>
          <input type="checkbox" name="redact_pii" value="1" />
        </label>

        <div class="field">
          <label class="field__label" for="actions">Do this first</label>
          <input
            class="input input--mono"
            id="actions"
            name="actions"
            placeholder="click:.accept; wait_for:#main"
          />
          <p class="xs muted-2" style="margin-top: 6px">
            Steps before the shot: <span class="mono">click</span>, <span class="mono">wait_for</span>,
            {' '}<span class="mono">wait</span>, <span class="mono">scroll_to</span>, <span class="mono">type</span>.
          </p>
        </div>
      </div>
    </details>

    <button type="submit" class="btn btn--ink" id="capture-submit">
      <Icon name="camera" size={18} /> Capture screenshot
    </button>

    <p class="xs center" style="color: var(--muted-2); margin-top: -10px" id="quota-line">
      {
        usage.remaining > 0
          ? `Uses 1 of ${usage.remaining.toLocaleString()} shots left this month`
          : `No shots left this month — resets ${usage.renewsOn}`
      }
    </p>

    {
      plan.watermark && (
        <p class="xs center" style="color: var(--muted-2); margin-top: -12px">
          Captures carry a small easyscreencapture.com mark. <a href="/pricing">{cleanPlan.name}</a> removes it from
          ${cleanPlan.priceMonthly}/mo.
        </p>
      )
    }
    </div>
  </form>
</AppShell>

<script>
  import { wireCaptureForm } from '../../scripts/capture';

  wireCaptureForm();

  document.getElementById('resend-verification')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const state = document.getElementById('resend-state');
    button.disabled = true;
    try {
      const response = await fetch('/api/auth/resend-verification', {
        method: 'POST',
        headers: { accept: 'application/json' },
      });
      const payload = (await response.json().catch(() => null)) as
        | { sent?: boolean; error?: { message?: string } }
        | null;
      if (state) {
        state.textContent = response.ok
          ? payload?.sent
            ? ' Sent — check your inbox.'
            : ' Nothing to send.'
          : ` ${payload?.error?.message ?? 'Could not send it.'}`;
      }
    } finally {
      button.disabled = false;
    }
  });
</script>
