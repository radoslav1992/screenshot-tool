---
import { COMPANY, COMPANY_ADDRESS_LINE } from '../lib/company';

const rows = [
  { label: 'Company', value: `${COMPANY.name} · ${COMPANY.nameLocal}` },
  { label: 'Legal form', value: COMPANY.form },
  { label: 'UIC', value: COMPANY.uic, mono: true },
  ...(COMPANY.vat ? [{ label: 'VAT number', value: COMPANY.vat, mono: true }] : []),
  { label: 'Registered office', value: COMPANY_ADDRESS_LINE },
  { label: 'Manager', value: COMPANY.director },
];
---

<div class="deflist">
  {
    rows.map((row) => (
      <div class="deflist__row">
        <span class="deflist__label">{row.label}</span>
        <span class:list={['deflist__value', row.mono && 'mono']}>{row.value}</span>
      </div>
    ))
  }
  <div class="deflist__row">
    <span class="deflist__label">Contact</span>
    <span class="deflist__value"><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></span>
  </div>
</div>
<p class="ai-note">Registered in the {COMPANY.register}.</p>
