---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import { COMPANY } from '../lib/company';
import { resetAvailable } from '../lib/password-reset';
import { takeFlash } from '../lib/flash';

// The iOS app's "Forgot password?" opens this page in the browser, so it has to
// stand on its own: no session, no JavaScript required.
const available = resetAvailable();
const sent = Astro.url.searchParams.get('sent') === '1';
// Left by the API when the form post failed; never read from the URL.
const error = takeFlash(Astro.cookies, Astro.url.pathname);
Astro.response.headers.set('cache-control', 'no-store');
---

<Base title="Reset your password" description="Get a link to choose a new Easy Screen Capture password.">
  <AiPage user={Astro.locals.user}>
    <AiPageHead
      label="ACCOUNT / PASSWORD"
      meta={sent ? 'LINK SENT' : 'RESET'}
      aside={sent ? 'Check your inbox' : 'Password reset'}
    >
      {
        error && (
          <div slot="notice" class="ai-strip ai-strip--error" role="alert">
            {error}
          </div>
        )
      }
      <Fragment slot="title">
        {
          sent ? (
            <>
              Check your <span>inbox</span>
            </>
          ) : (
            <>
              Forgot your <span>password?</span>
            </>
          )
        }
      </Fragment>

      {
        sent ? (
          <>
            <p>
              If an account uses that address, a reset link is on its way. It works once and expires in an hour.
              Nothing there after a few minutes? Check your spam folder, or ask for another link.
            </p>
            <div class="ai-actions">
              <a class="rr-btn-classic" href="/login">
                Back to log in <span aria-hidden="true">↗</span>
              </a>
              <a class="rr-btn-classic ai-btn-outline" href="/forgot-password">
                Send another link <span aria-hidden="true">↗</span>
              </a>
            </div>
          </>
        ) : available ? (
          <>
            <p>
              Enter the email address you signed up with and we will send you a link to choose a new password. The
              same account works on the web and in the iOS app.
            </p>
            <form class="reset-form" method="post" action="/api/auth/forgot-password">
              <label class="reset-form__label" for="email">Email</label>
              <input
                class="input"
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                inputmode="email"
                maxlength="254"
                placeholder="you@studio.co"
              />
              <button type="submit" class="rr-btn-classic">
                Email me a reset link <span aria-hidden="true">↗</span>
              </button>
            </form>
            <p class="reset-form__aside">
              Remembered it? <a href="/login">Log in</a>
            </p>
          </>
        ) : (
          <>
            <p>
              Reset emails are not available right now. Email{' '}
              <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a> from the address on your account and we will
              help you get back in. Never send us your password.
            </p>
            <div class="ai-actions">
              <a class="rr-btn-classic" href={`mailto:${COMPANY.email}?subject=${encodeURIComponent('Password reset')}`}>
                Email support <span aria-hidden="true">↗</span>
              </a>
            </div>
          </>
        )
      }
    </AiPageHead>
  </AiPage>
</Base>

<style>
  .reset-form {
    display: grid;
    gap: 12px;
    max-width: 440px;
  }
  .reset-form__label {
    font: 10px/1.5 var(--mono);
    text-transform: uppercase;
  }
  .reset-form .rr-btn-classic {
    margin-top: 6px;
  }
  .reset-form__aside {
    font-size: 14px;
  }
  .reset-form__aside a,
  p a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
