---
import AppShell from '../../layouts/AppShell.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { env } from 'cloudflare:workers';
import { getPlan } from '../../lib/plans';
import { formatDate } from '../../lib/dates';
import '../../styles/projects.css';

const user = Astro.locals.user!;
const plan = getPlan(user.plan);

const { results: keys } = await env.DB.prepare(
  `SELECT id, prefix, last4, label, environment, created_at, last_used_at, revoked_at
   FROM api_keys WHERE user_id = ? AND revoked_at IS NULL ORDER BY created_at DESC`,
)
  .bind(user.id)
  .all<{
    id: string;
    prefix: string;
    last4: string;
    label: string;
    environment: string;
    created_at: string;
    last_used_at: string | null;
  }>();

const origin = Astro.url.origin;
const curl = `curl ${origin}/v1/capture \\
  -H "Authorization: Bearer $KEY" \\
  -d url="https://stripe.com" \\
  -d device="mobile" \\
  -d mode="fullpage"`;

const responseSample = `{
  "id": "cap_8Yx2",
  "status": "done",
  "images": ["${origin}/f/cap_8Yx2/…"]
}`;

const params = [
  { name: 'url', desc: 'Page to capture' },
  { name: 'device', desc: 'desktop · tablet · mobile' },
  { name: 'mode', desc: 'visible · fullpage · series' },
  { name: 'format', desc: 'png · jpg · pdf' },
];

const keyMeta = (key: { label: string; environment: string; created_at: string; last_used_at: string | null }) =>
  `${key.label} · ${key.environment === 'test' ? 'test' : 'live'} · created ${formatDate(key.created_at)} · ${
    key.last_used_at ? `last used ${formatDate(key.last_used_at)}` : 'never used'
  }`;
---

<AppShell title="API" tab="api">
  <header class="appbar" slot="appbar">
    <div class="appbar__title">API</div>
    <span class="pill pill--quota">{plan.name} plan</span>
  </header>

  <div class="app-wrap stack gap-20">
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">DEVELOPER ACCESS</span>
        <h1>Capture from your own code.</h1>
        <p>Create a key, send a URL, get the screenshot back.</p>
      </div>
    </div>

    {
      !plan.api && (
        <div class="notice notice--info">
          API access is available on the Pro and Business plans. You can still create keys here once you upgrade.{' '}
          <a href="/pricing">See plans →</a>
        </div>
      )
    }

    <div class="app-split stack gap-20">
      <section class="project-panel stack gap-16" aria-labelledby="keys-heading">
        <h2 class="section-heading" id="keys-heading"><span>[ 01 ]</span> Your keys</h2>

        <form id="new-key-form" class="new-key-form" novalidate>
          <label>
            Key name
            <input class="input" id="key-label" name="label" maxlength="80" placeholder="Production" autocomplete="off" />
          </label>
          <label>
            Environment
            <select class="input" id="key-environment" name="environment">
              <option value="live" selected>Live</option>
              <option value="test">Test</option>
            </select>
          </label>
          <button type="submit" class="btn btn--lime" id="new-key">Create key</button>
        </form>

        <div class="notice notice--ok stack gap-10" id="new-key-box" role="region" aria-labelledby="new-key-title" hidden>
          <strong id="new-key-title">Copy this key now — it is not shown again.</strong>
          <code class="secret-value" id="new-key-value"></code>
          <div class="btn-row">
            <button type="button" class="btn btn--sm btn--outline-ink" data-copy id="new-key-copy">Copy key</button>
            <button type="button" class="btn btn--sm btn--outline" id="new-key-done">I’ve copied it</button>
          </div>
        </div>
        <div class="notice notice--error" id="key-error" role="alert" hidden></div>

        <div class="rows" id="key-list" hidden={!keys?.length}>
          {
            keys?.map((key) => (
              <div class="row key-row" data-key-row={key.id}>
                <div class="key-row__body">
                  <div class="mono truncate key-row__id">
                    {key.prefix}…{key.last4}
                  </div>
                  <div class="xs muted">{keyMeta(key)}</div>
                </div>
                <button type="button" class="btn btn--sm btn--danger-outline" data-revoke={key.id}>
                  Revoke
                </button>
              </div>
            ))
          }
        </div>
        <p class="small muted" id="no-keys" hidden={!!keys?.length}>
          No keys yet. Create one to start calling the API.
        </p>

        <p class="xs muted-2">
          Secrets are shown once, at creation. Only a hash is stored, so a lost key has to be revoked and replaced.
        </p>
      </section>

      <div class="app-col">
        <section class="project-panel stack gap-12" aria-labelledby="quickstart-heading">
          <h2 class="section-heading" id="quickstart-heading"><span>[ 02 ]</span> Quick start</h2>
          <CodeBlock tag="POST /v1/capture" code={curl} />
          <CodeBlock tag="RESPONSE · 200" code={responseSample} light copyable={false} />
        </section>

        <section class="project-panel" aria-labelledby="params-heading">
          <h2 class="section-heading" id="params-heading"><span>[ 03 ]</span> Parameters</h2>
          {
            params.map((param) => (
              <div class="param-row">
                <span class="param-row__name">{param.name}</span>
                <span class="param-row__desc">{param.desc}</span>
              </div>
            ))
          }
          <p class="link-row"><a href="/docs">Full API reference →</a></p>
        </section>
      </div>
    </div>
  </div>

  <template id="key-row-template">
    <div class="row key-row">
      <div class="key-row__body">
        <div class="mono truncate key-row__id"></div>
        <div class="xs muted"></div>
      </div>
      <button type="button" class="btn btn--sm btn--danger-outline">Revoke</button>
    </div>
  </template>
</AppShell>

<style>
  .new-key-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 150px) auto;
    gap: 12px;
    align-items: end;
  }
  .new-key-form .btn {
    width: auto;
  }
  .key-row {
    gap: 12px;
  }
  .key-row:hover {
    background: none;
  }
  .key-row__body {
    min-width: 0;
    display: grid;
    gap: 3px;
  }
  .key-row__id {
    font-size: 13px;
    font-weight: 500;
  }
  .key-row .btn {
    flex: none;
    min-height: 44px;
  }
  .key-row.is-new {
    background: var(--lime-tint);
  }
  @media (max-width: 600px) {
    .new-key-form {
      grid-template-columns: minmax(0, 1fr);
    }
    .new-key-form .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { formatDate } from '../../lib/dates';

  const form = document.getElementById('new-key-form') as HTMLFormElement | null;
  const list = document.getElementById('key-list') as HTMLElement | null;
  const empty = document.getElementById('no-keys') as HTMLElement | null;
  const errorBox = document.getElementById('key-error') as HTMLElement | null;
  const box = document.getElementById('new-key-box') as HTMLElement | null;
  const value = document.getElementById('new-key-value');
  const copyButton = document.getElementById('new-key-copy');
  const doneButton = document.getElementById('new-key-done') as HTMLButtonElement | null;
  const template = document.getElementById('key-row-template') as HTMLTemplateElement | null;

  type CreatedKey = {
    id: string;
    secret: string;
    prefix: string;
    last4: string;
    label: string;
    environment: string;
    created_at: string;
  };
  let pending: CreatedKey | null = null;
  let copied = false;

  function fail(message: string) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  function setFormDisabled(disabled: boolean) {
    form?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('input, select, button').forEach(
      (control) => (control.disabled = disabled),
    );
  }

  function addRow(key: CreatedKey) {
    if (!list || !template) return;
    const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    row.dataset.keyRow = key.id;
    row.classList.add('is-new');
    row.querySelector('.key-row__id')!.textContent = `${key.prefix}…${key.last4}`;
    row.querySelector('.key-row__body .xs')!.textContent =
      `${key.label} · ${key.environment === 'test' ? 'test' : 'live'} · created ${formatDate(key.created_at)} · never used`;
    row.querySelector<HTMLButtonElement>('button')!.dataset.revoke = key.id;
    list.prepend(row);
    list.hidden = false;
    if (empty) empty.hidden = true;
  }

  // The secret exists only on this page. Warn before it is lost uncopied.
  window.addEventListener('beforeunload', (event) => {
    if (pending && !copied) event.preventDefault();
  });

  copyButton?.addEventListener('click', () => {
    copied = true;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (pending) return;
    if (errorBox) errorBox.hidden = true;
    const data = new FormData(form);
    const label = String(data.get('label') ?? '').trim();
    const environment = data.get('environment') === 'test' ? 'test' : 'live';

    setFormDisabled(true);
    const response = await fetch('/api/keys', {
      method: 'POST',
      headers: { 'content-type': 'application/json', accept: 'application/json' },
      body: JSON.stringify({ label, environment }),
    }).catch(() => null);

    const payload = (await response?.json().catch(() => null)) as
      | (Partial<CreatedKey> & { error?: { message?: string } })
      | null;
    if (!response?.ok || !payload?.secret) {
      setFormDisabled(false);
      fail(payload?.error?.message ?? 'Could not create the key. Check your connection and try again.');
      return;
    }

    pending = payload as CreatedKey;
    copied = false;
    if (box && value && copyButton) {
      value.textContent = pending.secret;
      copyButton.setAttribute('data-copy-value', pending.secret);
      box.hidden = false;
      doneButton?.focus();
    }
  });

  doneButton?.addEventListener('click', () => {
    if (!pending) return;
    addRow(pending);
    pending = null;
    if (box && value && copyButton) {
      box.hidden = true;
      value.textContent = '';
      copyButton.removeAttribute('data-copy-value');
    }
    form?.reset();
    setFormDisabled(false);
    document.getElementById('key-label')?.focus();
  });

  list?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-revoke]');
    if (!button) return;
    if (!window.confirm('Revoke this key? Requests using it will stop working immediately.')) return;

    if (errorBox) errorBox.hidden = true;
    button.disabled = true;
    const response = await fetch(`/api/keys/${button.dataset.revoke}`, { method: 'DELETE' }).catch(() => null);
    if (response?.ok) {
      document.querySelector(`[data-key-row="${button.dataset.revoke}"]`)?.remove();
      if (list && !list.children.length) {
        list.hidden = true;
        if (empty) empty.hidden = false;
      }
    } else {
      button.disabled = false;
      fail('Could not revoke that key. Try again.');
    }
  });
</script>
