---
import AppShell from '../../../layouts/AppShell.astro';
import Icon from '../../../components/Icon.astro';
import { deviceLabel, displayUrl, modeLabel } from '../../../lib/capture-options';
import { formatBytes, formatRelative, getCapture, safeParseFiles } from '../../../lib/captures';
import { formatDateTime } from '../../../lib/dates';
import '../../../styles/projects.css';

const user = Astro.locals.user!;
const capture = await getCapture(Astro.params.id ?? '');

if (!capture || capture.user_id !== user.id) {
  return Astro.redirect('/app/library', 302);
}

const files = safeParseFiles(capture.files);
const origin = Astro.url.origin;
const fileHref = (name: string, download = false) =>
  `/f/${capture.id}/${name}?t=${capture.share_token}${download ? '&download=1' : ''}`;
const shareUrl = files[0] ? `${origin}${fileHref(files[0].name)}` : '';
---

<AppShell title={displayUrl(capture.url)} tab="library">
  <header class="appbar" slot="appbar">
    <a href="/app/library">← Library</a>
    <button type="button" class="btn btn--sm btn--danger-outline" data-delete-capture={capture.id}>Delete</button>
  </header>

  <div class="app-wrap stack gap-20">
    <div class="workspace-intro">
      <div>
        <span class="eyebrow">CAPTURE</span>
        <h1 class="capture-title">{displayUrl(capture.url)}</h1>
        <p>
          {deviceLabel(capture.device, capture.width, capture.height)} · {modeLabel(capture.mode)} ·
          {capture.format.toUpperCase()} ·{' '}
          <time data-relative datetime={capture.created_at} title={formatDateTime(capture.created_at)}>
            {formatRelative(capture.created_at)}
          </time>
        </p>
      </div>
      <a class="btn btn--lime" href={`/app?url=${encodeURIComponent(capture.url)}`}>Capture again</a>
    </div>

    <div class="notice notice--error" id="delete-error" role="alert" hidden></div>

    {
      capture.status === 'error' && (
        <div class="notice notice--error">{capture.error ?? 'This capture failed.'}</div>
      )
    }

    {
      (capture.status === 'pending' || capture.status === 'running') && (
        <div class="notice notice--info" id="pending-notice" role="status">
          <span class="spinner" /> Rendering — this page refreshes when it is ready.
        </div>
      )
    }

    {
      capture.status === 'queued' && (
        <div class="notice notice--info" id="pending-notice" role="status">
          <span class="spinner" /> Queued — it is captured in the background, usually within a few minutes. This page
          refreshes when it is ready.
        </div>
      )
    }

    <div class={files.length > 1 ? 'file-grid' : 'file-grid file-grid--single'}>
    {
      files.map((file) => (
        <figure class="card file-card">
          {capture.format === 'pdf' ? (
            <div class="p-20 center">
              <Icon name="file" size={34} class="mx-auto" />
              <p class="small muted file-card__name">{file.name} · {formatBytes(file.bytes)}</p>
            </div>
          ) : (
            <a href={fileHref(file.name)} target="_blank" rel="noopener" class="file-shot">
              <img src={fileHref(file.name)} alt={`Capture of ${displayUrl(capture.url)}`} />
            </a>
          )}
          <figcaption class="shot__meta">
            <div class="small muted truncate">
              {file.name} · {file.width}×{file.height} · {formatBytes(file.bytes)}
            </div>
            <a class="icon-btn" href={fileHref(file.name, true)} aria-label={`Download ${file.name}`} title="Download" download>
              <Icon name="download" size={16} />
            </a>
          </figcaption>
        </figure>
      ))
    }
    </div>

    {
      shareUrl && (
        <section class="project-panel stack gap-12" aria-labelledby="share-heading">
          <h2 class="section-heading" id="share-heading"><span>[ 01 ]</span> Share link</h2>
          <p class="small muted">Anyone with this link can view the capture. It carries a per-capture token.</p>
          <div class="secret-value share-url" id="share-url">{shareUrl}</div>
          <div class="btn-row">
            <button type="button" class="btn btn--outline-ink" data-copy data-copy-value={shareUrl}>Copy link</button>
          </div>
        </section>
      )
    }

    <section class="project-panel stack gap-12" aria-labelledby="next-heading">
      <h2 class="section-heading" id="next-heading"><span>[ 02 ]</span> What next</h2>
      <nav class="link-row" aria-label="More for this page">
        <a href={`/app/watches/setup?url=${encodeURIComponent(capture.url)}`}>Monitor this page for changes →</a>
        <a href={capture.url} target="_blank" rel="noopener noreferrer">Open original page ↗</a>
      </nav>
    </section>
  </div>
</AppShell>

<style>
  .capture-title {
    overflow-wrap: anywhere;
  }
  .file-card {
    overflow: hidden;
    margin: 0;
  }
  .file-card__name {
    margin-top: 8px;
  }
  .share-url {
    user-select: text;
    font-size: 12px;
  }
</style>

<script>
  const deleteButton = document.querySelector<HTMLButtonElement>('[data-delete-capture]');
  const deleteError = document.getElementById('delete-error');
  deleteButton?.addEventListener('click', async () => {
    if (!window.confirm('Delete this capture and its files? Share links stop working and this cannot be undone.'))
      return;
    deleteButton.disabled = true;
    if (deleteError) deleteError.hidden = true;
    const response = await fetch(`/api/captures/${deleteButton.dataset.deleteCapture}`, { method: 'DELETE' }).catch(
      () => null,
    );
    if (response?.ok) {
      window.location.assign('/app/library');
      return;
    }
    deleteButton.disabled = false;
    const body = (await response?.json().catch(() => null)) as { error?: { message?: string } } | null;
    if (deleteError) {
      deleteError.textContent =
        body?.error?.message ?? 'Could not delete this capture. Check your connection and try again.';
      deleteError.hidden = false;
      deleteError.scrollIntoView({ block: 'nearest' });
    }
  });

  // A capture created with async=true finishes in the background.
  if (document.getElementById('pending-notice')) {
    window.setTimeout(() => window.location.reload(), 4000);
  }
</script>
