---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { consumeVerificationToken } from '../lib/verification';

const token = Astro.url.searchParams.get('token') ?? '';
const userId = token ? await consumeVerificationToken(token) : null;
const ok = Boolean(userId);
const signedInAsSameUser = ok && Astro.locals.user?.id === userId;
---

<Base title={ok ? 'Email confirmed' : 'Link not valid'}>
  <div class="shell">
    <div style="padding: 24px">
      <Logo />
    </div>

    <div class="empty" style="margin: auto">
      <div class="empty__icon"><Icon name={ok ? 'check' : 'alert'} size={34} /></div>
      <h1 class="h3" style="margin-top: 12px">{ok ? 'Email confirmed' : 'That link did not work'}</h1>
      <p class="small muted" style="margin-top: 8px; max-width: 34ch; margin-inline: auto">
        {
          ok
            ? 'Your account is verified. You can start capturing right away.'
            : 'The link has expired or was already used. Request a new one from your account page.'
        }
      </p>

      <a class="btn btn--ink" href={signedInAsSameUser || ok ? '/app' : '/login'} style="max-width: 220px; margin: 20px auto 0">
        {ok ? 'Start capturing' : 'Log in'}
      </a>
    </div>
  </div>
</Base>
