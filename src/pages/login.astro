---
import Base from "../layouts/Base.astro";
import AdonAuthStory from "../components/AdonAuthStory.astro";
import Logo from "../components/Logo.astro";
import PasswordField from "../components/PasswordField.astro";
import { safeNext } from "../lib/safe-next";

// Sanitised here as well as by the API, so the form never carries a value that
// would send someone off-site even if it were posted somewhere else.
const next = safeNext(Astro.url.searchParams.get("next"), Astro.url.origin);
const initialError = Astro.url.searchParams.get("error") ?? "";
// Someone invited to a project usually has no account yet; keep where they
// were going when they switch to signing up.
const signupHref = next === "/app" ? "/signup" : `/signup?next=${encodeURIComponent(next)}`;
---

<Base title="Log in">
  <main class="adon-auth-layout">
    <AdonAuthStory />
    <div class="adon-auth-form">
      <div class="shell">
        <div style="padding: 24px 24px 32px; display: flex; flex-direction: column">
          <div style="padding: 8px 0 36px">
            <Logo />
          </div>

          <h1 class="h2">Welcome back</h1>
          <p class="small muted" style="margin-top: 8px">
            Log in to capture, browse your library and manage keys.
          </p>

          <form
            id="login-form"
            method="post"
            action="/api/auth/login"
            class="stack gap-12"
            style="margin-top: 28px"
            novalidate
          >
            <input type="hidden" name="next" value={next} />

            <div
              class="notice notice--error"
              id="form-error"
              role="alert"
              hidden={!initialError}
            >
              {initialError}
            </div>

            <div class="field">
              <label class="field__label" for="email">
                Email
              </label>
              <input
                class="input"
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@studio.co"
              />
            </div>

            <PasswordField
              id="password"
              name="password"
              label="Password"
              autocomplete="current-password"
              placeholder="••••••••••"
            />

            <p class="small" style="margin-top: -4px; text-align: right">
              <a href="/forgot-password" style="font-weight: 600">Forgot password?</a>
            </p>

            <button type="submit" class="btn btn--ink" style="margin-top: 8px">
              Log in
            </button>
          </form>

          <p class="small muted center" style="margin-top: 16px">
            New here?{" "}
            <a href={signupHref} style="font-weight: 600">
              Create an account
            </a>
          </p>
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  import { wireAuthForm, wirePasswordToggles } from "../scripts/auth";

  wireAuthForm("#login-form", "#form-error");
  wirePasswordToggles();
</script>
