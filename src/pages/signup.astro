---
import Base from "../layouts/Base.astro";
import AdonAuthStory from "../components/AdonAuthStory.astro";
import Logo from "../components/Logo.astro";
import PasswordField from "../components/PasswordField.astro";
import { PLANS } from "../lib/plans";
import { safeNext } from "../lib/safe-next";
import { takeFlash } from "../lib/flash";
import { ATTRIBUTION_COOKIE, carriedTouch, parseAttribution, referralCode, touchParam } from "../lib/attribution";
import { REFERRAL_BONUS, attributionCookieEnabled, growthAvailable } from "../lib/growth";
import { canSendEmail } from "../lib/mailer";

const next = safeNext(Astro.url.searchParams.get("next"), Astro.url.origin);
const url = Astro.url.searchParams.get("url") ?? "";
// Left by the API when a post without JavaScript failed; never read from the URL.
const initialError = takeFlash(Astro.cookies, Astro.url.pathname);
const target = url ? `/app?url=${encodeURIComponent(url)}` : next;
const loginHref = next === "/app" ? "/login" : `/login?next=${encodeURIComponent(next)}`;
// Where the visitor first came from (lib/attribution.ts): carried here in the
// link's `src`, or in the cookie where that is switched on. The form posts it.
const cookieTouch = attributionCookieEnabled() ? parseAttribution(Astro.cookies.get(ATTRIBUTION_COOKIE)?.value) : null;
const touch = cookieTouch ? null : carriedTouch(Astro.url, Astro.request.headers.get("referer"));
// Followed a referral link (/join): say what both sides get.
const invited = Boolean(referralCode(cookieTouch ?? touch)) && (await growthAvailable());
---

<Base title="Create your account">
  <main class="adon-auth-layout">
    <AdonAuthStory />
    <div class="adon-auth-form">
      <div class="shell">
        <div style="padding: 24px 24px 32px; display: flex; flex-direction: column">
          <div style="padding: 8px 0 36px">
            <Logo />
          </div>

          <h1 class="h2">Create your account</h1>
          <p class="small muted" style="margin-top: 8px">
            Free plan, no card needed. {PLANS.free.quota} screenshots a month on
            us.
          </p>
          {invited && (
            <p class="notice notice--info" style="margin-top: 16px" role="status">
              <strong>You were invited.</strong>{" "}
              {canSendEmail() ? "Confirm your email and take your first capture" : "Take your first capture"},
              and you and the friend who invited you each get {REFERRAL_BONUS}
              bonus screenshots. They never expire.
            </p>
          )}

          <form
            id="signup-form"
            method="post"
            action="/api/auth/signup"
            class="stack gap-12"
            style="margin-top: 28px"
            novalidate
          >
            <input type="hidden" name="next" value={target} />
            {touch && <input type="hidden" name="src" value={touchParam(touch)} />}

            <div
              class="notice notice--error"
              id="form-error"
              role="alert"
              hidden={!initialError}
            >
              {initialError}
            </div>

            <div class="field">
              <label class="field__label" for="name">
                Name
              </label>
              <input
                class="input"
                id="name"
                name="name"
                autocomplete="name"
                placeholder="Mia Torres"
              />
            </div>

            <div class="field">
              <label class="field__label" for="email">
                Email
              </label>
              <input
                class="input"
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@studio.co"
              />
            </div>

            <PasswordField
              id="password"
              name="password"
              label="Password"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              minlength={8}
            />

            <button type="submit" class="btn btn--ink" style="margin-top: 8px">
              Create account
            </button>
          </form>

          <p class="small muted center" style="margin-top: 16px">
            Already have an account?{" "}
            <a href={loginHref} style="font-weight: 600">
              Log in
            </a>
          </p>
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  import { wireAuthForm, wirePasswordToggles } from "../scripts/auth";

  wireAuthForm("#signup-form", "#form-error");
  wirePasswordToggles();
</script>
