---
import "../styles/global.css";
import "../styles/studio.css";
import "../styles/adon.css";
import "../styles/adon/ai-system.css";
import { BEACON_SRC, beaconToken } from "../lib/web-analytics";

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
  bodyClass?: string;
  /** Use the title as given, without " · Easy Screen Capture" (white-labelled review links). */
  plainTitle?: boolean;
  /** Absolute URL of the page's one address, for `rel=canonical` and `og:url`. */
  canonical?: string;
  /** Absolute URL of the picture a shared link shows. */
  ogImage?: string;
}

const {
  title,
  description = "Paste a URL, pick a device, and get pixel-perfect captures in seconds — in the app or through the API.",
  themeColor = "#F5F5F5",
  bodyClass = "",
  plainTitle = false,
  canonical,
  ogImage,
} = Astro.props;

const isWorkspace = Astro.url.pathname.startsWith("/app");
// Cloudflare Web Analytics, left off pages whose address carries a secret (lib/web-analytics.ts).
const analyticsToken = beaconToken(Astro.url);
const isAuth = ["/login", "/signup"].includes(Astro.url.pathname);
const fullTitle =
  plainTitle || title === "Easy Screen Capture" ? title : `${title} · Easy Screen Capture`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Easy Capture" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="mobile-web-app-capable" content="yes" />

    <link
      rel="preload"
      href="/vendor/adon/fonts/BDOGrotesk-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />

    <script is:inline>
      // Standalone (installed PWA) drops the desktop "phone frame" treatment.
      if (
        window.matchMedia("(display-mode: standalone)").matches ||
        window.navigator.standalone
      ) {
        document.documentElement.dataset.standalone = "true";
      }
    </script>
    {
      analyticsToken && (
        <script
          is:inline
          type="module"
          src={BEACON_SRC}
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body
    class:list={[
      bodyClass,
      "adon-theme",
      { "adon-workspace": isWorkspace, "adon-auth": isAuth },
    ]}
    data-demo="adon-ai-light"
  >
    <slot />
    {!isWorkspace && !isAuth && (
      <button
        class="adon-scroll-top"
        type="button"
        data-adon-top
        aria-label="Back to top"
        hidden
      >
        ↑
      </button>
    )}

    <script is:inline>
      if (document.documentElement.dataset.standalone === "true") {
        document.body.classList.add("is-standalone");
      }

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* offline support is a progressive enhancement */
          });
        });
      }

      // Remember the install prompt so the app can offer it (scripts/install.ts).
      window.__escInstallPrompt = null;
      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        window.__escInstallPrompt = event;
        document.dispatchEvent(new CustomEvent("esc:installable"));
      });
      // Installed from the browser's own menu, the kept prompt is spent too.
      window.addEventListener("appinstalled", () => {
        window.__escInstallPrompt = null;
      });
    </script>
    <script>
      import "../scripts/ui";
      import "../scripts/adon-motion";
    </script>
  </body>
</html>
