---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import AiDoc from '../components/AiDoc.astro';
import DocSection from '../components/DocSection.astro';
import { COMPANY } from '../lib/company';
import { docSections } from '../lib/doc-sections';
const user = Astro.locals.user;

const toc = [
  { id: 'contact', title: 'Contact support' },
  { id: 'sign-in', title: 'Signing in and verifying your email' },
  { id: 'find-capture', title: 'Finding a capture' },
  { id: 'alerts', title: 'Not receiving change alerts?' },
  { id: 'safari', title: 'Sharing a page from Safari' },
  { id: 'delete-account', title: 'Deleting your account and data' },
] as const;
const { list: sections, byId: s } = docSections(toc);
---

<Base title="Support — Easy Screen Capture">
  <AiPage user={user}>
    <AiPageHead label="SUPPORT" meta="EASY SCREEN CAPTURE / WEB AND IOS HELP" aside={COMPANY.email}>
      <Fragment slot="title">How can we <span>help?</span></Fragment>
      <p>Get help with your account, captures, monitor history or notifications.</p>
      <div class="ai-actions">
        <a class="rr-btn-classic" href={`mailto:${COMPANY.email}`}>
          Email support <span aria-hidden="true">↗</span>
        </a>
      </div>
    </AiPageHead>

    <AiDoc sections={sections}>
      <DocSection {...s.contact}>
        <p>
          Email <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>. Include the device and app or browser version,
          what you were trying to do, and any error message. Please do not send passwords, API keys or private
          screenshots.
        </p>
      </DocSection>

      <DocSection {...s['sign-in']}>
        <p>
          Use the same Easy Screen Capture email and password on the web and in the iOS app. Check your inbox and spam
          folder for the verification message. In the iOS account screen, choose Resend verification email if needed.
          Contact us if you cannot access your account.
        </p>
      </DocSection>

      <DocSection {...s['find-capture']}>
        <p>
          Regular captures are separate from monitor albums. Open the album for the relevant monitor to see its checks.
          Files are kept for your plan's retention period. Deleted or expired captures are no longer available.
        </p>
      </DocSection>

      <DocSection {...s.alerts}>
        <p>
          The first monitor check establishes a baseline. A later check must detect a change above the configured
          threshold before a change alert is sent. Confirm that the monitor is active and your account has capture
          allowance.
        </p>
        <p>
          For iOS push, open You → Push notifications → Enable change alerts and allow notifications. Check notification
          permissions and Focus settings on your device. Email alerts are a separate monitor preference; check your
          account email address and spam folder.
        </p>
      </DocSection>

      <DocSection {...s.safari}>
        <p>
          Open Safari's share sheet, choose Easy Capture and save the URL. Then open the Easy Capture app to review the
          capture settings and start the capture.
        </p>
      </DocSection>

      <DocSection {...s['delete-account']}>
        <p>
          In the iOS app, open You → Delete my account, enter your password and confirm. You can also delete your
          account from the website's account screen. This permanently deletes the account and its captures and cancels
          an active subscription. Use individual capture deletion if you only want to remove one image.
        </p>
        <p>
          If you cannot sign in, email support for help. Read the <a href="/privacy">privacy policy</a> for retention
          details and data requests.
        </p>
      </DocSection>
    </AiDoc>
  </AiPage>
</Base>
