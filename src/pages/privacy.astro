---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import AiDoc from '../components/AiDoc.astro';
import DocSection from '../components/DocSection.astro';
import Imprint from '../components/Imprint.astro';
import { docSections } from '../lib/doc-sections';
import { COMPANY } from '../lib/company';
import { PLANS } from '../lib/plans';
import { SESSION_COOKIE } from '../lib/auth';
import { ATTRIBUTION_COOKIE, ATTRIBUTION_DAYS } from '../lib/attribution';
import { REFERRAL_BONUS, attributionCookieEnabled } from '../lib/growth';
// Where a visitor came from travels in the links unless the cookie is switched on (lib/attribution.ts).
const attributionCookie = attributionCookieEnabled();

const user = Astro.locals.user;

/** Fixed on purpose — see the note in terms.astro. */
const updated = '8 October 2026';

const toc = [
  { id: 'responsible', title: 'Who is responsible' },
  { id: 'what-we-collect', title: 'What we collect' },
  { id: 'why-and-on-what-legal-basis', title: 'Why, and on what legal basis' },
  { id: 'pages-you-capture', title: 'Pages you capture' },
  { id: 'free-tools', title: 'The free tools' },
  { id: 'how-long-we-keep-it', title: 'How long we keep it' },
  { id: 'who-processes-it-for-us', title: 'Who processes it for us' },
  { id: 'the-ios-companion-app', title: 'The iOS companion app' },
  { id: 'alerts-in-your-browser', title: 'Alerts in your browser' },
  { id: 'cookies', title: 'Cookies' },
  { id: 'your-rights', title: 'Your rights' },
  { id: 'changes', title: 'Changes' },
] as const;
const { list: sections, byId: s } = docSections(toc);
---

<Base title="Privacy policy">
  <AiPage user={user}>
    <AiPageHead label="LEGAL / PRIVACY" meta={`LAST UPDATED ${updated.toUpperCase()}`} aside={`Controller · ${COMPANY.name}`}>
      <Fragment slot="title">Privacy <span>policy</span></Fragment>
      <p>What Easy Screen Capture collects, why, where it goes and how long it stays. Last updated {updated}.</p>
    </AiPageHead>
    <AiDoc sections={sections}>
      <DocSection {...s.responsible}>
        <Imprint />
        <p>
          {COMPANY.name} is the controller for the personal data described here. For anything about your data, write to{' '}
          <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>. We have not appointed a data protection officer; the
          scale of processing does not require one.
        </p>
      </DocSection>

      <DocSection {...s['what-we-collect']}>
        <ul>
          <li><b>Account:</b> your email address, display name, and a PBKDF2 hash of your password. We never store the password itself.</li>
          <li><b>Sessions:</b> a SHA-256 hash of the session cookie, its creation and expiry time, and the browser's user-agent string.</li>
          <li><b>API keys:</b> a SHA-256 hash of each key with its visible prefix and last four characters, a label, and when it was last used. The key itself is shown once and never stored.</li>
          <li><b>Captures:</b> the URL and host you captured, the device, viewport, mode and format, status, duration, byte size, and the rendered image or PDF files.</li>
          <li><b>Usage:</b> a monthly counter of captures made through the app and through the API, your balance of bonus screenshots and how many of each month's screenshots came from it, and short-lived per-minute rate-limit counters.</li>
          <li><b>Free tools:</b> the page address you enter, used only to answer that request, and a hashed form of your IP address used to count requests for rate limiting. See <a href="#free-tools">The free tools</a>.</li>
          <li><b>Signup source:</b> when you sign up, where you came from, if you came from somewhere: {attributionCookie ? `the first time in the previous ${ATTRIBUTION_DAYS} days,` : 'carried in the links you followed to the signup page, not in a cookie:'} the <span class="mono">ref</span>, <span class="mono">utm_source</span>, <span class="mono">utm_medium</span> and <span class="mono">utm_campaign</span> values of the link, the page you landed on (without its query string), the host name of the site that linked to us (never the full address) and when that was. A signup from the iOS app is recorded as coming from the app. We also keep a shortened one-way hash of the IP address you signed up from, used only to stop people rewarding themselves through their own referral link.</li>
          <li><b>Referrals:</b> your referral code; for each account created through your link, its status (pending, rewarded or not rewarded, and why) and the dates; and the {REFERRAL_BONUS} bonus screenshots each side receives. The person who invited you can see how many people signed up through their link and how many were rewarded, never who they are.</li>
          <li><b>Pro trial:</b> if you start a trial of Pro, when it started and when it ends, when we emailed you about it ending, and a shortened one-way hash of the IP address you started it from, used only to limit how many trials can be started from one network. We use it to give you Pro for the trial, to send those two emails and to refuse a second trial on the same account.</li>
          <li><b>Report sign-offs:</b> when someone approves or requests changes on a report shared with them, the name they type, their decision, an optional note and the time. The report's owner and everyone with the link can see them; no account or email address is collected.</li>
          <li><b>Report branding:</b> the logo, accent colour and footer line you set for a project.</li>
          <li><b>Site health:</b> for the sites behind your monitors, we check their availability, SSL certificates, domain registration (in the registry's public RDAP service) and the links on monitored pages, from Cloudflare's network, and store the results with your account: response times and outages, certificate and registration dates, and broken links with when they were found and fixed.</li>
          <li><b>Mobile notifications:</b> if enabled, your APNs device token, notification environment, account/session association, registration time, and delivery status for monitor alerts.</li>
          <li><b>Browser notifications:</b> if you turn on change alerts in a browser or the installed web app, the push subscription your browser gives us — the push service address it is reached at (the endpoint) and the public key and secret used to encrypt alerts to it — a shortened copy of the browser's user-agent string, which signed-in session it belongs to, when it was set up and last delivered, and the delivery status of each alert.</li>
          <li><b>Billing:</b> if you subscribe, your Stripe customer and subscription identifiers, plan, status, billing interval and paid-through date. For Apple purchases, we store a random account-linking token, transaction-chain identifier, product, environment and expiry to verify access, renewals and refunds. Payment details go directly to Stripe or Apple and never reach our servers.</li>
        </ul>
        <p>
          We do not run analytics, advertising or third-party trackers, and we do not build profiles or make automated
          decisions with legal effect. Cloudflare, which serves the site, keeps standard request logs including IP
          addresses for its own security purposes; we do not keep our own access logs.
        </p>
      </DocSection>

      <DocSection {...s['why-and-on-what-legal-basis']}>
        <div class="deflist">
          <div class="deflist__row">
            <span class="deflist__label">Run your account and take captures</span>
            <span class="deflist__value">Performance of the contract (Art. 6(1)(b) GDPR)</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Confirm your email address</span>
            <span class="deflist__value">Performance of the contract</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Take payment and issue invoices</span>
            <span class="deflist__value">Contract, and legal obligation (Art. 6(1)(c))</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Keep accounting and tax records</span>
            <span class="deflist__value">Legal obligation</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Enforce quotas, prevent abuse, keep the service secure</span>
            <span class="deflist__value">Legitimate interests (Art. 6(1)(f))</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Count where signups come from, run the referral programme and stop referral abuse</span>
            <span class="deflist__value">Legitimate interests</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Run a Pro trial you start and its two emails</span>
            <span class="deflist__value">Contract</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Limit trials to one per account and a few per network</span>
            <span class="deflist__value">Legitimate interests</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Service emails about your account</span>
            <span class="deflist__value">Contract</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Monitor change alerts you turned on, by email, webhook or push</span>
            <span class="deflist__value">Contract</span>
          </div>
        </div>
        <p>
          Providing your email and password is necessary to have an account — without them the service cannot be
          supplied.
        </p>
      </DocSection>

      <DocSection {...s['pages-you-capture']}>
        <p>
          A capture is a picture of someone else's page, so it may contain personal data of other people. For that
          content you are the controller and we act on your instructions as processor: we render it, store it and
          serve it back to you, and nothing else. Do not capture pages behind a login or containing special-category
          data unless you are entitled to.
        </p>
        <p>
          Every capture carries a share token embedded in its file links. Anyone who holds a link can open that
          capture's files without signing in, so treat links as you would the files themselves. Deleting a capture
          removes the stored files and invalidates its links.
        </p>
      </DocSection>

      <DocSection {...s['free-tools']}>
        <p>
          The tools under <a href="/tools">/tools</a> work without an account. To answer a request we process the page
          address you enter: we load that page, take the screenshot or read its tags, and send the result straight back
          to your browser. We do not store the images or the results, and we keep no log of who asked for which page.
        </p>
        <p>
          To stop the tools being abused we count how many requests come from each visitor. The count is keyed by a
          SHA-256 hash of your IP address (for IPv6, of its first half) combined with the date, so the key changes every
          day and does not contain your address. The counters expire by themselves within two days. The legal basis is
          our legitimate interest in keeping the service available (Art. 6(1)(f) GDPR).
        </p>
      </DocSection>

      <DocSection {...s['how-long-we-keep-it']}>
        <div class="deflist">
          <div class="deflist__row">
            <span class="deflist__label">Captures and their files</span>
            <span class="deflist__value">
              {PLANS.free.historyDays} days ({PLANS.free.name}) · {PLANS.plus.historyDays} days ({PLANS.plus.name} and
              {' '}{PLANS.pro.name}) · {PLANS.business.historyDays} days ({PLANS.business.name})
            </span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Sessions</span>
            <span class="deflist__value">Until expiry or sign-out</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Email confirmation tokens</span>
            <span class="deflist__value">Until used or expired</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Rate-limit counters</span>
            <span class="deflist__value">Minutes — they expire by themselves</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Free tools: results and images</span>
            <span class="deflist__value">Not stored — sent straight back to your browser</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Free tools: hashed-IP counters</span>
            <span class="deflist__value">Up to two days — they expire by themselves</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Browser push subscriptions</span>
            <span class="deflist__value">
              Until you turn alerts off, sign out of that browser, or its push service says the subscription has expired
            </span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Push delivery records</span>
            <span class="deflist__value">A day to deliver, then removed within seven days of expiring</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Site health results: outages, hourly uptime, fixed broken links</span>
            <span class="deflist__value">13 months, or until the monitor or account is deleted</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Report sign-offs and branding</span>
            <span class="deflist__value">While the report or project exists</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Account and usage records</span>
            <span class="deflist__value">While the account exists</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Signup source, referral records and bonus balance</span>
            <span class="deflist__value">While the account exists</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Pro trial record: its dates and the hashed IP address</span>
            <span class="deflist__value">While the account exists, so a trial is offered only once</span>
          </div>
          {
            attributionCookie && (
              <div class="deflist__row">
                <span class="deflist__label">The <span class="mono">{ATTRIBUTION_COOKIE}</span> cookie</span>
                <span class="deflist__value">{ATTRIBUTION_DAYS} days, or until you sign up</span>
              </div>
            )
          }
          <div class="deflist__row">
            <span class="deflist__label">Invoices and accounting records</span>
            <span class="deflist__value">As Bulgarian law requires, currently 10 years</span>
          </div>
        </div>
        <p>
          An hourly job deletes captures past their plan's retention window in bounded batches, files included. Current monitor baselines are retained for comparisons until replaced or their monitor is deleted. Deleting your account
          removes your captures, sessions, API keys, push subscriptions and site health results with it, and your signup source, referral code, bonus balance,
          Pro trial record and the referrals you sent; billing records that we are obliged to keep remain in Stripe and in our accounts. If
          you joined through someone's referral link, their record of that referral stays with their account, without
          anything that points to you.
        </p>
      </DocSection>

      <DocSection {...s['who-processes-it-for-us']}>
        <div class="deflist">
          <div class="deflist__row">
            <span class="deflist__label">Cloudflare, Inc.</span>
            <span class="deflist__value">Hosting, database, file storage, page rendering and service email delivery</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Stripe, Inc. / Stripe Payments Europe</span>
            <span class="deflist__value">Payments, subscriptions, invoices and tax</span>
          </div>
          <div class="deflist__row">
            <span class="deflist__label">Resend, Inc. (optional fallback)</span>
            <span class="deflist__value">Service email delivery when the optional fallback is configured</span>
          </div>
        </div>
        <p>
          Each is bound by a data processing agreement. They are US companies and processing may take place outside
          the EEA; those transfers rely on the EU Standard Contractual Clauses and, where the provider is certified,
          the EU–US Data Privacy Framework. We do not sell your data or share it for anyone else's marketing. We
          disclose data to authorities only where the law requires it.
        </p>
        <p>Apple processes iOS subscription purchases and provides transaction status used to verify your plan. Apple also delivers optional iOS alerts through Apple Push Notification service, using the device token and notification payload described below.</p>
        <p>
          If you turn on change alerts in a browser, your browser's vendor delivers them through its push service:
          Google for Chrome and most Chromium browsers, Mozilla for Firefox, Microsoft for Edge on Windows, and Apple
          for Safari and web apps on your Home Screen. Your browser chooses the service, not us. It receives the
          subscription endpoint and each alert, encrypted so that only your browser can read it, and processes them
          under its own privacy terms. See <a href="#alerts-in-your-browser">Alerts in your browser</a>.
        </p>
      </DocSection>

      <DocSection {...s['the-ios-companion-app']}>
        <p>
          The iOS app uses the same account, capture storage and monitoring service. Its authenticated session is
          stored in the device-only Keychain. Notification preferences and a website URL passed from the Safari
          share extension are stored locally. Saving a capture to Photos requires your permission and adds the
          selected image; the app does not read your existing photo library.
        </p>
        <p>
          Push notifications are optional. When you enable them, we associate Apple's device token with your
          signed-in account and session to deliver monitor change alerts through Apple Push Notification service.
          The alert contains a generic change message and monitor/check identifiers, without the monitored URL,
          page label or screenshot. Opening the monitor requires account authorization.
        </p>
        <p>
          Disable change alerts in the app or change permissions in iOS Settings. Disabling alerts in the app,
          signing out online, or deleting your account removes the associated server registration. Expired
          sessions and invalid tokens are also cleaned up. Delivery records expire after one day and are removed
          by scheduled cleanup once they have been expired for seven days. Alerts already handed to Apple may
          still be in transit. Email notification preferences are separate.
        </p>
      </DocSection>

      <DocSection {...s['alerts-in-your-browser']}>
        <p>
          Change alerts in a browser or in the installed web app are optional and off until you turn them on under
          Account → Change alerts on this device. Your browser asks for permission only when you do. It then gives us a
          push subscription: an address at your browser's push service and the keys to encrypt alerts to it. We keep
          it with your signed-in session, with a shortened copy of the browser's user-agent string so the
          subscription can be told apart, and record whether each alert was delivered.
        </p>
        <p>
          An alert says only that a monitored page changed, with the monitor's and check's identifiers so it can open
          the right one; it never contains the monitored URL, page label or screenshot. It is encrypted before it
          leaves our servers, so the push service passes it on without being able to read it. Opening the monitor
          requires you to be signed in.
        </p>
        <p>
          Turning alerts off, signing out of that browser or deleting your account removes the subscription. So does
          the push service telling us it has expired, and an expired session is cleaned up on the next delivery run.
          You can also block notifications for this site in your browser's settings. On iPhone and iPad, browser
          alerts need the app added to your Home Screen. Email notification preferences are separate.
        </p>
      </DocSection>

      <DocSection {...s['cookies']}>
        {
          attributionCookie ? (
            <>
              <p>
                <span class="mono">{SESSION_COOKIE}</span> keeps you signed in. It is strictly necessary, HttpOnly, Secure
                and SameSite=Lax, and it is removed when you sign out.
              </p>
              <p>
                <span class="mono">{ATTRIBUTION_COOKIE}</span> remembers where you first came from, so that it can be saved
                with your account if you sign up and a referral can be credited to the person who invited you. It is set
                only when you arrive through a link carrying a <span class="mono">ref</span> or{' '}
                <span class="mono">utm_</span> value, a referral link, or a link on another site, and only if there is not
                one already. It holds the values listed under What we collect and nothing that identifies you, it is
                first-party, HttpOnly, Secure and SameSite=Lax, it is read by nobody but us, and it expires after{' '}
                {ATTRIBUTION_DAYS} days or is removed when you sign up.
              </p>
              <p>
                There are no analytics, advertising or third-party cookies or trackers. The app also stores a small
                offline cache in your browser so it works without a connection, and, if you close the hint offering
                to install the app, a note that you did; you can clear them, and both cookies, from your browser
                settings.
              </p>
            </>
          ) : (
            <p>
              One cookie, <span class="mono">{SESSION_COOKIE}</span>, keeps you signed in. It is strictly necessary,
              HttpOnly, Secure and SameSite=Lax, and it is removed when you sign out. Where you came from is carried in
              the links you follow on this site, not in a cookie, and there are no analytics or advertising cookies,
              which is why the site does not ask for cookie consent. The app also stores a small offline cache in your
              browser so it works without a connection, and, if you close the hint offering to install the app, a note
              that you did; you can clear them from your browser settings.
            </p>
          )
        }
      </DocSection>

      <DocSection {...s['your-rights']}>
        <p>
          You can ask for access to your data, correction, erasure, restriction, portability, and you can object to
          processing based on legitimate interests. Most of it is in your hands already: edit your profile, delete any
          capture, revoke any API key, and delete the whole account — all from the account screen, with no need to ask
          us. For anything else, write to <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a> — we answer within 30
          days.
        </p>
        <p>
          If you think we have handled your data wrongly you may complain to the {COMPANY.dpa.name}, the Bulgarian
          supervisory authority (<a href={COMPANY.dpa.url} rel="noopener">{COMPANY.dpa.url.replace('https://', '')}</a>),
          or to the authority where you live.
        </p>
      </DocSection>

      <DocSection {...s['changes']}>
        <p>
          We will update this policy as the service changes and revise the date above. If a change materially affects
          you, we will tell you by email.
        </p>
      </DocSection>
    </AiDoc>
  </AiPage>
</Base>
