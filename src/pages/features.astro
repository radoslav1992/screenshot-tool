---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';
import WorkspaceFeatures from '../components/WorkspaceFeatures.astro';
import { TOOL_ORDER, TOOL_PAGES } from '../lib/tool-pages';
import '../styles/adon/tools.css';
const user = Astro.locals.user;
const tools = TOOL_ORDER.map((id) => TOOL_PAGES[id]);
---

<Base
  title="Website capture, monitoring and client reports"
  description="Capture pages in batches, monitor visual changes, and deliver branded client reports. Compare features, usage limits, sharing and retention."
>
  <AiPage user={user}>
    <AiPageHead
      label="FEATURES"
      meta="CAPTURE / CHECK / EXPLAIN"
      eyebrow="BUILT FOR CLIENT WEBSITE WORK"
      aside="From launch check to scheduled comparison"
    >
      <Fragment slot="title">
        Capture. Check.
        <br />
        <span>Explain the change.</span>
      </Fragment>
      <p>
        Keep client evidence in one project—from desktop and mobile launch checks, loaded as Safari on an iPhone and
        iPad, to the next scheduled comparison of the pixels or the SEO signals, and a monthly care report your client
        can read.
      </p>
      <div class="ai-actions">
        <a class="rr-btn-classic" href={user ? '/app/start' : '/signup?next=%2Fapp%2Fstart'}>
          Build your first workflow <span aria-hidden="true">↗</span>
        </a>
        <a class="rr-btn-classic ai-btn-outline" href="/client-sign-off">
          Client sign-off workflow <span aria-hidden="true">↗</span>
        </a>
      </div>
    </AiPageHead>
    <WorkspaceFeatures />
    <section aria-labelledby="free-tools-title">
      <div class="ai-section-head">
        <span class="section-subtitle-5">[ FREE TOOLS / NO SIGNUP ]</span>
        <div>
          <h2 id="free-tools-title" data-adon-title>Try it without an account</h2>
          <p class="ai-section-lede">
            Four free tools run on the same engine: take a full-page screenshot, preview a page on three devices,
            check its SEO tags, or compare staging with live.
          </p>
        </div>
      </div>
      <ul class="tool-links">
        {
          tools.map((tool, index) => (
            <li>
              <a href={tool.path}>
                <span class="tool-links__num">[ 0{index + 1} ]</span>
                <strong>{tool.name}</strong>
                <span>{tool.summary}</span>
                <i aria-hidden="true">↗</i>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </AiPage>
</Base>
