---
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  current: 'capture' | 'library' | 'api' | 'account';
}

const { current } = Astro.props;

const tabs = [
  { id: 'capture', href: '/app', icon: 'camera', label: 'Capture' },
  { id: 'library', href: '/app/library', icon: 'library', label: 'Library' },
  { id: 'api', href: '/app/api', icon: 'key', label: 'API' },
  { id: 'account', href: '/app/account', icon: 'user', label: 'Account' },
] as const;
---

<nav class="tabbar" aria-label="Primary">
  {/* Only shown once the tabs become a left rail, where there is a header to fill. */}
  <div class="tabbar__brand"><Logo href="/app" /></div>
  {
    tabs.map((tab) => (
      <a
        class="tabbar__item"
        href={tab.href}
        aria-current={current === tab.id ? 'page' : undefined}
      >
        <span class="tabbar__icon"><Icon name={tab.icon} size={22} /></span>
        <span class="tabbar__label">{tab.label}</span>
      </a>
    ))
  }
</nav>
