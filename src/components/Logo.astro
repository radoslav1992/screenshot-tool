---
import Mark from './Mark.astro';

interface Props {
  variant?: 'ink' | 'lime';
  href?: string;
  wordColor?: string;
}

const { variant = 'ink', href = '/', wordColor } = Astro.props;
const markClass = variant === 'lime' ? 'logo__mark logo__mark--lime' : 'logo__mark';
---

<a class="logo" href={href} style={wordColor ? `color: ${wordColor}` : undefined}>
  <span class={markClass}><Mark size={16} tone={variant === 'lime' ? 'lime' : 'ink'} /></span>
  <span class="logo__word">Easy Screen Capture</span>
</a>
