---
import MonitorThreshold from '../../../components/MonitorThreshold.astro';
import MonitorRuleFields from '../../../components/MonitorRuleFields.astro';
import { getMonitorRule, workflowsReady } from '../../../lib/monitor-rule-store';
import { canSendEmail } from '../../../lib/mailer';
import MonitorBudget from '../../../components/MonitorBudget.astro';
import { monitorDashboard } from '../../../lib/monitor-dashboard';
import { runLabel, deliveryLabel } from '../../../lib/monitor-health';
import { getUsage } from '../../../lib/captures';
import AppShell from '../../../layouts/AppShell.astro';
import Icon from '../../../components/Icon.astro';
import { fileUrl, safeParseFiles, type CaptureRow } from '../../../lib/captures';
import { deviceLabel, displayUrl, modeLabel } from '../../../lib/capture-options';
import { allowedFrequencies, FREQUENCIES, frequencyLabel } from '../../../lib/plans';
import { checkInProgress, getWatch, listRuns, listWatches } from '../../../lib/watches';
import { safeParseFacts } from '../../../lib/page-facts';
import { describeSeo } from '../../../lib/seo-signals';
import { diffText } from '../../../lib/text-diff';
import { formatDateTime } from '../../../lib/dates';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user!;
const watch = await getWatch(Astro.params.id ?? '');
if (!watch || watch.user_id !== user.id) return Astro.redirect('/app/watches', 302);

const [runs, schedules, usage, health] = await Promise.all([
  listRuns(watch.id, 25),
  listWatches(user.id),
  getUsage(user),
  monitorDashboard(user.id),
]);
const rule = await getMonitorRule(watch.id);
const rulesReady = await workflowsReady();
const frequencies = FREQUENCIES.filter((entry) => allowedFrequencies(user.plan).includes(entry.id));
const origin = Astro.url.origin;
const latestAlert = health.alerts.get(watch.id);
const name = watch.label || displayUrl(watch.url);
const active = watch.status === 'active';
const emailReady = canSendEmail();

/*
 * Why the last check did not produce a comparison, in the terms that matter:
 * a plan limit, a passing problem on our side, or the page itself failing.
 */
const TEMPORARY = 'Temporarily unavailable: ';
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const problem = !watch.last_error
  ? null
  : watch.last_error.startsWith('Paused:')
    ? { title: 'Monitor paused.', text: sentence(watch.last_error.slice('Paused:'.length).trim()), upgrade: true }
    : watch.last_error.startsWith(TEMPORARY)
      ? { title: 'The last check could not run.', text: `${watch.last_error.slice(TEMPORARY.length)} It will be retried automatically.`, upgrade: false }
      : { title: 'Last check failed.', text: `${watch.last_error}${active ? '' : ' The monitor has been paused.'}`, upgrade: false };

/** The images for the most recent comparison, when there is one to show. */
const lastComparison = runs.find(
  (run) => run.status === 'done' && run.capture_id && run.baseline_capture_id,
);

async function capture(id: string | null): Promise<CaptureRow | null> {
  if (!id) return null;
  return env.DB.prepare(`SELECT * FROM captures WHERE id = ?`).bind(id).first<CaptureRow>();
}

const [afterRow, beforeRow] = await Promise.all([
  capture(lastComparison?.capture_id ?? null),
  capture(lastComparison?.baseline_capture_id ?? null),
]);

function firstUrl(row: CaptureRow | null): string | null {
  if (!row) return null;
  const file = safeParseFiles(row.files)[0];
  return file ? fileUrl(row, file, origin) : null;
}

const beforeUrl = firstUrl(beforeRow);
const afterUrl = firstUrl(afterRow);
const changedPct = lastComparison?.change_pct ?? null;

/*
 * The same diff the alert email carries, recomputed from the two captures
 * rather than stored on the run: it costs nothing here, and storing it would
 * mean a second copy that can disagree with the text it came from.
 */
const change = diffText(
  safeParseFacts(beforeRow?.facts ?? null)?.text ?? '',
  safeParseFacts(afterRow?.facts ?? null)?.text ?? '',
);
const hasWords = change.comparable && (change.added.length > 0 || change.removed.length > 0);

/*
 * What an SEO rule compares the next check with: the baseline's signals, which
 * are the last ones recorded. A baseline from before the rule has none yet.
 */
const seoRow =
  rule.kind !== 'seo' || !watch.baseline_capture_id
    ? null
    : afterRow?.id === watch.baseline_capture_id
      ? afterRow
      : await capture(watch.baseline_capture_id);
const seo = safeParseFacts(seoRow?.facts ?? null)?.seo;
const seoSignals = seo ? describeSeo(seo, rule.selector) : [];
---

<AppShell title={name} tab="watches">
  <header class="appbar" slot="appbar">
    <a class="icon-btn" href="/app/watches" aria-label="Back to monitors">
      ‹
    </a>
    <div class="appbar__title truncate">{name}</div>
  </header>

  <div class="app-wrap app-split stack gap-16">
    <div class="workspace-intro monitor-intro">
      <div>
        <span class="eyebrow">WEBSITE MONITOR</span>
        <h1>{name}</h1>
        <p>
          {frequencyLabel(watch.frequency)} ·{' '}
          <a class="mono" href={watch.url} target="_blank" rel="noopener nofollow">{displayUrl(watch.url)}</a>
        </p>
      </div>
      <span class={`pill ${active ? 'pill--quota' : ''}`}>{active ? 'Monitoring' : 'Paused'}</span>
    </div>

    {problem && (
      <div class="notice notice--error">
        <strong>{problem.title}</strong> {problem.text}
        {problem.upgrade && <> <a href="/app/upgrade">Review your plan</a>.</>}
      </div>
    )}

    <div class="app-col">
      <section class="card card--pad stack gap-10">
        <p class="xs muted-2">
          {deviceLabel(watch.device, watch.width, watch.height)} · {modeLabel(watch.mode)} · {rule.kind === 'visual' ? (watch.threshold === 0 ? 'alerts for any detected visual change' : `visual alerts at ${watch.threshold}% or more`) : rule.kind === 'seo' ? 'SEO signals alert rule' : `${rule.kind} alert rule`}
          {watch.webhook_url && ' · webhook on'}
        </p>
        <div class="rows">
          <div class="row">
            <span class="row__label">Last attempted</span>
            <span class="row__value">{formatDateTime(watch.last_run_at, 'not yet')}</span>
          </div>
          <div class="row">
            <span class="row__label">Latest result</span>
            <span class="row__value">{runs[0] ? runLabel(runs[0]) : 'Awaiting first check'}</span>
          </div>
          <div class="row">
            <span class="row__label">Last successful check</span>
            <span class="row__value">{formatDateTime(health.successes.get(watch.id), 'not recorded')}</span>
          </div>
          <div class="row">
            <span class="row__label">Next check</span>
            <span class="row__value">
              {!active ? 'paused' : checkInProgress(watch) ? 'checking now' : formatDateTime(watch.next_run_at)}
            </span>
          </div>
          <div class="row">
            <span class="row__label">Last change</span>
            <span class="row__value">{formatDateTime(watch.last_changed_at, 'none seen yet')}</span>
          </div>
        </div>
      </section>

      {rule.kind === 'seo' && (
        <section class="card card--pad stack gap-8" aria-labelledby="seo-signals-heading">
          <h2 class="h4" id="seo-signals-heading">Last recorded SEO signals</h2>
          {seo && seoRow && (
            <p class="xs muted-2">
              Recorded <time datetime={seoRow.created_at}>{formatDateTime(seoRow.created_at)}</time>; the next check
              compares with these.
            </p>
          )}
          {seoSignals.length ? (
            <dl class="seo-signals">
              {seoSignals.map((signal) => (
                <>
                  <dt>{signal.label}</dt>
                  <dd>{signal.value}</dd>
                </>
              ))}
            </dl>
          ) : (
            <p class="small muted">The next check records them; each check after that compares with the last.</p>
          )}
        </section>
      )}

      {latestAlert && (
        <section class="card card--pad stack gap-8">
          <h2 class="h4">Most recent alert</h2>
          <p class="small">
            Email: {deliveryLabel[latestAlert.delivery.email]}
            <br />
            Webhook: {deliveryLabel[latestAlert.delivery.webhook]}
          </p>
          <p class="xs muted">
            Change detected {formatDateTime(latestAlert.created_at)}. Provider acceptance does not confirm inbox
            delivery.
          </p>
        </section>
      )}

      <form id="detection-form" class="card card--pad stack gap-12" data-watch={watch.id} data-rules={String(rulesReady)}>
        <h2 class="h4">What triggers an alert</h2>
        {rulesReady && <MonitorRuleFields rule={rule} />}
        <MonitorThreshold value={watch.threshold} />
        <button class="btn btn--ink" type="submit">Save alert rule</button>
        <p role="status" aria-live="polite"></p>
      </form>

      <form id="alerts-form" class="card card--pad stack gap-12" data-watch={watch.id}>
        <h2 class="h4">Where alerts go</h2>
        <label>
          Email alerts
          <select class="input" name="notify_email">
            <option value="1" selected={watch.notify_email === 1}>Send to {user.email}</option>
            <option value="0" selected={watch.notify_email !== 1}>Email off</option>
          </select>
        </label>
        {watch.notify_email === 1 && !emailReady && (
          <p class="notice">Email alerts are unavailable until email sending is configured. Use a webhook meanwhile.</p>
        )}
        <label>
          Webhook URL (optional)
          <input
            class="input"
            type="url"
            name="webhook_url"
            value={watch.webhook_url ?? ''}
            maxlength="2000"
            placeholder="https://hooks.slack.com/…"
          />
        </label>
        <p class="xs muted">
          Slack, Discord, Microsoft Teams and Google Chat webhooks get a formatted message; any other HTTPS address
          gets JSON. Leave it empty to stop webhook alerts. A test uses the saved settings.
        </p>
        <div class="alert-actions">
          <button class="btn btn--ink" type="submit">Save alert channels</button>
          <button type="button" class="btn btn--outline" id="test-notification" data-watch={watch.id}>
            Send test notification
          </button>
        </div>
        <p role="status" aria-live="polite" id="alerts-status"></p>
      </form>

      {beforeUrl && afterUrl && (
      <section class="stack gap-8">
          <div class="row-between">
            <h2 class="h4">Latest comparison</h2>
            {changedPct !== null && <span class="pill">{changedPct}% different</span>}
          </div>
            {
              hasWords && (
                <div class="card card--pad stack gap-10">
                  {change.added.length > 0 && (
                    <div class="stack gap-6">
                      <div class="xs muted-2">Now on the page</div>
                      {change.added.slice(0, 5).map((line) => (
                        <p class="diff-line diff-line--add">{line}</p>
                      ))}
                    </div>
                  )}
                  {change.removed.length > 0 && (
                    <div class="stack gap-6">
                      <div class="xs muted-2">Gone since last check</div>
                      {change.removed.slice(0, 5).map((line) => (
                        <p class="diff-line diff-line--remove">{line}</p>
                      ))}
                    </div>
                  )}
                  {change.added.length + change.removed.length > 10 && (
                    <p class="xs muted-2">
                      …and {change.added.length + change.removed.length - 10} more lines.
                    </p>
                  )}
                </div>
              )
            }

          <div class="compare">
            <figure class="compare__side">
              <figcaption class="xs muted-2">Before</figcaption>
              <img src={beforeUrl} alt="The page before the change" loading="lazy" />
            </figure>
            <figure class="compare__side">
              <figcaption class="xs muted-2">After</figcaption>
              <img src={afterUrl} alt="The page after the change" loading="lazy" />
            </figure>
          </div>
        </section>
      )}
    </div>

    <div class="app-col">
      {usage.remaining === 0 && (
        <div class="notice notice--info" role="status">
          Your screenshot allowance is exhausted. Checks are skipped until quota is available.
        </div>
      )}
      <div class="rows">
        <button type="button" class="row" data-action="run" style="width: 100%">
          <span class="row__label">Check now</span>
          <span class="row__value" style="color: var(--muted-2)">
            Uses one screenshot ›
          </span>
        </button>
        <button
          type="button"
          class="row"
          data-action={active ? 'pause' : 'resume'}
          style="width: 100%"
        >
          <span class="row__label">{active ? 'Pause' : 'Resume'}</span>
          <span class="row__value" style="color: var(--muted-2)">
            ›
          </span>
        </button>
        <button type="button" class="row" data-action="delete" style="width: 100%">
          <span class="row__label" style="color: var(--danger)">
            Delete monitor
          </span>
          <span class="row__value" style="color: var(--muted-2)">
            ›
          </span>
        </button>
      </div>
      <div class="notice notice--error" id="watch-error" hidden></div>

      <form id="schedule-form" class="card card--pad stack gap-12" data-watch-id={watch.id}>
        <h2 class="h4">Check schedule</h2>
        <label class="field__label" for="schedule-frequency">
          Check frequency
        </label>
        <select class="input" name="frequency" id="schedule-frequency">
          {frequencies.map((entry) => (
            <option value={entry.id} selected={entry.id === watch.frequency}>
              {entry.label}
            </option>
          ))}
        </select>
        <MonitorBudget
          schedules={schedules}
          budget={usage}
          allowed={frequencies.map((entry) => entry.id)}
          candidateId={watch.id}
          frequency={watch.frequency}
        />
        <p class="xs muted">
          {!active
            ? 'The forecast shows the cost if resumed. Saving keeps this monitor paused.'
            : 'Saving queues a check on the next scheduler run, then repeats at your chosen interval.'}
        </p>
        <button type="submit" class="btn btn--ink" disabled={frequencies.length === 0}>
          Save schedule
        </button>
        <p class="notice notice--error" id="schedule-error" role="alert" hidden></p>
      </form>

      <section class="stack gap-8">
        <h2 class="h4">History &amp; alert status</h2>
        <a class="btn btn--outline" href={`/app/library?collection=monitors&watch=${encodeURIComponent(watch.id)}`}>View this monitor’s screenshots →</a>
        <p class="xs muted">
          Accepted means the provider accepted the request, not confirmed inbox delivery. Older runs show “Not
          confirmed.” Explicit failures get up to two automatic retries on later hourly runs. Unconfirmed sends are not retried to avoid duplicates.
        </p>
        {runs.length === 0 ? (
          <div class="empty">
            <div class="empty__icon">
              <Icon name="eye" size={30} />
            </div>
            <p class="small muted" style="margin-top: 8px">
              {!active
                ? 'This monitor is paused. Resume it to run scheduled checks.'
                : `The first scheduled check is due ${formatDateTime(watch.next_run_at)}. You can also check now.`}
            </p>
          </div>
        ) : (
          <div class="rows">
            {runs.map((run) => (
              <div class="row">
                <span style="min-width: 0">
                  <span class="row__label" style="display: block">
                    {runLabel(run)}
                  </span>
                  <time class="xs muted-2" datetime={run.created_at}>{formatDateTime(run.created_at)}</time>
                  {run.changed === 1 && (
                    <span class="xs muted" style="display:block">
                      Email: {deliveryLabel[run.delivery.email]}
                      <br />
                      Webhook: {deliveryLabel[run.delivery.webhook]}
                    </span>
                  )}
                </span>
                <span class="row__note" style="max-width: 55%">
                  {run.change_pct !== null && run.status === 'done'
                    ? (run.detail || `${run.change_pct}% different · ${run.changed ? 'Alert rule met' : 'No alert triggered'}`)
                    : (run.detail ?? '')}
                </span>
              </div>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</AppShell>

<style>
  /* The intro speaks for the whole page, so it spans both columns of the split. */
  .monitor-intro {
    grid-column: 1 / -1;
  }
  .monitor-intro h1 {
    overflow-wrap: anywhere;
  }
  .alert-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .alert-actions .btn {
    width: auto;
  }
  .seo-signals {
    display: grid;
    grid-template-columns: minmax(90px, 32%) minmax(0, 1fr);
    gap: 8px 12px;
    margin: 0;
    font-size: 13px;
  }
  .seo-signals dt {
    font: 500 11px var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-2);
    padding-top: 2px;
  }
  .seo-signals dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>

<script>
  const statusOf = (form: HTMLFormElement) => form.querySelector<HTMLElement>('[role="status"]')!;
  const send = async (url: string, body: FormData | Record<string, string>) => {
    const response = await fetch(url, {
      method: 'POST',
      ...(body instanceof FormData
        ? { body }
        : { headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }),
    });
    const result = (await response.json().catch(() => ({}))) as { message?: string; error?: { message?: string } };
    if (!response.ok) throw new Error(result.error?.message || 'That did not save. Try again.');
    return result;
  };

  // One save for the rule and its sensitivity: they answer the same question.
  document.querySelector<HTMLFormElement>('#detection-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const state = statusOf(form);
    if (button.disabled || !form.reportValidity()) return;
    button.disabled = true;
    state.textContent = 'Saving…';
    try {
      const body = new FormData(form);
      body.set('action', 'threshold');
      await send(`/api/watches/${form.dataset.watch}`, body);
      if (form.dataset.rules === 'true') await send(`/api/watches/${form.dataset.watch}/rules`, new FormData(form));
      window.location.reload();
    } catch (error) {
      state.textContent = error instanceof Error ? error.message : 'That did not save. Try again.';
      button.disabled = false;
    }
  });

  document.querySelector<HTMLFormElement>('#alerts-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const state = statusOf(form);
    if (button.disabled || !form.reportValidity()) return;
    button.disabled = true;
    state.textContent = 'Saving…';
    try {
      const data = new FormData(form);
      await send(`/api/watches/${form.dataset.watch}`, {
        action: 'alerts',
        notify_email: String(data.get('notify_email') ?? '1'),
        webhook_url: String(data.get('webhook_url') ?? ''),
      });
      state.textContent = 'Alert channels saved.';
    } catch (error) {
      state.textContent = error instanceof Error ? error.message : 'That did not save. Try again.';
    } finally {
      button.disabled = false;
    }
  });

  document.querySelector<HTMLButtonElement>('#test-notification')?.addEventListener('click', async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    button.disabled = true;
    const status = document.querySelector('#alerts-status')!;
    status.textContent = 'Sending test…';
    try {
      const response = await fetch(`/api/watches/${button.dataset.watch}/test`, { method: 'POST' });
      const body = (await response.json()) as { message?: string; error?: { message?: string } };
      status.textContent = body.message ?? body.error?.message ?? 'Test failed.';
    } catch {
      status.textContent = 'Delivery could not be confirmed. Check the destination before retrying.';
    } finally {
      button.disabled = false;
    }
  });
</script>

<script is:inline define:vars={{ watchId: watch.id }}>
  const errorBox = document.getElementById('watch-error');

  const fail = (message) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  document.querySelectorAll('[data-action]').forEach((button) => {
    button.addEventListener('click', async () => {
      const action = button.getAttribute('data-action');
      if (errorBox) errorBox.hidden = true;

      if (action === 'delete' && !window.confirm('Delete this monitor and its history?')) return;

      const label = button.querySelector('.row__label');
      const original = label?.textContent;
      if (label) label.textContent = action === 'run' ? 'Checking…' : 'Working…';
      button.disabled = true;

      const response = await fetch(`/api/watches/${watchId}`, {
        method: action === 'delete' ? 'DELETE' : 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        ...(action === 'delete' ? {} : { body: JSON.stringify({ action }) }),
      }).catch(() => null);

      if (response?.ok) {
        window.location.href = action === 'delete' ? '/app/watches' : window.location.pathname;
        return;
      }

      button.disabled = false;
      if (label && original) label.textContent = original;
      const body = await response?.json().catch(() => null);
      fail(body?.error?.message ?? 'That did not work. Try again.');
    });
  });
</script>

<script>
  const scheduleForm = document.querySelector<HTMLFormElement>('#schedule-form');
  scheduleForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = scheduleForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const error = document.getElementById('schedule-error')!;
    if (button.disabled) return;
    error.hidden = true;
    button.disabled = true;
    button.textContent = 'Saving…';
    try {
      const response = await fetch(`/api/watches/${scheduleForm.dataset.watchId}`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'schedule', frequency: new FormData(scheduleForm).get('frequency') }),
      });
      const payload = (await response.json()) as { error?: { message?: string } };
      if (!response.ok) throw new Error(payload?.error?.message || 'Could not save the schedule.');
      window.location.reload();
    } catch (cause) {
      error.hidden = false;
      error.textContent = cause instanceof Error ? cause.message : 'Check your connection and try again.';
    } finally {
      button.disabled = false;
      button.textContent = 'Save schedule';
    }
  });
</script>
