{
  "$schema": "node_modules/wrangler/config-schema.json",
  // `assets` is supplied by @astrojs/cloudflare at build time — do not set it
  // here. `main` points at our own entrypoint, which re-exports the adapter's
  // fetch handler and adds the `scheduled` handler the cron trigger needs.
  "name": "screenify",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],

  // Hourly monitor checks and bounded retention cleanup; every minute, the
  // background capture queue (src/lib/capture-jobs.ts). At hh:00 both fire, as
  // separate invocations — src/worker.ts tells them apart by `event.cron`.
  "triggers": {
    "crons": ["0 * * * *", "* * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // D1 — users, sessions, API keys, captures, usage counters.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "screenify-data",
      "database_id": "3277d03c-58ac-4627-9af3-0d772a5d680c",
      "migrations_dir": "migrations"
    }
  ],

  // R2 — rendered screenshot files.
  "r2_buckets": [
    {
      "binding": "SHOTS",
      "bucket_name": "screenify-screenshots"
    }
  ],

  // KV — API rate-limit counters and small ephemeral state.
  "kv_namespaces": [
    {
      "binding": "RATE",
      "id": "b066aa4a16914e28ac0a05ddd9722916"
    }
  ],

  // Browser Rendering — the actual screenshot engine (paid Workers plan).
  "browser": {
    "binding": "BROWSER"
  },

  // Workers AI — one sentence saying what changed, on a watch alert
  // (src/lib/summarise.ts). No resource to create: the account's Workers AI is
  // used as it is. An AI binding has no local implementation, so astro.config
  // keeps remote bindings off unless CLOUDFLARE_REMOTE_BINDINGS=1: builds, dev
  // servers and CI run without a Cloudflare login, and alerts made there fall
  // back to a plain list of added and removed lines.
  "ai": {
    "binding": "AI"
  },

  // Outbound email for the onboarded easyscreencapture.com domain.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@easyscreencapture.com"]
    }
  ],

  "vars": {
    "PUBLIC_SITE_URL": "https://easyscreencapture.com",
    // Comma-separated hostnames that may never be captured (SSRF hardening
    // beyond the built-in private-range blocklist). Optional.
    "CAPTURE_HOST_DENYLIST": "",
    // Milliseconds to keep an idle browser session alive so the next capture can
    // reuse it instead of paying for a launch. Idle sessions are billed, so this
    // only pays off above roughly one capture every few seconds — 0 closes the
    // session immediately. Max 600000.
    "BROWSER_KEEP_ALIVE_MS": "0",
    // Require a confirmed email before capturing. Only takes effect once a
    // mailer is configured, so it can never lock accounts out of a deployment
    // that cannot send mail — turn it on with the EMAIL binding below.
    "REQUIRE_EMAIL_VERIFICATION": "0",
    // Sender for confirmation emails: an address, or "Name <address>".
    "EMAIL_FROM": "Easy Screen Capture <noreply@easyscreencapture.com>"
  }

  // Secrets (set with `wrangler secret put <NAME>`, or as encrypted variables in
  // the dashboard — unlike plain vars, they survive a redeploy). All optional:
  //   CF_ACCOUNT_ID         - enables the REST Browser Rendering fallback
  //   CF_API_TOKEN          - token with "Browser Rendering: Edit" for that fallback
  //   RESEND_API_KEY        - enables sending confirmation emails via Resend
  //   FREE_TOOLS_DAILY_RENDERS - renders a day across every visitor of the free
  //                           tools under /tools (default 300; "0" turns the
  //                           browser tools off). A plain number, not a secret,
  //                           but set in the dashboard so a deploy keeps it.
  //   OWNER_EMAILS          - comma-separated account emails that may open the
  //                           growth dashboard at /app/growth, and that the hourly
  //                           self-check emails when background work breaks
  //                           (src/lib/ops-watchdog.ts); unset, nobody can open it
  //                           and problems are only logged.
  //
  // Web Push. Change alerts in browsers stay hidden until all three are set and
  // migration 0018 is applied. `npm run vapid:keys` makes a pair and prints the
  // commands; keep it once in use, since subscriptions are tied to the key.
  //   VAPID_PUBLIC_KEY      - base64url uncompressed P-256 public key
  //   VAPID_PRIVATE_KEY     - base64url private key, or a PKCS8 PEM
  //   VAPID_SUBJECT         - mailto: or https: contact for the push services
  //
  // Stripe. Billing is dormant until STRIPE_SECRET_KEY is set: the buy buttons
  // do not render and /api/billing/* answers 503.
  //   STRIPE_SECRET_KEY     - sk_live_… / sk_test_…
  //   STRIPE_AUTOMATIC_TAX  - "1" to let Stripe Tax add VAT/GST at checkout.
  //                           Activate Tax and set an origin address first, or
  //                           Stripe rejects the session.
  //   STRIPE_WEBHOOK_SECRET - whsec_…, from the webhook endpoint pointed at
  //                           https://<your-domain>/api/billing/webhook
  //   STRIPE_PRICE_PLUS_MONTHLY, STRIPE_PRICE_PLUS_YEARLY
  //   STRIPE_PRICE_PRO_MONTHLY, STRIPE_PRICE_PRO_YEARLY
  //   STRIPE_PRICE_BUSINESS_MONTHLY, STRIPE_PRICE_BUSINESS_YEARLY
  //                         - recurring price ids (price_…). A plan with no
  //                           price id configured is shown but not purchasable.
}
