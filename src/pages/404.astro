---
import Base from '../layouts/Base.astro';
import AiPage from '../components/AiPage.astro';
import AiPageHead from '../components/AiPageHead.astro';

export const prerender = true;
---

<Base title="Not found">
  <AiPage>
    <AiPageHead label="404" meta="PAGE NOT FOUND" aside="Error 404">
      <Fragment slot="title">Nothing <span>here</span></Fragment>
      <p>That page does not exist — or the link has expired.</p>
      <div class="ai-actions">
        <a class="rr-btn-classic" href="/">
          Back to Easy Screen Capture <span aria-hidden="true">↗</span>
        </a>
      </div>
    </AiPageHead>
  </AiPage>
</Base>
